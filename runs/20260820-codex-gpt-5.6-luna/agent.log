x;margin-top:17px}.choice,.size{font-family:inherit;border:1px solid var(--line);background:transparent;text-align:left;padding:13px;cursor:pointer;color:var(--ink)}.choice{width:50%;font-size:14px}.choice small{display:block;color:#888;font:10px 'DM Mono',monospace;margin-top:8px}.choice.active,.size.active{background:#111;color:#fff;border-color:#111}.choice.active small{color:#b7d6e6}.second{margin-top:40px}.sizes{display:flex;gap:8px;margin-top:17px}.size{text-align:center;font:13px 'DM Mono',monospace;flex:1;padding:12px}.purchase{border-top:1px solid var(--line);margin-top:auto;padding-top:24px}.purchase strong{font-size:25px;font-weight:500;display:block}.purchase span{font:10px 'DM Mono',monospace;color:#777}.buy{width:100%;border:0;background:#111;color:#fff;font:14px 'Space Grotesk',sans-serif;text-align:left;padding:17px 18px;margin-top:19px;cursor:pointer}.buy:disabled{opacity:.5}.buy span{float:right;color:#b9dbed;font-size:17px}.fine{font-size:9px;line-height:1.7;color:#85857f;margin-top:20px}.error{color:#a2463b;font:11px 'DM Mono',monospace;line-height:1.4}footer{border-top:1px solid var(--line);margin-top:75px;padding-top:16px;display:flex;justify-content:space-between;font-size:9px;color:#8b8b85}.success{justify-content:center;max-width:650px}.success h1{font-size:clamp(50px,8vw,90px);line-height:.92;letter-spacing:-5px;font-weight:500;margin:22px 0}.success p{font-size:16px;line-height:1.6;max-width:410px;color:#62635e}.success button{background:#111;color:#fff;border:0;padding:16px 20px;font:14px inherit;margin-top:25px;cursor:pointer}.success button span{color:var(--blue);margin-left:35px}@media(max-width:800px){.shell{padding:22px 20px}.intro{padding:46px 0 30px}.intro h1{letter-spacing:-3px}.meta{display:none}.product{grid-template-columns:1fr;gap:30px}.stage{min-height:370px}.controls{padding:0}.purchase{margin-top:45px}footer{margin-top:48px;gap:20px;flex-direction:column}}
