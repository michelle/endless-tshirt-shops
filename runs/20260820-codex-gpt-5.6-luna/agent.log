+@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap');
+:root{--ink:#171717;--blue:#b9dbed;--paper:#f5f5f1;--line:#d6d6d0}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:'Space Grotesk',sans-serif}.shell{max-width:1180px;margin:auto;padding:28px 38px;min-height:100vh;display:flex;flex-direction:column}header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:19px}.brand{font-weight:600;font-size:22px;letter-spacing:-1.2px}.brand span,h1 em{color:#6194b2;font-style:normal}.badge,.meta,.eyebrow,.section-label,.stage-note,footer,.fine{font-family:'DM Mono',monospace}.badge{font-size:11px;color:#74746e}.badge i{color:#6d9db8;font-style:normal}.intro{display:flex;justify-content:space-between;padding:69px 0 44px}.eyebrow,.section-label{font-size:10px;letter-spacing:1.6px;color:#70736e}.intro h1{font-size:clamp(46px,6vw,79px);line-height:.95;letter-spacing:-5px;margin:15px 0 25px;font-weight:500}.lede{max-width:390px;font-size:15px;line-height:1.6;color:#5d5e59}.meta{font-size:10px;line-height:2;color:#787872;text-align:right;padding-top:7px}.product{display:grid;grid-template-columns:1fr 380px;gap:90px;align-items:center}.stage{background:#e8e9e4;min-height:490px;display:flex;align-items:center;justify-content:center;position:relative}.shirt-wrap{width:min(430px,80%);position:relative}.shirt-wrap svg{display:block;width:100%;fill:#111}.shirt-print{position:absolute;top:30%;left:8%;width:84%;text-align:center;color:white;font-family:'DM Mono',monospace;font-size:clamp(11px,1.55vw,18px);letter-spacing:-.8px;white-space:nowrap}.shirt-price{position:absolute;left:16%;bottom:22%;font-family:'DM Mono',monospace;color:#fff;font-size:11px}.shirt-price b{background:#b9dbed;color:#111;padding:4px 6px;font-weight:500}.stage-note{position:absolute;left:20px;bottom:18px;color:#7e807b;font-size:10px}.stage-note span{color:#5688a5}.controls{align-self:stretch;padding:22px 0;display:flex;flex-direction:column}.choices{display:flex;gap:8px;margin-top:17px}.choice,.size{font-family:inherit;border:1px solid var(--line);background:transparent;text-align:left;padding:13px;cursor:pointer;color:var(--ink)}.choice{width:50%;font-size:14px}.choice small{display:block;color:#888;font:10px 'DM Mono',monospace;margin-top:8px}.choice.active,.size.active{background:#111;color:#fff;border-color:#111}.choice.active small{color:#b7d6e6}.second{margin-top:40px}.sizes{display:flex;gap:8px;margin-top:17px}.size{text-align:center;font:13px 'DM Mono',monospace;flex:1;padding:12px}.purchase{border-top:1px solid var(--line);margin-top:auto;padding-top:24px}.purchase strong{font-size:25px;font-weight:500;display:block}.purchase span{font:10px 'DM Mono',monospace;color:#777}.buy{width:100%;border:0;background:#111;color:#fff;font:14px 'Space Grotesk',sans-serif;text-align:left;padding:17px 18px;margin-top:19px;cursor:pointer}.buy:disabled{opacity:.5}.buy span{float:right;color:#b9dbed;font-size:17px}.fine{font-size:9px;line-height:1.7;color:#85857f;margin-top:20px}.error{color:#a2463b;font:11px 'DM Mono',monospace;line-height:1.4}footer{border-top:1px solid var(--line);margin-top:75px;padding-top:16px;display:flex;justify-content:space-between;font-size:9px;color:#8b8b85}.success{justify-content:center;max-width:650px}.success h1{font-size:clamp(50px,8vw,90px);line-height:.92;letter-spacing:-5px;font-weight:500;margin:22px 0}.success p{font-size:16px;line-height:1.6;max-width:410px;color:#62635e}.success button{background:#111;color:#fff;border:0;padding:16px 20px;font:14px inherit;margin-top:25px;cursor:pointer}.success button span{color:var(--blue);margin-left:35px}@media(max-width:800px){.shell{padding:22px 20px}.intro{padding:46px 0 30px}.intro h1{letter-spacing:-3px}.meta{display:none}.product{grid-template-columns:1fr;gap:30px}.stage{min-height:370px}.controls{padding:0}.purchase{margin-top:45px}footer{margin-top:48px;gap:20px;flex-direction:column}}
