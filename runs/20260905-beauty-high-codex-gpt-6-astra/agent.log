{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"cat > app/store.tsx <<'EOF'\n'use client';\nimport { useEffect, useRef, useState } from 'react';\nimport { ArrowUpRight, ArrowRight, ShoppingBag, Clock3, Sparkles, Pause, Play, Check, X, Ruler, Plus, Minus, Truck, LockKeyhole, Heart, RotateCcw, LoaderCircle, MoveUpRight } from 'lucide-react';\nimport { COLORS, SIZES, readableMoment, type Purchase } from '@/lib/catalog';\n\ntype Bag = Purchase;\nexport default function Store() {\n  const [now, setNow] = useState<number | null>(null);\n  const [frozen, setFrozen] = useState<number | null>(null);\n  const [color, setColor] = useState<Purchase['color']>('black');\n  const [size, setSize] = useState<Purchase['size']>('M');\n  const [fit, setFit] = useState<Purchase['fit']>('unisex');\n  const [view, setView] = useState<'front' | 'detail'>('front');\n  const [bag, setBag] = useState<Bag | null>(null);\n  const [modal, setModal] = useState<'bag' | 'size' | null>(null);\n  const [busy, setBusy] = useState(false);\n  const [error, setError] = useState('');\n  const [canceled, setCanceled] = useState(false);\n  const [openFaq, setOpenFaq] = useState<number | null>(0);\n  const dialog = useRef<HTMLDialogElement>(null);\n  const moment = frozen ?? now;\n  const selectedColor = COLORS.find(c => c.id === color)\"'!;\n  useEffect(() => {\n    setNow(Date.now());\n    const timer = setInterval(() => setNow(Date.now()), 73);\n    try {\n      const saved = localStorage.getItem('\"'datetime-bag');\n      if (saved) { const parsed = JSON.parse(saved); if (parsed.timestamp > Date.now() - 1_800_000 && parsed.requestId && SIZES.includes(parsed.size) && COLORS.some(c => c.id === parsed.color) && ['unisex','fitted'].includes(parsed.fit)) setBag(parsed); else localStorage.removeItem('datetime-bag'); }\n    } catch { /* Private browsing can disable storage. */ }\n    if (new URLSearchParams(location.search).get('checkout') === 'canceled') setCanceled(true);\n    return () => clearInterval(timer);\n  }, []);\n  useEffect(() => { if (modal && \"'!dialog.current?.open) dialog.current?.showModal(); else if (!modal) dialog.current?.close(); }, [modal]);\n  function capture() {\n    const timestamp = frozen ?? Date.now();\n    setFrozen(timestamp);\n    const next: Bag = { timestamp, color, size, fit, requestId: crypto.randomUUID() };\n    setBag(next); setError('\"''); setModal('bag');\n    try { localStorage.setItem('datetime-bag', JSON.stringify(next)); } catch {}\n  }\n  function removeBag() { setBag(null); setFrozen(null); setError(''); try { localStorage.removeItem('datetime-bag'); } catch {} }\n  async function checkout() {\n    if (\"'!bag || busy) return;\n    setBusy(true); setError('\"'');\n    try {\n      const response = await fetch('/api/checkout', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(bag) });\n      const data = await response.json();\n      if (\"'!response.ok) throw new Error(data.error || '\"'Checkout could not start. Please try again.');\n      window.location.assign(data.url);\n    } catch (e) { setError(e instanceof Error ? e.message : 'Something went wrong. Please try again.'); setBusy(false); }\n  }\n  function chooseFit(next: Purchase['fit']) { setFit(next); if (next === 'fitted' && color === 'natural') setColor('black'); }\n  return <>\n    <a className=\\\"skip-link\\\" href=\\\"#shop\\\">Skip to the tee</a>\n    <div className=\\\"announcement\\\"><Sparkles size={13} /><span>GOOD THINGS TAKE TIME. THIS ONE TAKES A MOMENT.</span><Sparkles size={13} /></div>\n    <header className=\\\"site-header wrap\\\">\n      <a href=\\\"/\\\" className=\\\"wordmark\\\" aria-label=\\\"datetime.store home\\\"><span className=\\\"brand-clock\\\"><Clock3 strokeWidth={1.6} /></span>datetime<span className=\\\"wordmark-dot\\\">.</span>store</a>\n      <nav aria-label=\\\"Main navigation\\\"><a href=\\\"#how-it-works\\\">How it works</a><a href=\\\"#little-details\\\">The little details</a><button className=\\\"bag-button\\\" onClick={() => setModal('bag')}><ShoppingBag size={17} /><span>Bag</span><span className=\\\"bag-count\\\">{bag ? 1 : 0}</span></button></nav>\n    </header>\n    <main>\n      <section className=\\\"shop wrap\\\" id=\\\"shop\\\">\n        <div className=\\\"hero-intro\\\"><div><p className=\\\"eyebrow\\\"><span className=\\\"tiny-star\\\">✳</span> THE ORIGINAL DATETIME T-SHIRT</p><h1>Time flies. <em>Wear it.</em><span className=\\\"heading-star\\\" aria-hidden=\\\"true\\\">✧</span></h1></div><p className=\\\"intro-note\\\">A fleeting moment.<br />A forever kind of tee.<span aria-hidden=\\\"true\\\">↙</span></p></div>\n        {canceled && <div className=\\\"notice\\\"><span>Your moment is still here. Pick up where you left off, or capture a new one.</span><button onClick={() => setCanceled(false)} aria-label=\\\"Dismiss checkout notice\\\"><X size={16} /></button></div>}\n        <div className=\\\"product-layout\\\">\n          <div className=\\\"product-gallery\\\">\n            <div className={\"'`product-stage ${view === '\"'detail' ? 'detail-stage' : ''}\"'`}>\n              <div className=\"stage-meta\"><span>NO. 001 / THE NOW TEE</span><span className=\"live-pill\"><i className={frozen ? '\"'paused' : ''} />{frozen ? 'MOMENT CAPTURED' : 'LIVE PREVIEW'}</span></div>\n              <div className=\\\"orbit orbit-one\\\" aria-hidden=\\\"true\\\" /><div className=\\\"orbit orbit-two\\\" aria-hidden=\\\"true\\\" />\n              {view === 'front' ? <div className={\"'`tee-preview tee-${color} fit-${fit}`}>\n                {/* Generated mockup; the exact printable content is always rendered from the captured timestamp. */}\n                <img className=\"tee-photo\" src=\"/images/tee-black.webp\" alt={`${selectedColor.name} ${fit} T-shirt with the current Unix timestamp printed across the chest`} width=\"1254\" height=\"1254\" fetchPriority=\"high\" />\n                <span className=\"tee-timestamp\" style={{ color: selectedColor.ink }} aria-hidden=\"true\">{moment ?? '\"'1788600000000'}</span>\n              </div> : <div className={\"'`print-detail ink-${color}`}><span className=\"detail-caption\">YOUR MOMENT, DOWN TO THE MILLISECOND</span><span className=\"detail-number\">{moment ?? '\"'1788600000000'}</span><span className=\\\"detail-caption\\\">ONE LINE. A WHOLE LITTLE STORY.</span></div>}\n              <span className=\\\"stage-spark spark-one\\\" aria-hidden=\\\"true\\\">✦</span><span className=\\\"stage-spark spark-two\\\" aria-hidden=\\\"true\\\">✧</span>\n              <div className=\\\"time-sticker\\\" aria-hidden=\\\"true\\\"><Clock3 size={28} strokeWidth={1.3} /><span>HERE<br />& NOW</span></div>\n              <div className=\\\"stage-bottom\\\"><span className=\\\"handwritten\\\">well, this is a moment.</span><button className=\\\"round-button\\\" onClick={() => setFrozen(frozen ? null : Date.now())} aria-label={frozen ? 'Resume live time' : 'Pause live time'} title={frozen ? 'Resume time' : 'Pause time'}>{frozen ? <Play size={16} /> : <Pause size={16} />}</button></div>\n            </div>\n            <div className=\\\"gallery-bottom\\\"><div className=\\\"view-tabs\\\" aria-label=\\\"Product view\\\"><button className={view === 'front' ? 'selected' : ''} onClick={() => setView('front')}>The tee</button><button className={view === 'detail' ? 'selected' : ''} onClick={() => setView('detail')}>The print <ArrowUpRight size={12} /></button></div><p>Made to order. Made for your moment.</p></div>\n          </div>\n          <div className=\\\"product-info\\\">\n            <p className=\\\"eyebrow muted\\\">NOT JUST ANOTHER GRAPHIC TEE.</p>\n            <div className=\\\"product-title\\\"><h2>The Now Tee</h2><span>\"'$32<span>.00</span></span></div>\n            <p className=\"product-description\">A little reminder that you were here.<br />The exact moment you click, captured in time<br className=\"desktop-br\" /> and printed on ridiculously soft cotton.</p>\n            <div className=\"moment-panel\"><div className=\"moment-label\"><span className=\"status-dot\" />{frozen ? '\"'YOUR CAPTURED MOMENT' : 'THIS MOMENT, RIGHT NOW'}<Clock3 size={13} /></div><div className=\\\"moment-number\\\" suppressHydrationWarning>{moment ?? '·············'}</div><div className=\\\"moment-date\\\" suppressHydrationWarning>{moment ? readableMoment(moment) : 'A new moment is on its way…'}</div></div>\n            <fieldset className=\\\"color-field\\\"><legend>Color <span>— {selectedColor.name}</span></legend><div className=\\\"swatches\\\">{COLORS.map(c => <button key={c.id} disabled={fit === 'fitted' && c.id === 'natural'} className={\"'`swatch ${color === c.id ? '\"'active' : ''}\"'`} style={{ '\"'--swatch': c.hex } as React.CSSProperties} aria-label={c.name} aria-pressed={color === c.id} onClick={() => setColor(c.id)}>{color === c.id && <Check size={16} color={c.ink} />}</button>)}<span className=\\\"color-note\\\">{fit === 'fitted' ? 'Two timeless shades.' : 'Three timeless shades.'}</span></div></fieldset>\n            <fieldset className=\\\"fit-field\\\"><legend>Fit</legend><div className=\\\"fit-options\\\"><button className={fit === 'unisex' ? 'active' : ''} onClick={() => chooseFit('unisex')} aria-pressed={fit === 'unisex'}>Unisex <span>Easy & everyday</span></button><button className={fit === 'fitted' ? 'active' : ''} onClick={() => chooseFit('fitted')} aria-pressed={fit === 'fitted'}>Fitted <span>A little more shape</span></button></div></fieldset>\n            <fieldset className=\\\"size-field\\\"><legend>Size</legend><button className=\\\"size-guide text-button\\\" onClick={() => setModal('size')}><Ruler size={14} /> Size guide</button><div className=\\\"size-options\\\">{SIZES.map(s => <button key={s} className={size === s ? 'active' : ''} onClick={() => setSize(s)} aria-pressed={size === s}>{s}</button>)}</div></fieldset>\n            <button className=\\\"capture-button\\\" onClick={capture} disabled={\"'!now}><span>Make this moment mine</span><ArrowUpRight size={23} /></button>\n            <p className=\"capture-note\"><LockKeyhole size={12} /> Your timestamp freezes when you click.</p>\n            <div className=\"product-promises\"><span><Truck size={16} />Free US shipping</span><span><Heart size={15} />Printed just for you</span></div>\n            {process.env.NEXT_PUBLIC_STORE_MODE !== '\"'live' && <p className=\\\"test-note\\\">You’re in our test shop. No real charges or shipments.</p>}\n          </div>\n        </div>\n      </section>\n      <div className=\\\"ticker\\\" aria-hidden=\\\"true\\\"><div><span>EVERY MILLISECOND IS A LIMITED EDITION</span><span>✳</span><span>BE HERE. WEAR NOW.</span><span>✳</span><span>TIME WELL WORN</span><span>✳</span><span>EVERY MILLISECOND IS A LIMITED EDITION</span><span>✳</span></div></div>\n      <section className=\\\"how-section wrap\\\" id=\\\"how-it-works\\\">\n        <div className=\\\"section-heading\\\"><p className=\\\"eyebrow\\\">A SMALL IDEA ABOUT A BIG THING</p><h2>You can’t stop time.<br />But you can <em>put it on a t-shirt.</em></h2><p>No big occasion required. An ordinary Tuesday counts, too.</p></div>\n        <div className=\\\"steps\\\"><article><div className=\\\"step-top\\\"><span>01 / FIND YOUR NOW</span><Clock3 size={30} strokeWidth={1.3} /></div><h3>Life moves. So does the tee.</h3><p>That number is the current Unix timestamp: every millisecond since January 1, 1970. It’s ticking along with you.</p></article><article><div className=\\\"step-top\\\"><span>02 / CATCH IT</span><Sparkles size={30} strokeWidth={1.3} /></div><h3>One click. One tiny time capsule.</h3><p>Choose your color, fit, and size. Click the button, and your moment stops changing. That exact number is yours.</p></article><article><div className=\\\"step-top\\\"><span>03 / WEAR THE MEMORY</span><ShoppingBag size={29} strokeWidth={1.3} /></div><h3>A moment you can live in.</h3><p>We print your timestamp on a soft tee, just for you. A conversation starter. A keepsake. Your new favorite.</p></article></div>\n      </section>\n      <section className=\\\"story-section wrap\\\"><div className=\\\"story-photo\\\"><img src=\\\"/images/tee-reference.jpg\\\" alt=\\\"Close-up of the soft cotton and easy crewneck fit of the Gildan 64000 tee\\\" width=\\\"1600\\\" height=\\\"1600\\\" loading=\\\"lazy\\\" /><span className=\\\"photo-label\\\">SOFT COTTON. HARD TO FORGET.</span></div><div className=\\\"story-copy\\\"><span className=\\\"story-flower\\\" aria-hidden=\\\"true\\\">✳</span><p className=\\\"eyebrow\\\">A SOUVENIR OF RIGHT NOW</p><h2>For the big days.<br />And the <em>just-because days.</em></h2><p>The first day of something. The last day of something else. Or a perfectly unremarkable afternoon you’d like to keep.</p><p>Not everything needs a meaning.<br />Sometimes, it just needs a really good t-shirt.</p><a href=\\\"#shop\\\" className=\\\"underlined-link\\\">Find your moment <ArrowUpRight size={19} /></a></div></section>\n      <section className=\\\"faq-section wrap\\\" id=\\\"little-details\\\"><div><p className=\\\"eyebrow\\\">THE LITTLE DETAILS</p><h2>Good questions.<br /><em>Timely answers.</em></h2><span className=\\\"faq-doodle\\\" aria-hidden=\\\"true\\\">✺</span></div><div className=\\\"faq-list\\\">{[\n        ['What does the number on my tee mean?', 'It’s Unix time in milliseconds: the number of milliseconds that have passed since January 1, 1970 at 00:00:00 UTC. Every number points to one exact instant, anywhere in the world. The readable date underneath the preview translates it for you.'],\n        ['When does my timestamp stop changing?', 'The instant you click “Make this moment mine.” You’ll see your frozen timestamp in the bag before continuing to Stripe. You can also pause the preview to catch a moment first. A captured moment stays available for 30 minutes before starting checkout.'],\n        ['What is the tee like?', 'The unisex tee is a Gildan 64000 Softstyle with an easy regular fit. The fitted tee is a Gildan 64000L with a shaped silhouette. Our solid colors are soft cotton. Choose a size using the garment measurements in the size guide; size up for more room. The preview is an illustrative mockup—fabric tone and print placement may vary slightly.'],\n        ['Where do you ship, and how long does it take?', 'We currently offer free standard shipping within the United States. Each tee is printed to order by Prodigi. Allow approximately 7–14 business days for printing and delivery; this is an estimate, not a guarantee. This test shop uses sandbox fulfillment, so test orders won’t be printed or shipped.'],\n        ['How do I care for my moment?', 'Turn your tee inside out and machine wash cold with similar colors. Use a gentle cycle, skip bleach, and line dry or tumble dry low. Avoid ironing directly over the print. Time fades enough things already.'],\n        ['Can I return a personalized tee?', 'Each tee is made with your unique timestamp, so please check your size and captured moment before paying. For the live store, damaged or misprinted items should be reviewed for replacement. This is currently a test shop; no physical goods are sold or shipped. See the store policies for the current status.'],\n      ].map(([question, answer], i) => <article className={\"'`faq-item ${openFaq === i ? '\"'open' : ''}\"'`} key={question}><h3><button onClick={() => setOpenFaq(openFaq === i ? null : i)} aria-expanded={openFaq === i} aria-controls={`answer-${i}`}>{question}{openFaq === i ? <Minus size={18} /> : <Plus size={18} />}</button></h3><div id={`answer-${i}`} hidden={openFaq !== i}><p>{answer}</p></div></article>)}</div></section>\n      <section className=\"closing\"><span aria-hidden=\"true\">✧</span><p>Of all the moments in the universe,</p><h2>we’re glad you’re in <em>this one.</em></h2><a href=\"#shop\">Make it a keepsake <MoveUpRight size={18} /></a><span className=\"closing-star\" aria-hidden=\"true\">✦</span></section>\n    </main>\n    <footer className=\"wrap\"><a className=\"wordmark\" href=\"/\">datetime<span className=\"wordmark-dot\">.</span>store</a><p>A little shop for the present tense.</p><div><a href=\"/policies\">Store policies</a><span>© {new Date().getFullYear()} · Made in the moment.</span></div></footer>\n    <dialog ref={dialog} className={`store-dialog ${modal === '\"'size' ? 'size-dialog' : ''}\"'`} onCancel={() => { if (!busy) setModal(null); }} onClick={e => { if (e.target === dialog.current && !busy) setModal(null); }}>\n      <button className=\"dialog-close round-button\" disabled={busy} onClick={() => setModal(null)} aria-label=\"Close dialog\"><X size={20} /></button>\n      {modal === '\"'size' ? <><p className=\\\"eyebrow\\\">A LITTLE ROOM FOR YOUR MOMENT</p><h2>Find your fit.</h2><p className=\\\"dialog-description\\\">Garment measurements in inches, laid flat. Compare with a tee you love. Allow about 1 inch of variation.</p><div className=\\\"fit-options\\\"><button className={fit === 'unisex' ? 'active' : ''} onClick={() => chooseFit('unisex')}>Unisex</button><button className={fit === 'fitted' ? 'active' : ''} onClick={() => chooseFit('fitted')}>Fitted</button></div><table><caption>{fit === 'unisex' ? 'Gildan 64000' : 'Gildan 64000L'} sizing</caption><thead><tr><th>Size</th><th>Width</th><th>Length</th></tr></thead><tbody>{SIZES.map((s, i) => <tr key={s}><th>{s}</th><td>{fit === 'unisex' ? [18,20,22,24,26][i] : [16,17,18.5,19.5,22][i]}″</td><td>{fit === 'unisex' ? [28,29,30,31,32][i] : [25.25,26.25,27.25,28,28.5][i]}″</td></tr>)}</tbody></table><p className=\\\"size-tip\\\"><Ruler size={18} /> Between sizes? Size up for a more relaxed fit.</p><button className=\\\"capture-button\\\" onClick={() => setModal(null)}>Back to my tee <ArrowRight size={18} /></button></> : <><p className=\\\"eyebrow\\\">A LITTLE TIME CAPSULE</p><h2>{bag ? 'You caught a moment.' : 'Room for a moment.'}</h2>{bag ? <><p className=\\\"dialog-description\\\">The clock keeps going. This one stays with you.</p><div className=\\\"bag-item\\\"><div className={\"'`mini-tee tee-${bag.color}`}><img className=\"tee-photo\" src=\"/images/tee-black.webp\" alt=\"Your selected timestamp tee\" width=\"1254\" height=\"1254\" /><span style={{ color: COLORS.find(c => c.id === bag.color)!.ink }}>{bag.timestamp}</span></div><div><h3>The Now Tee</h3><p>{COLORS.find(c => c.id === bag.color)!.name} · {bag.fit === '\"'unisex' ? 'Unisex' : 'Fitted'} · {bag.size}</p><b>\"'$32.00</b></div></div><div className=\"bag-moment\"><span className=\"eyebrow\">YOURS, FOREVER</span><strong>{bag.timestamp}</strong><span>{readableMoment(bag.timestamp)}</span></div><div className=\"bag-totals\"><span>Shipping</span><b>On us</b><span>Total <small>USD</small></span><strong>$32.00</strong></div>{error && <p role=\"alert\" className=\"error-message\">{error}</p>}<button className=\"capture-button\" onClick={checkout} disabled={busy}>{busy ? <><LoaderCircle className=\"spin\" size={19} /> Opening secure checkout…</> : <>Continue to checkout <ArrowUpRight size={20} /></>}</button><p className=\"capture-note\"><LockKeyhole size={12} /> Secure checkout with Stripe{process.env.NEXT_PUBLIC_STORE_MODE !== '\"'live' ? ' · Test mode' : ''}</p><button className=\\\"start-over text-button\\\" disabled={busy} onClick={() => { removeBag(); setModal(null); }}><RotateCcw size={13} /> Let this one go & catch another</button></> : <><p className=\\\"dialog-description\\\">Your bag is empty. There’s a whole universe of moments out there. Let’s find yours.</p><div className=\\\"empty-bag\\\"><Clock3 size={72} strokeWidth={1} /><span>Every moment is a fresh start.</span></div><button className=\\\"capture-button\\\" onClick={() => setModal(null)}>Find my moment <ArrowRight size={20} /></button></>}</>}\n    </dialog>\n  </>;\n}\nEOF\ncat > app/globals.css <<'EOF'\n:root{--paper:#f8f7f1;--ink:#282923;--muted:#76766e;--line:#deded4;--lavender:#e7e2f3;--purple:#c4b6e6;--yellow:#f5efaf;--green:#657b4a;--serif:'Instrument Serif',Georgia,serif;--sans:'DM Sans',sans-serif;--mono:'DM Mono',monospace}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:32px}body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:14px;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}button,input{font:inherit}button,a{-webkit-tap-highlight-color:transparent}button{cursor:pointer;color:inherit}button:disabled{cursor:not-allowed;opacity:.5}button{border:0;background:none}button:focus-visible,a:focus-visible{outline:2px solid #7d639f;outline-offset:5px}::selection{background:#e0d3fc}fieldset{border:0;padding:0;margin:0;min-width:0}legend{padding:0;font-size:13px;font-weight:600}legend span{font-weight:400;color:var(--muted)}h1,h2,h3,p{margin:0}h1,h2{font-weight:400}img{max-width:100%;height:auto}.wrap{width:calc(100% - 112px);max-width:1328px;margin:auto}.announcement{height:33px;background:var(--yellow);display:flex;justify-content:center;align-items:center;gap:18px;font-family:var(--mono);font-size:9px;letter-spacing:1.1px}.site-header{height:99px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.wordmark{font-size:28px;letter-spacing:-1.4px;font-weight:600;display:flex;align-items:center;white-space:nowrap}.wordmark-dot{color:#806ca7}.brand-clock{display:grid;place-items:center;margin-right:10px}.brand-clock svg{width:28px;height:28px}.site-header nav{display:flex;align-items:center;gap:34px;font-size:12px}.site-header nav>a{padding:10px 0}.site-header nav>a:hover{color:#8465a6}.bag-button{display:flex;align-items:center;gap:9px;padding:11px 0 11px 14px}.bag-count{background:var(--lavender);border-radius:50%;width:23px;height:23px;display:grid;place-items:center;font-size:10px}.shop{padding-top:39px;padding-bottom:55px}.hero-intro{display:flex;align-items:center;justify-content:space-between;margin-bottom:31px}.eyebrow{font-family:var(--mono);font-size:10px;letter-spacing:1.2px;line-height:1.5}.tiny-star{font-size:14px;padding-right:6px;vertical-align:-1px}.hero-intro h1{font-family:var(--serif);font-size:clamp(66px,6.8vw,100px);letter-spacing:-3px;line-height:1.05;margin-top:10px;white-space:nowrap}em{font-family:var(--serif);font-weight:400}.hero-intro h1 em{color:#81709f}.heading-star{font-family:Georgia,serif;font-size:65px;display:inline-block;color:#a78bbc;margin-left:29px;vertical-align:6px;transform:rotate(8deg)}.intro-note{position:relative;font-size:13px;line-height:1.6;color:#67695e;padding-right:69px;padding-top:25px}.intro-note>span{font-family:var(--serif);font-size:47px;position:absolute;right:17px;top:28px;transform:rotate(5deg)}.product-layout{display:grid;grid-template-columns:minmax(0,1.36fr) minmax(340px,1fr);gap:66px}.product-stage{height:573px;border-radius:8px;background:var(--lavender);position:relative;overflow:hidden;isolation:isolate;background-image:radial-gradient(#9f8eac20 .65px,transparent .65px);background-size:5px 5px}.stage-meta{position:absolute;left:25px;right:25px;top:23px;display:flex;align-items:center;justify-content:space-between;z-index:3;font-family:var(--mono);font-size:8px;letter-spacing:.8px}.live-pill{display:flex;align-items:center;gap:6px;border-radius:30px;background:#f8f7f1c4;padding:7px 9px}.live-pill i,.status-dot{display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--green)}.live-pill i:not(.paused){animation:pulse 2s infinite}.live-pill i.paused{background:#89709c}.orbit{border:1px solid #b5a9c544;border-radius:50%;position:absolute;z-index:-1;left:50%;top:50%;transform:translate(-50%,-48%);width:480px;height:480px}.orbit-two{width:350px;height:350px}.tee-preview{position:absolute;width:86%;max-width:538px;left:50%;top:46%;transform:translate(-50%,-50%) rotate(-6deg);filter:drop-shadow(6px 16px 10px #29232925);transition:transform .4s}.tee-photo{display:block;width:100%;transition:filter .4s}.tee-white>.tee-photo{filter:invert(1) brightness(.91)}.tee-natural>.tee-photo{filter:invert(1) sepia(.24) saturate(.8) brightness(.87)}.fit-fitted.tee-preview{width:81%;transform:translate(-50%,-50%) rotate(-6deg) scaleX(.93)}.tee-timestamp{position:absolute;top:30.5%;left:50%;transform:translateX(-50%);font-family:var(--mono);font-size:clamp(13px,1.42vw,20px);letter-spacing:.15px;white-space:nowrap}.stage-spark{position:absolute;font-family:Georgia,serif}.spark-one{top:86px;left:44px;color:#9380b6;font-size:37px;transform:rotate(-15deg)}.spark-two{right:31px;bottom:127px;font-size:55px;color:#f9f7e8}.time-sticker{width:97px;height:97px;border-radius:50%;background:var(--yellow);position:absolute;bottom:74px;left:28px;display:flex;gap:5px;align-items:center;justify-content:center;transform:rotate(-12deg);box-shadow:3px 4px 0 #3335240d;border:1px solid #e8dea1}.time-sticker span{font-family:var(--mono);font-size:10px;line-height:1.5;letter-spacing:1px}.stage-bottom{position:absolute;bottom:21px;left:26px;right:24px;display:flex;align-items:center;justify-content:space-between}.handwritten{font-family:var(--serif);font-style:italic;font-size:22px;color:#655576;transform:rotate(-4deg)}.round-button{width:33px;height:33px;border:1px solid #a194b066;border-radius:50%;display:grid;place-items:center;background:#ffffff4a}.round-button:hover{background:var(--paper)}.gallery-bottom{display:flex;align-items:center;justify-content:space-between;margin-top:16px;gap:10px}.view-tabs{display:flex;gap:5px}.view-tabs button{font-size:10px;border-radius:20px;padding:7px 13px;display:flex;align-items:center;gap:6px;color:var(--muted)}.view-tabs button.selected{background:var(--ink);color:white}.gallery-bottom p{font-size:10px;color:var(--muted)}.product-info{padding:8px 0 0}.muted{color:var(--muted);font-size:9px}.product-title{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:10px}.product-title h2{font-family:var(--serif);font-size:46px;letter-spacing:-1.1px}.product-title>span{font-size:24px;letter-spac