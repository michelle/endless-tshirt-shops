{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport pathlib,os,re,json,urllib.request\ns=pathlib.Path(os.environ['BENCHMARK_STRIPE_CONFIG']).read_text();key=re.search(r'(?:rkcs|sk|rk)_test_[A-Za-z0-9]+',s).group()\npathlib.Path('.env.local').write_text('STRIPE_SECRET_KEY='+key+'\\\\nPRODIGI_API_KEY='+os.environ['PRODIGI_API_KEY']+'\\\\nPRODIGI_ENV=sandbox\\\\nNEXT_PUBLIC_STORE_MODE=test\\\\nSITE_URL=https://'+os.environ['BENCHMARK_VERCEL_PROJECT']+'.vercel.app\\\\n')\nfor sku in ['GLOBAL-TEE-GIL-64000L']:\n try:\n  req=urllib.request.Request('https://api.sandbox.prodigi.com/v4.0/products/'+sku,headers={'X-API-Key':os.environ['PRODIGI_API_KEY']});d=json.load(urllib.request.urlopen(req));pathlib.Path('/tmp/'+sku+'.json').write_text(json.dumps(d)); print(sku,d.get('outcome'),d.get('product',{}).get('attributes'))\n except Exception as e: print(sku,str(e))\nPY\"","aggregated_output":"GLOBAL-TEE-GIL-64000L Ok {'brand': ['Gildan'], 'edge': ['Crew neck'], 'color': ['azalea', 'black', 'charcoal', 'daisy', 'dark heather grey', 'dark chocolate', 'heather grey', 'heather purple', 'irish green heather', 'irish green', 'light blue', 'navy blue', 'orange heather', 'purple', 'red', 'royal blue', 'sport grey', 'white'], 'gender': [\"Women's\"], 'paperType': ['50% cotton, 50% polyester'], 'size': ['2xl', '3xl', 'l', 'm', 's', 'xl'], 'style': ['64000L']}\n","exit_code":0,"status":"completed"}}
