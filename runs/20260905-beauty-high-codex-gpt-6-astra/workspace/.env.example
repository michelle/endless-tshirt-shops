# Keep all secrets on the server. Never add a NEXT_PUBLIC prefix to a secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRODIGI_API_KEY=
PRODIGI_ENV=sandbox
ARTWORK_SIGNING_SECRET=
SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_MODE=test
# Only set for an explicitly configured live store (matching live Stripe + Prodigi).
LIVE_ORDERS_ENABLED=false
