# Stripe — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Set after creating the endpoint: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Scalable Press — sent as the HTTP basic auth *password*
SP_AUTH=

# Set to "true" to skip the real /order submission while testing
SP_DRY_RUN=false
