pan class=\"se\">\\</span>\n1037-  <span class=\"nt\">-d</span> <span class=\"s2\">\"address[name]=My Customer\"</span> <span class=\"se\">\\</span>\n1038-  <span class=\"nt\">-d</span> <span class=\"s2\">\"address[address1]=123 Scalable Drive\"</span> <span class=\"se\">\\</span>\n1039-  <span class=\"nt\">-d</span> <span class=\"s2\">\"address[city]=West Pressfield\"</span> <span class=\"se\">\\</span>\n1040-  <span class=\"nt\">-d</span> <span class=\"s2\">\"address[state]=CA\"</span> <span class=\"se\">\\</span>\n1041-  <span class=\"nt\">-d</span> <span class=\"s2\">\"address[zip]=12345\"</span> <span class=\"se\">\\</span>\n1042:  <span class=\"nt\">-d</span> <span class=\"s2\">\"designId=53ed3a23b3730f0e27a66513\"</span>\n1043-</code></pre></div>\n1044-<blockquote>\n1045-<p>EXAMPLE RESPONSE</p>\n1046-</blockquote>\n1047-<div class=\"highlight\"><pre class=\"highlight json\"><code><span class=\"p\">{</span><span class=\"w\">\n1048-  </span><span class=\"nl\">\"total\"</span><span class=\"p\">:</span><span class=\"w\"> </span><span class=\"mf\">224.17</span><span class=\"p\">,</span><span class=\"w\">\n1049-  </span><span class=\"nl\">\"subtotal\"</span><span class=\"p\">:</span><span class=\"w\"> </span><span class=\"mf\">191.99</span><span class=\"p\">,</span><span class=\"w\">\n1050-  </span><span class=\"nl\">\"tax\"</span><span class=\"p\">:</span><span class=\"w\"> </span><span class=\"mf\">20.38</span><span class=\"p\">,</span><span class=\"w\">\n1051-  </span><span class=\"nl\">\"fees\"</span><span class=\"p\">:</span><span class=\"w\"> </span><span class=\"mi\">1</span><span class=\"p\">,</span><span class=\"w\">\n1052-  </span><span class=\"nl\">\"shipping\"</span><span class=\"p\">:</span><span class=\"w\"> </span><span class=\"mf\">10.80</span><span class=\"p\">,</span><span class=\"w\">\n1053-  </span><span class=\"nl\">\"orderToken\"</span><span class=\"p\">:</span><span class=\"w\"> </span><span class=\"s2\">\"c6ae6ca449719e5237d103139255ecdd\"</