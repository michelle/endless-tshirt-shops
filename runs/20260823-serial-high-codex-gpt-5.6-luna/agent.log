{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"set -e\nsite='https://benchmark-20260823-serial-high-code-three.vercel.app'\nprintf '%s\\\\n' '--- public surface ---'\ncurl -fsS \\\"\"'$site/\" | rg -o '\"'<title>[\"'^<]+|/app.js|/favicon.svg'\"' | head -10\ncurl -fsS \\\"\"'$site/styles.css\" | rg -o '\"'Wear the|product-stage|@media' | head -10\nprintf '%s\\\\n' '--- deployed API flow ---'\nSITE=\\\"\"'$site\" node <<'\"'NODE'\nconst site = process.env.SITE;\nconst png = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII=';\nasync function call(path, options) { const r = await fetch(site + path, options); const body = await r.json(); return { status: r.status, body }; }\n(async () => {\n  const invalid = await call('/api/create-checkout-session', { method: 'POST', headers: {'content-type':'application/json'}, body: JSON.stringify({style:'bad',size:'M',designId:'nope'}) });\n  console.log(\"'`invalid_options_status=${invalid.status} message=${invalid.body.error}`);\n  const prepared = await call('\"'/api/prepare-order', { method: 'POST', headers: {'content-type':'application/json'}, body: JSON.stringify({style:'fitted',size:'M',artwork:png}) });\n  console.log(\"'`scalable_press_design_status=${prepared.status} design_returned=${Boolean(prepared.body.designId)}`);\n  if (!prepared.body.designId) process.exit(1);\n  const checkout = await call('\"'/api/create-checkout-session', { method: 'POST', headers: {'content-type':'application/json'}, body: JSON.stringify({style:'fitted',size:'M',designId:prepared.body.designId}) });\n  console.log(\"'`stripe_checkout_status=${checkout.status} checkout_url_returned=${Boolean(checkout.body.url)} session_id_returned=${Boolean(checkout.body.sessionId)}`);\n  const status = await call(`/api/order-status?session_id=${encodeURIComponent(checkout.body.sessionId)}`);\n  console.log(`order_status_endpoint=${status.status} payment_state=${status.body.status}`);\n})().catch(error => { console.error(error.message); process.exit(1); });\nNODE'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
