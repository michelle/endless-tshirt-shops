{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"node <<'NODE'\nconst { createDesign, quote } = require('./api/_lib');\nconst { PNG } = require('pngjs');\n(async()=>{const p=new PNG({width:1800,height:500}); for(let i=0;i<p.data.length;i+=4){p.data[i]=255;p.data[i+1]=255;p.data[i+2]=255;p.data[i+3]=255;} const id=await createDesign(\"'`data:image/png;base64,${PNG.sync.write(p).toString('\"'base64')}\"'`); console.log(`design=${id}`); for(const ms of [0,1000,5000,15000]) {await new Promise(r=>setTimeout(r,ms)); try {const q=await quote({style:'\"'fitted',size:'M',designId:id,address:{name:'Test Customer',address1:'185 Berry St',city:'San Francisco',state:'CA',zip:'94107'}}); console.log(\"'`wait=${ms} orderToken=${Boolean(q.orderToken)} status=${q.statusCode||200}`); } catch(e){console.log(`wait=${ms} error=${e.message}`)}}})().catch(console.error)\nNODE'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
