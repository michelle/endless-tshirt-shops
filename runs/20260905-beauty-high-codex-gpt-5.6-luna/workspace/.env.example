# Required for real payments. Test-mode secret keys start with sk_test_.
STRIPE_SECRET_KEY=
# Required for signature verification in production.
STRIPE_WEBHOOK_SECRET=
# Provided for this build. Keep server-only.
PRODIGI_API_KEY=
# Public URL used by Stripe return links and Prodigi artwork downloads.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set true only when you want a visible, no-charge walkthrough without Stripe.
CHECKOUT_DEMO_MODE=false
