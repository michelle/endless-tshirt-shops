# Stripe secret key — test mode (sk_test_ / rkcs_test_ …) or live (sk_live_…).
STRIPE_SECRET_KEY=

# Prodigi Print API key. Sandbox key -> orders are simulated; live key prints
# for real only if PRODIGI_ENV=live is also set.
PRODIGI_API_KEY=

# Optional: 'live' sends orders to api.prodigi.com. Default/absent = sandbox.
PRODIGI_ENV=

# Random hex used to HMAC-sign artwork URLs (openssl rand -hex 32).
ARTWORK_SIGNING_KEY=

# Optional: enables signature-verified webhook fulfilment. Without it the
# return-URL path fulfils orders and this endpoint returns 501.
STRIPE_WEBHOOK_SECRET=
