# Stripe test/sandbox account keys. Never expose STRIPE_SECRET_KEY to the browser.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Create this with `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=whsec_...
# Prodigi sandbox key for development; swap the API base URL and key only after launch readiness.
PRODIGI_API_KEY=...
PRODIGI_API_BASE=https://api.sandbox.prodigi.com/v4.0
# Must be the public deployed URL so Prodigi can download the generated print asset.
PUBLIC_APP_URL=https://your-deployment.vercel.app
