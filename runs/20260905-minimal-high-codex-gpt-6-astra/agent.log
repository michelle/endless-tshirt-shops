TW\", \"TZ\", \"US\", \"UY\", \"VE\", \"VI\", \"XK\", \"ZA\", \"ZW\", \"AM\", \"AZ\", \"BA\", \"CA\", \"CI\", \"GB\", \"GE\", \"IM\", \"KG\", \"KH\", \"KZ\", \"LY\", \"ME\", \"MQ\", \"NA\", \"SC\", \"TJ\", \"UA\", \"BN\"], \"printAreaSizes\": {\"back\": {\"horizontalResolution\": 4677, \"verticalResolution\": 5881}, \"front\": {\"horizontalResolution\": 4677, \"verticalResolution\": 5881}}, \"pagePricing\": null}, {\"attributes\": {\"brand\": \"Gildan\", \"edge\": \"Crew neck\", \"color\": \"white\", \"gender\": \"Women's\", \"paperType\": \"50% cotton, 50% polyester\", \"size\": \"s\", \"style\": \"64000L\"}, \"shipsTo\": [\"AT\", \"BE\", \"CH\", \"CY\", \"CZ\", \"DE\", \"DK\", \"EE\", \"ES\", \"FI\", \"FR\", \"GB\", \"GR\", \"HR\", \"HU\", \"IE\", \"IS\", \"IT\", \"LT\", \"LU\", \"LV\", \"MT\", \"NL\", \"NO\", \"PL\", \"PT\", \"SE\", \"SI\", \"SK\", \"TR\"], \"printAreaSizes\": {\"back\": {\"horizontalResolution\": 2480, \"verticalResolution\": 3507}, \"front\": {\"horizontalResolution\": 2480, \"verticalResolution\": 3507}, \"neck label\": {\"horizontalResolution\": 2480, \"verticalResolution\": 3507}, \"sleeve\": {\"horizontalResolution\": 2480, \"verticalResolution\": 3507}}, \"pagePricing\": null}, {\"attributes\": {\"brand\": \"Gildan\", \"edge\": \"Crew neck\", \"color\": \"white\", \"gender\": \"Women's\", \"paperType\": \"50% cotton, 50% polyester\", \"size\": \"s\", \"style\": \"64000L\"}, \"shipsTo\": [\"US\"], \"printAreaSizes\": {\"back\": {\"horizontalResolution\": 2490, \"verticalResolution\": 3510}, \"front\": {\"horizontalResolution\": 2490, \"verticalResolution\": 3510}}, \"pagePricing\": null}, {\"attributes\": {\"brand\": \"Gildan\", \"edge\": \"Crew neck\", \"color\": \"white\", \"gender\": \"Women's\", \"paperType\": \"50% cotton, 50% polyester\", \"size\": \"xl\", \"style\": \"64000L\"}, \"shipsTo\": [\"AE\", \"AL\", \"AR\", \"AT\", \"AU\", \"BB\", \"BD\", \"BE\", \"BG\", \"BH\", \"BM\", \"BO\", \"BR\", \"BS\", \"BY\", \"CH\", \"CL\", \"CN\",