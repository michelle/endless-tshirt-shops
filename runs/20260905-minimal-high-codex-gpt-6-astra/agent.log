r:1px solid var(--green);border-radius:3px;height:55px;display:flex;align-items:center;justify-content:center;gap:32px;font-size:13px;transition:background .15s}.checkout:hover{background:#3e4d34}.checkout-notes{display:flex;justify-content:center;gap:25px;color:var(--muted);font-size:10px;margin:17px 0}.checkout-notes span{display:flex;gap:7px;align-items:center}.test-note{font-size:9px;color:#818777;text-align:center}.how{max-width:1152px;margin:auto;padding:44px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:grid;grid-template-columns:1.15fr 1fr 1fr 1fr;gap:40px}.how h2{font-size:30px;font-weight:400;letter-spacing:-1px;line-height:1.15;margin:15px 0 0}.step{padding-top:6px}.step>span{font:9px var(--mono);letter-spacing:1px;color:var(--muted)}.step h3{font-size:14px;font-weight:500;margin:22px 0 10px}.step p{font-size:11px;color:var(--muted);line-height:1.9;margin:0}.details{text-align:center;padding:80px 24px}.details h2{font:italic 43px/1.2 Georgia,serif;color:var(--green);letter-spacing:-1px;margin:23px 0}.details p{font-size:12px;color:var(--muted);line-height:1.9}footer{border-top:1px solid var(--line);padding:32px 56px;display:flex;justify-content:space-between;align-items:center;gap:20px;max-width:1360px;margin:auto}footer .brand{font-size:19px}footer>span{font-size:10px;color:var(--muted)}footer>span:last-child{font:9px var(--mono);display:flex;gap:10px;align-items:center} @keyframes blink{50%{opacity:0}}@media(min-width:1450px){.intro{padding-top:76px}.product{gap:75px}}@media(max-width:1000px){.header{padding:0 28px}.header-note{display:none}.product{gap:28px}.preview{min-height:500px;justify-content:center}.preview-top{position:absolute;top:0;width:100%}.preview-bottom{position:absolute;bottom:0;width:100%}.product-heading h2{font-size:23px}.counter{font-size:25px}.how{margin:0 24px;gap:24px}.shirt-stamp{font-size:15px}}@media(max-width:700px){.header{height:77px;padding:0 21px}.brand{font-size:21px}.header nav{gap:18px;