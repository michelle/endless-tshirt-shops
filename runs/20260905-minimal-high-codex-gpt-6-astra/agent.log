{"type":"item.started","item":{"id":"item_80","type":"command_execution","command":"/bin/zsh -lc \"node --env-file=.env.local --input-type=module - <<'JS'\nimport fs from 'node:fs/promises';import Stripe from 'stripe';import sharp from 'sharp';const stripe=new Stripe(process.env.STRIPE_SECRET_KEY);const base=process.env.APP_URL,j=JSON.parse(await fs.readFile('work/test-unisex.json','utf8'));const s=await stripe.checkout.sessions.retrieve(j.sessionId);const token=[REDACTED_SECRET] asset=await fetch(base+'/api/artwork/'+token);const b=Buffer.from(await asset.arrayBuffer());const m=await sharp(b).metadata();console.log('Public print asset',asset.status,{width:m.width,height:m.height,dpi:m.density,alpha:m.hasAlpha});await fs.writeFile('work/deployed-artwork.png',b);\nconst outcomes=[];for(const [label,url,body,origin]of [['paid order','/api/orders',{sessionId:j.sessionId,token:[REDACTED_SECRET]'bad order token','/api/orders',{sessionId:j.sessionId,token:'a'.repeat(43)},base],['price tampering','/api/checkout',{...j.input,timestamp:Date.now(),price:1},base],['foreign origin','/api/checkout',{...j.input,timestamp:Date.now()},'https://example.org']]){const r=await fetch(base+url,{method:'POST',headers:{'Content-Type':'application/json',Origin:origin},body:JSON.stringify(body)});const d=await r.json();console.log(label,r.status,label==='paid order'?{status:d.status,prodigiOrderId:d.prodigiOrderId,timestamp:d.timestamp}:d);outcomes.push({label,status:r.status,data:d});}\nfor(const route of ['/api/artwork/fake','/api/cron/reconcile']){const r=await fetch(base+route);console.log(route,r.status);}\nconst fake=await fetch(base+'/api/stripe/webhook',{method:'POST',headers:{'Content-Type':'application/json','stripe-signature':'invalid'},body:'{}'});console.log('Forged webhook',fake.status);\nawait fs.writeFile('work/deployed-checks.json',JSON.stringify(outcomes,null,2));\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
