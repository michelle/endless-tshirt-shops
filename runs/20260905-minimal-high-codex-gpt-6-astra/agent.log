{"type":"item.started","item":{"id":"item_77","type":"command_execution","command":"/bin/zsh -lc \"node --env-file=.env.local --input-type=module - <<'JS'\nimport fs from 'node:fs/promises';import Stripe from 'stripe';const stripe=new Stripe(process.env.STRIPE_SECRET_KEY);const j=JSON.parse(await fs.readFile('work/test-unisex.json','utf8'));const s=await stripe.checkout.sessions.retrieve(j.sessionId);console.log('Webhook result',{session:s.id,payment:s.payment_status,fulfillment:s.metadata.fulfillment_state,prodigiOrder:s.metadata.prodigi_order_id});if(s.metadata.prodigi_order_id){const r=await fetch('https://api.sandbox.prodigi.com/v4.0/orders/'+s.metadata.prodigi_order_id,{headers:{'X-API-Key':process.env.PRODIGI_API_KEY}});const p=await r.json();await fs.writeFile('work/prodigi-unisex.json',JSON.stringify(p,null,2));console.log('Prodigi result',{outcome:p.outcome,id:p.order?.id,status:p.order?.status,items:p.order?.items?.map(i=>({sku:i.sku,attributes:i.attributes,assets:i.assets.map(a=>({status:a.status,printArea:a.printArea}))}))});}\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
