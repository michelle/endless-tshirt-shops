{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"node - <<'NODE'\nconst key=process.env.PRODIGI_API_KEY;\nconst skus=['GLOBAL-TEE-BC-3003','TEE-BC-3003','GLOBAL-TEE-GD-64000','A-MT-GD64000'];\n(async()=>{for(const sku of skus){const r=await fetch(\"'`https://api.sandbox.prodigi.com/v4.0/products/${sku}`,{headers:{'\"'X-API-Key':key}}); console.log('\\\\n',sku,r.status); const j=await r.json().catch(()=>({})); console.log(JSON.stringify(j).slice(0,2800));}})().catch(console.error)\nNODE\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"node - <<'NODE'\nconst key=process.env.PRODIGI_API_KEY;\nconst skus=['GLOBAL-TEE-BC-3003','TEE-BC-3003','GLOBAL-TEE-GD-64000','A-MT-GD64000'];\n(async()=>{for(const sku of skus){const r=await fetch(\"'`https://api.sandbox.prodigi.com/v4.0/products/${sku}`,{headers:{'\"'X-API-Key':key}}); console.log('\\\\n',sku,r.status); const j=await r.json().catch(()=>({})); console.log(JSON.stringify(j).slice(0,2800));}})().catch(console.error)\nNODE\"","aggregated_output":"\n GLOBAL-TEE-BC-3003 200\n{\"outcome\":\"Ok\",\"product\":{\"sku\":\"GLOBAL-TEE-BC-3003\",\"description\":\"Men's Classic T-shirt with a curved hem, Bella + Canvas 3003\",\"productDimensions\":{\"width\":15,\"height\":17,\"units\":\"in\"},\"attributes\":{\"brand\":[\"Bella + Canvas\"],\"edge\":[\"Crew neck\"],\"color\":[\"black\",\"cool grey heather\",\"dark grey\",\"navy blue\",\"oxblood black\",\"sand dune heather\",\"white\"],\"gender\":[\"Men's\"],\"paperType\":[\"100% ringspun cotton\"],\"size\":[\"2xl\",\"l\",\"m\",\"s\",\"xl\"],\"style\":[\"3003\"]},\"printAreas\":{\"back\":{\"required\":false},\"front\":{\"required\":true}},\"variants\":[{\"attributes\":{\"brand\":\"Bella + Canvas\",\"edge\":\"Crew neck\",\"color\":\"black\",\"gender\":\"Men's\",\"paperType\":\"100% ringspun cotton\",\"size\":\"2xl\",\"style\":\"3003\"},\"shipsTo\":[\"US\"],\"printAreaSizes\":{\"back\":{\"horizontalResolution\":2490,\"verticalResolution\":3510},\"front\":{\"horizontalResolution\":2490,\"verticalResolution\":3510}},\"pagePricing\":null},{\"attributes\":{\"brand\":\"Bella + Canvas\",\"edge\":\"Crew neck\",\"color\":\"black\",\"gender\":\"Men's\",\"paperType\":\"100% ringspun cotton\",\"size\":\"l\",\"style\":\"3003\"},\"shipsTo\":[\"US\"],\"printAreaSizes\":{\"back\":{\"horizontalResolution\":2490,\"verticalResolution\":3510},\"front\":{\"horizontalResolution\":2490,\"verticalResolution\":3510}},\"pagePricing\":null},{\