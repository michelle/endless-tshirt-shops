# Stripe. Test keys look like sk_test_… / rk_test_… and pk_test_….
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Scalable Press. Sent as the password of HTTP basic auth, with an empty user.
SP_AUTH=

# From `stripe listen` locally, or the endpoint's signing secret in the dashboard.
STRIPE_WEBHOOK_SECRET=

# Shared secret for /api/ops/fulfillment. Leave unset and that route 404s.
OPS_TOKEN=

# Vercel Cron authenticates with this. Set it to the same value as OPS_TOKEN.
CRON_SECRET=
