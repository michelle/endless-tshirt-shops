# Heliogram runtime configuration
# Copy to .env and fill in. The deploy script (scripts/deploy.mjs) reads this.

# Stripe — test mode keys from https://dashboard.stripe.com/test/apikeys
# (sandbox restricted keys work for checkout + webhooks; see README limitations)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Random 64-hex string; signs artwork URLs so they cannot be forged.
# Generate: openssl rand -hex 32
ART_SIGNING_SECRET=

# Set automatically by scripts/deploy.mjs after it creates the Stripe webhook.
STRIPE_WEBHOOK_SECRET=

# Prodigi Print API. Sandbox: https://api.sandbox.prodigi.com/v4.0
# Live:    https://api.prodigi.com/v4.0
PRODIGI_API_KEY=
PRODIGI_API_BASE=https://api.sandbox.prodigi.com/v4.0

# Set automatically by scripts/deploy.mjs (the deployment URL artwork links point at).
PUBLIC_BASE_URL=

# Pricing in cents
PRICE_CENTS=3800
SHIPPING_CENTS=795
