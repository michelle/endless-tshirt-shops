ns/cache/openai-bundled/sites/0.1.37/skills/sites-building/templates/vinext-starter/next.config.ts\n/Users/mchl/.codex/plugins/cache/openai-bundled/sites/0.1.37/skills/sites-building/templates/vinext-starter/eslint.config.mjs\n/Users/mchl/.codex/plugins/cache/openai-bundled/sites/0.1.37/skills/sites-building/templates/vinext-starter/worker/index.ts\n/Users/mchl/.codex/plugins/cache/openai-bundled/sites/0.1.37/skills/sites-building/templates/vinext-starter/vite.config.ts\n/Users/mchl/.codex/plugins/cache/openai-bundled/sites/0.1.37/skills/sites-building/templates/vinext-starter/drizzle.config.ts\n/Users/mchl/.codex/plugins/cache/openai-bundled/sites/0.1.37/skills/sites-building/templates/vinext-starter/tsconfig.json\n/Users/mchl/.codex/plugins/cache/openai-bundled/sites/0.1.37/skills/sites-building/templates/vinext-starter/README.md\n/Users/mchl/.codex/plugins/cache/openai-bundled/sites/0.1.37/skills/sites-building/templates/vinext-starter/next-env.d.ts\n/Users/mchl/.codex/plugins/cache/openai-bundled/sites/0.1.37/skills/sites-building/templates/vinext-starter/db/index.ts\n/Users/mchl/.codex/plugins/cache/openai-bundled/sites/0.1.37/skills/sites-building/templates/vinext-starter/db/schema.ts\n/Users/mchl/.codex/plugins/cache/openai-bundled/sites/0.1.37/skills/sites-building/templates/vinext-starter/tests/rendered-html.test.mjs\n/Users/mchl/.codex/plugins/cache/openai-bundled/sites/0.1.37/skills/sites-building/templates/vinext-starter/postcss.config.mjs\n/Users/mchl/.codex/plugins/cache/openai-bundled/sites/0.1.37/skills/sites-building/templates/vinext-starter/app/globals.css\n/Users/mchl/.codex/plugins/cache/openai-bundled/sites/0.1.37/skills/sites-building/templates/vinext-starter/app/page.tsx\n/Users/mchl/.codex/plugins/cache/openai-bundled/sites/0.1.37/skills/sites-building/templates/vinext-starter/app/layout.tsx\n/Users/mchl/.codex/plugins/cache/openai-bundled/sites/0.1.37/skills/sites-building/templates/vinext-starter/app/_sites-preview/preview.css\n/Users/mchl/