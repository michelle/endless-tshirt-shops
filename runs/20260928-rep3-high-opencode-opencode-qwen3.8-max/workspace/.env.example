# Stripe (test mode). Create keys: https://dashboard.stripe.com/test/apikeys
# or provision a claimable sandbox with `stripe sandbox create`.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Webhook signing secret. Register an endpoint pointing at
# {APP_URL}/api/stripe/webhook with event checkout.session.completed,
# or forward locally with `stripe listen --forward-to <url>/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Prodigi Print API. Sandbox keys start with "test_" and use
# api.sandbox.prodigi.com automatically.
PRODIGI_API_KEY=test_xxx

# Public origin of this deployment, e.g. https://my-store.vercel.app
APP_URL=http://localhost:3000
