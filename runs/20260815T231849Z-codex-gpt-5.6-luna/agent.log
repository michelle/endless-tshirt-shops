+<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Order confirmed — datetime.store</title><link rel="stylesheet" href="/src/styles.css"></head><body><main class="success-page"><p class="eyebrow">Order received</p><h1>Good choice.<br><em>Great timing.</em></h1><p class="lede">Your datetime tee is being prepared. We’re confirming the print file with our fulfillment partner now.</p><div class="success-box"><span class="pulse"></span><span id="status">Submitting to fulfillment…</span></div><a class="back" href="/">← Back to the store</a></main><script>const id=new URLSearchParams(location.search).get('session_id');fetch('/api/order-status?session_id='+encodeURIComponent(id)).then(r=>r.json()).then(d=>{document.querySelector('#status').textContent=d.orderId?'Order '+d.orderId+' · fulfillment submitted':'Payment received · '+(d.error||'we’ll follow up shortly')}).catch(()=>document.querySelector('#status').textContent='Payment received · fulfillment confirmation pending');</script></body></html>

