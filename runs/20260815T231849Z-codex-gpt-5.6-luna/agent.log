x solid var(--ink);padding-top:18px;max-width:430px}.card-top{display:flex;justify-content:space-between;color:#777}.stock{color:#3f946c}.stock:first-letter{color:#42b47d}.order-card h2{font-size:31px;letter-spacing:-.05em;margin:42px 0 26px}.field-label{font-size:10px;color:#888;margin:24px 0 10px}.choices{display:grid;grid-template-columns:1fr 1fr;gap:8px}.choice,.size{font:500 14px 'Space Grotesk';background:transparent;border:1px solid #c9c5be;padding:13px;text-align:left;cursor:pointer}.choice small{display:block;color:#888;font-size:11px;font-weight:400;margin-top:5px}.choice.selected,.size.selected{background:var(--ink);border-color:var(--ink);color:#fff}.choice.selected small{color:#bbb}.sizes{display:flex;gap:8px}.size{width:53px;text-align:center}.buy{margin-top:34px;width:100%;height:57px;background:var(--ink);color:#fff;border:0;font:600 15px 'Space Grotesk';cursor:pointer;text-align:left;padding:0 21px}.buy span{float:right;font-size:22px}.buy:hover{background:#314f78}.buy:disabled{opacity:.65;cursor:wait}.shipping{font:11px 'DM Mono',monospace;line-height:1.7;color:#888}.message{color:#c1432e;font-size:13px;min-height:18px;margin-top:10px}.spinner{display:inline-block!important;float:right!important;width:16px;height:16px;border:2px solid #888;border-top-color:white;border-radius:50%;animation:spin .7s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}footer{border-top:1px solid #d5d1ca;padding:21px 5vw;display:flex;justify-content:space-between;color:#999;font-size:10px}footer a{color:#999}@media(max-width:800px){header{height:68px}.header-note{display:none}main{padding-top:55px}.product{grid-template-columns:1fr;gap:50px}.product-art{max-width:560px}.order-card{max-width:none}.intro{margin-bottom:55px}footer{gap:12px;flex-wrap:wrap}footer span:last-of-type{display:none}}@media(max-width:460px){.intro h1{font-size:64px}.product-art{margin:0 -5vw}.edition{left:17px;top:17px}.price{bottom:18px;left:18px}.print-time{font-size:13px}}
