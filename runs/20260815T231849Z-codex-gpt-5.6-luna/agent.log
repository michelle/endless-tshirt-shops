+:root{--ink:#111;--paper:#f3f1ed;--blue:#b9d6ff;--orange:#ff6138}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:'Space Grotesk',Arial,sans-serif}header{height:84px;border-bottom:1px solid #d5d1ca;display:flex;align-items:center;justify-content:space-between;padding:0 5vw}.wordmark{font-size:20px;font-weight:600;letter-spacing:-.8px;color:inherit;text-decoration:none}.wordmark span{color:#6c88ac}.header-note,.field-label,footer,.edition,.stamp small,.card-top{font:11px 'DM Mono',monospace;letter-spacing:.08em}.header-note{color:#777}main{max-width:1280px;margin:auto;padding:8vw 5vw 7vw}.intro{max-width:520px;margin-bottom:3.5vw}.eyebrow{font:12px 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.14em;color:#657d9e;margin:0 0 18px}.intro h1{font-size:clamp(58px,8vw,112px);line-height:.86;letter-spacing:-.08em;margin:0 0 30px;font-weight:600}.intro h1 em{font-style:normal;color:#9bbcf0}.lede{font-size:18px;line-height:1.4;max-width:380px;color:#5c5a56;margin:0}.stamp{margin-top:34px;font:14px 'DM Mono',monospace;display:flex;align-items:center;gap:9px}.stamp small{color:#999;font-size:9px}.pulse{width:8px;height:8px;background:var(--orange);border-radius:50%;box-shadow:0 0 0 5px #ff613822}.product{display:grid;grid-template-columns:minmax(420px,1.3fr) minmax(350px,.7fr);gap:8vw;align-items:center}.product-art{background:#bdd7fb;aspect-ratio:1.04;position:relative;overflow:hidden}.shirt-svg{position:absolute;width:83%;height:94%;left:8%;top:4%}.shirt{fill:#101010}.seam{fill:none;stroke:#303030;stroke-width:2}.print-time{position:absolute;color:#fafafa;top:36.8%;left:20%;width:60%;text-align:center;font:17px 'DM Mono',monospace;letter-spacing:-.08em}.edition{position:absolute;left:24px;top:25px;line-height:1.5;color:#5d7190;z-index:1}.edition b{font-size:15px}.price{position:absolute;bottom:28px;left:30px;font:18px 'DM Mono',monospace}.price del{font-size:13px;color:#7992b5;margin-right:7px}.order-card{border-top:2px solid var(--ink);padding-top:18px;max-width:430px}.card-top{display:flex;justify-content:space-between;color:#777}.stock{color:#3f946c}.stock:first-letter{color:#42b47d}.order-card h2{font-size:31px;letter-spacing:-.05em;margin:42px 0 26px}.field-label{font-size:10px;color:#888;margin:24px 0 10px}.choices{display:grid;grid-template-columns:1fr 1fr;gap:8px}.choice,.size{font:500 14px 'Space Grotesk';background:transparent;border:1px solid #c9c5be;padding:13px;text-align:left;cursor:pointer}.choice small{display:block;color:#888;font-size:11px;font-weight:400;margin-top:5px}.choice.selected,.size.selected{background:var(--ink);border-color:var(--ink);color:#fff}.choice.selected small{color:#bbb}.sizes{display:flex;gap:8px}.size{width:53px;text-align:center}.buy{margin-top:34px;width:100%;height:57px;background:var(--ink);color:#fff;border:0;font:600 15px 'Space Grotesk';cursor:pointer;text-align:left;padding:0 21px}.buy span{float:right;font-size:22px}.buy:hover{background:#314f78}.buy:disabled{opacity:.65;cursor:wait}.shipping{font:11px 'DM Mono',monospace;line-height:1.7;color:#888}.message{color:#c1432e;font-size:13px;min-height:18px;margin-top:10px}.spinner{display:inline-block!important;float:right!important;width:16px;height:16px;border:2px solid #888;border-top-color:white;border-radius:50%;animation:spin .7s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}footer{border-top:1px solid #d5d1ca;padding:21px 5vw;display:flex;justify-content:space-between;color:#999;font-size:10px}footer a{color:#999}@media(max-width:800px){header{height:68px}.header-note{display:none}main{padding-top:55px}.product{grid-template-columns:1fr;gap:50px}.product-art{max-width:560px}.order-card{max-width:none}.intro{margin-bottom:55px}footer{gap:12px;flex-wrap:wrap}footer span:last-of-type{display:none}}@media(max-width:460px){.intro h1{font-size:64px}.product-art{margin:0 -5vw}.edition{left:17px;top:17px}.price{bottom:18px;left:18px}.print-time{font-size:13px}}
