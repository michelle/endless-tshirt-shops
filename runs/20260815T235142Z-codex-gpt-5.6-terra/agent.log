s label.active{border-color:#111;background:#111;color:white}.choices input{position:absolute;opacity:0}.choices b{display:block;font-size:14px}.choices small{font-size:10px;opacity:.65;display:block;margin-top:4px}.sizes{grid-template-columns:repeat(4,1fr)}.sizes label{min-height:45px;text-align:center;padding:12px}.email{font-size:12px;font-weight:700;display:block;margin:28px 0 14px}.email input{display:block;width:100%;border:0;border-bottom:1px solid #999;background:transparent;padding:10px 0 9px;font:400 15px Manrope;outline:none}.email input:focus{border-color:#ff4d22}button,.again{cursor:pointer;display:block;border:0;width:100%;background:#ff4d22;color:white;padding:17px;font:700 14px Manrope;text-decoration:none;transition:.2s}button:hover,.again:hover{background:#de3716}button:disabled{opacity:.6;cursor:wait}button span{float:right;font-size:20px;line-height:12px}.fine{font-size:10px;line-height:1.5;color:#73736e;text-align:center;margin:12px 0}.selection{text-align:center;font:400 10px 'DM Mono',monospace;color:#73736e}.error{color:#c72f16;font-size:12px;margin:10px 0}footer{display:flex;justify-content:space-between;border-top:1px solid #d7d7d1;padding-top:20px;font:400 10px 'DM Mono',monospace;color:#777}.success{padding-top:38px}.success-card{max-width:610px;margin:14vh auto;text-align:center}.success-card h1{font-size:52px;margin:15px 0 20px}.success-card>p:not(.fine){font-size:16px;line-height:1.6}.check{width:48px;height:48px;border-radius:50%;background:#ff4d22;color:white;margin:auto;font-size:28px;line-height:48px}.again{margin:30px auto;width:max-content;padding:15px 24px}@media(max-width:760px){main{padding:24px 20px}header{grid-template-columns:1fr}.now{display:none}.shop{display:block;padding:36px 0}.product{margin-bottom:42px}.panel h1{font-size:42px}.shop .shirt{max-height:440px}.success-card{margin:18vh auto}.success-card h1{font-size:40px}footer{gap:8px;flex-direction:column}}
