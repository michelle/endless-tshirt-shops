@@ -0,0 +1,2 @@
+@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');
+*{box-sizing:border-box}html,body{margin:0;background:#f5f5f1;color:#121212;font-family:Manrope,Arial,sans-serif}main{max-width:1280px;margin:auto;padding:38px 52px 24px;min-height:100vh}header{display:grid;grid-template-columns:1fr auto;gap:8px;border-bottom:1px solid #d7d7d1;padding-bottom:27px}.wordmark{color:#111;text-decoration:none;font:700 25px/1 'DM Mono',monospace;letter-spacing:-1.6px}.wordmark span{color:#ff4d22}header p{margin:0;align-self:end;font-size:14px;color:#5c5c57}.now{grid-column:2;grid-row:1/3;align-self:center;font:500 10px 'DM Mono',monospace;letter-spacing:1px}.now i{display:inline-block;width:7px;height:7px;border-radius:50%;background:#ff4d22;margin-right:5px;animation:pulse 1.5s infinite}@keyframes pulse{50%{opacity:.35}}.shop{display:grid;grid-template-columns:minmax(420px,1.05fr) minmax(360px,.95fr);gap:9vw;padding:62px 6vw 38px}.shirt-wrap{position:relative;max-width:570px;margin:0 auto}.shirt{width:100%;display:block}.shadow{fill:#d8d8d2;transform:translate(10px,13px)}.stamp{font:500 23px 'DM Mono',monospace;letter-spacing:.5px}.micro{font:400 5px 'DM Mono',monospace;letter-spacing:1.4px}.price{position:absolute;top:66%;left:18%;background:#ff4d22;color:white;font:500 16px 'DM Mono',monospace;padding:8px 10px;transform:rotate(-3deg)}.price span{font-size:11px;text-decoration:line-through;margin-right:4px;opacity:.7}.caption{max-width:410px;margin:10px auto 0;font-size:12px;line-height:1.6;color:#696964}.panel{padding-top:14px}.eyebrow{font:500 10px 'DM Mono',monospace;letter-spacing:1.35px;color:#fa4821;margin-bottom:16px}.panel h1,.success h1{font-size:48px;line-height:1.08;letter-spacing:-2.8px;margin:0 0 36px;font-weight:800}fieldset{padding:0;border:0;margin:0 0 28px}legend{font-size:12px;font-weight:700;margin-bottom:10px}.choices{display:grid;gap:8px}.fit{grid-template-columns:1fr 1fr}.choices label{cursor:pointer;border:1px solid #d5d5cf;padding:13px 14px;min-height:67px;transition:.2s;background:#fafaf7;font-size:14px}.choices label.active{border-color:#111;background:#111;color:white}.choices input{position:absolute;opacity:0}.choices b{display:block;font-size:14px}.choices small{font-size:10px;opacity:.65;display:block;margin-top:4px}.sizes{grid-template-columns:repeat(4,1fr)}.sizes label{min-height:45px;text-align:center;padding:12px}.email{font-size:12px;font-weight:700;display:block;margin:28px 0 14px}.email input{display:block;width:100%;border:0;border-bottom:1px solid #999;background:transparent;padding:10px 0 9px;font:400 15px Manrope;outline:none}.email input:focus{border-color:#ff4d22}button,.again{cursor:pointer;display:block;border:0;width:100%;background:#ff4d22;color:white;padding:17px;font:700 14px Manrope;text-decoration:none;transition:.2s}button:hover,.again:hover{background:#de3716}button:disabled{opacity:.6;cursor:wait}button span{float:right;font-size:20px;line-height:12px}.fine{font-size:10px;line-height:1.5;color:#73736e;text-align:center;margin:12px 0}.selection{text-align:center;font:400 10px 'DM Mono',monospace;color:#73736e}.error{color:#c72f16;font-size:12px;margin:10px 0}footer{display:flex;justify-content:space-between;border-top:1px solid #d7d7d1;padding-top:20px;font:400 10px 'DM Mono',monospace;color:#777}.success{padding-top:38px}.success-card{max-width:610px;margin:14vh auto;text-align:center}.success-card h1{font-size:52px;margin:15px 0 20px}.success-card>p:not(.fine){font-size:16px;line-height:1.6}.check{width:48px;height:48px;border-radius:50%;background:#ff4d22;color:white;margin:auto;font-size:28px;line-height:48px}.again{margin:30px auto;width:max-content;padding:15px 24px}@media(max-width:760px){main{padding:24px 20px}header{grid-template-columns:1fr}.now{display:none}.shop{display:block;padding:36px 0}.product{margin-bottom:42px}.panel h1{font-size:42px}.shop .shirt{max-height:440px}.success-card{margin:18vh auto}.success-card h1{font-size:40px}footer{gap:8px;flex-direction:column}}
