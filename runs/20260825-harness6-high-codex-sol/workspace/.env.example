# Stripe sandbox/test-mode secret or restricted key.
STRIPE_SECRET_KEY=rk_test_or_sk_test_here
# Signing secret from the Stripe webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_here
# Prodigi sandbox key for non-production testing.
PRODIGI_API_KEY=your_sandbox_key
PRODIGI_API_BASE=https://api.sandbox.prodigi.com/v4.0
# A long, random secret used to sign public artwork URLs.
ARTWORK_SIGNING_SECRET=replace_with_a_long_random_value
