2/src/Shirt.js\nimport React from 'react';\n// import moment from 'moment';\nimport {Label, Glyphicon} from 'react-bootstrap';\n\nimport './Shirt.css';\n\nexport default class extends React.Component {\n  static propTypes = {\n    shirtStyle: React.PropTypes.oneOf(['fitted', 'unisex']).isRequired,\n    disabled: React.PropTypes.bool,\n  }\n\n  componentDidMount() {\n    const canvas = document.createElement('canvas');\n    canvas.style.width = '30%';\n    canvas.style.height = 'auto';\n    const ctx = canvas.getContext('2d');\n    ctx.font = \"37px 'Chivo'\";\n    ctx.textBaseline = 'top';\n    ctx.fillStyle = 'white';\n    ctx.fillText(new Date().getTime() + '', 0, 0);\n    document.querySelector('.Shirt-time-d').appendChild(canvas);\n\n    const cb = () => {\n      window.requestAnimationFrame(() => {\n        if (!this.props.disabled) {\n          ctx.clearRect(0, 0, canvas.width, canvas.height);\n          ctx.fillText(new Date().getTime() + '', 0, 0);\n        }\n        cb();\n      });\n    }\n    cb();\n  }\n\n  renderMs() {\n    const ms = new Date().getMilliseconds().toString();\n    return Array(3 - ms.length + 1).join('0') + ms;\n  }\n  renderTime() {\n    return (\n      <div className=\"Shirt-time\">\n        <div className=\"Shirt-time-d\" />\n      </div>\n    );\n    /*\n    return (\n      <div className=\"Shirt-time\">\n        <div className=\"Shirt-time-d\">\n          {moment().format('ll')}\n        </div>\n        <div className=\"Shirt-time-s\">\n          {moment().format('HH:mm:ss')}\n        </div>\n        <div className=\"Shirt-time-ms\">\n          {this.renderMs()}\n        </div>\n      </div>\n    );\n    */\n  }\n  renderPath() {\n    if (this.props.shirtStyle === 'fitted') {\n      return (\n        <path xmlns=\"http://www.w3.org/2000/svg\" fillRule=\"evenodd\" clipRule=\"evenodd\" d=\"M79.312,15.149c-1.629-1.631-16.117-6.146-16.117-6.146s-4.31,8.721-11.66,8.721s-11.66-8.721-11.66-8.721   s-15.354,4.936-16.486,6.068c-1.13,1.13-13