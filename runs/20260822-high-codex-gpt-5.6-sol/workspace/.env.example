# Retrieve a restricted test key with `stripe config --list` or from the Stripe Dashboard.
STRIPE_SECRET_KEY=sk_test_...
# Created after deployment with `stripe webhook_endpoints create`.
STRIPE_WEBHOOK_SECRET=whsec_...
# Scalable Press test API key; used as the Basic Auth password.
SP_AUTH=...
# "enabled" submits test orders. Any other value stops safely after a valid quote.
SCALABLE_PRESS_ORDERING=quote-only
