{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -lc \"pwd && rg --files -g '\"'!node_modules'\"' -g '\"'!dist'\"' -g '\"'!build'\"' | head -100 && printf '\\\\nENV\\\\n' && env | rg '\"'^(BENCHMARK_VERCEL_PROJECT|PRODIGI_API_KEY|STRIPE|VERCEL|NEXT_PUBLIC)'\"' | sed 's/=.*\"'$/=<set>/'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
