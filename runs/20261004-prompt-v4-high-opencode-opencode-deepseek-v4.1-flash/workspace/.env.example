# Aster — custom night sky storefront
# Copy to .env.local for local development. Never commit real values.

# Stripe (test mode works end to end). Use a restricted test key.
STRIPE_SECRET_KEY=sk_test_xxx
# From the webhook endpoint that points at /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Prodigi Print API. Sandbox base URL is the default.
PRODIGI_API_KEY=REDACTED_BUILD_PLACEHOLDER
# PRODIGI_API_URL=https://api.sandbox.prodigi.com/v4.0

# Optional. If unset the app derives its origin from VERCEL_PROJECT_PRODUCTION_URL.
# SITE_URL=https://your-store.example
