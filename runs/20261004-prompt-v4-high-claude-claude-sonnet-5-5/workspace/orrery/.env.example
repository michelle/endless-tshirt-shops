# Required
PRODIGI_API_KEY=
PRODIGI_BASE_URL=https://api.sandbox.prodigi.com/v4.0   # production: https://api.prodigi.com/v4.0
BASE_URL=https://your-store.example.com                  # public URL; Prodigi downloads print files from here
ADMIN_TOKEN=change-me-long-random                        # password for /admin (Basic auth, any username)

# Payments: real money via Stripe Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                                   # whsec_... for endpoint BASE_URL/api/stripe/webhook

# Payments: sandbox-only demo (no money). Cannot be combined with STRIPE_SECRET_KEY,
# and the server refuses to start with it unless PRODIGI_BASE_URL is the sandbox.
# DEMO_PAYMENTS=1

# Optional
PORT=8787
DATA_DIR=./data            # SQLite db + cached print files; must be on a persistent disk
SHIPPING_METHOD=Standard
TRUST_PROXY=1              # set when behind a reverse proxy / platform load balancer
NODE_ENV=production
