# Stripe test or live secret key. The browser never receives this value.
STRIPE_SECRET_KEY=sk_test_...
# Create a Stripe webhook for /api/webhooks/stripe and subscribe to
# checkout.session.completed before enabling real fulfillment.
STRIPE_WEBHOOK_SECRET=whsec_...
# Scalable Press API key. Set SP_FULFILLMENT_MODE=sandbox to submit API orders.
SP_AUTH=...
# dry_run (safe default), sandbox, or live
SP_FULFILLMENT_MODE=dry_run
