# Stripe (test keys from the sandbox while developing; live keys for production)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Signing secret of the webhook endpoint that points at /api/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Prodigi Print API. Sandbox base URL for testing; https://api.prodigi.com/v4.0 for live orders.
PRODIGI_API_KEY=...
PRODIGI_API_BASE=https://api.sandbox.prodigi.com/v4.0

# Random 32+ char secret used to sign artwork URLs so only we can mint them
ART_SIGNING_SECRET=change-me-to-a-long-random-string

# Optional. Public origin; derived from the request host when empty.
PUBLIC_BASE_URL=
# Optional pricing (USD cents)
PRICE_CENTS=3600
SHIPPING_CENTS=795
