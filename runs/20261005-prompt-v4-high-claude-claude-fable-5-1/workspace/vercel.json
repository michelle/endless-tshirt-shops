{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/art.js": {
      "maxDuration": 30
    },
    "api/stripe-webhook.js": {
      "maxDuration": 30
    },
    "api/order-status.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/art/:d/:sig.png",
      "destination": "/api/art?d=:d&sig=:sig"
    }
  ],
  "headers": [
    {
      "source": "/lib/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}