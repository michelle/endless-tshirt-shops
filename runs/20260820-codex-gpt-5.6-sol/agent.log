index 0000000000000000000000000000000000000000..0590007248fc34085e5b95e5532dcac96aa6d182
--- /dev/null
+++ b/package.json
@@ -0,0 +1,26 @@
+{
+  "name": "datetime-store",
+  "version": "1.0.0",
+  "type": "module",
+  "private": true,
+  "scripts": {
+    "dev": "next dev",
+    "build": "next build",
+    "start": "next start",
+    "lint": "eslint .",
+    "test": "node --test tests/*.test.mjs"
+  },
+  "dependencies": {
+    "@stripe/stripe-js": "^7.9.0",
