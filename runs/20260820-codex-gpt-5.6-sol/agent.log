+@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@1,6..72,500&display=swap');
+
+:root{--ink:#17181a;--muted:#6f716f;--paper:#f3f0e8;--accent:#ff5b3d;--line:#d9d5ca}*{box-sizing:border-box}html{background:var(--paper);color:var(--ink)}body{margin:0;font-family:Manrope,Arial,sans-serif}button{font:inherit}main{min-height:100vh}nav{height:82px;display:flex;align-items:center;justify-content:space-between;max-width:1240px;margin:auto;padding:0 30px;border-bottom:1px solid var(--line)}.wordmark{font-weight:700;font-size:21px;color:var(--ink);text-decoration:none;letter-spacing:-.8px}.wordmark span{color:var(--accent)}.nav-note{font:10px DM Mono,monospace;text-transform:uppercase;letter-spacing:1.1px;color:var(--muted)}.nav-note i{display:inline-block;width:7px;height:7px;background:#56a46b;border-radius:50%;margin-right:7px;box-shadow:0 0 0 4px #56a46b18}.hero{max-width:1240px;margin:auto;display:grid;grid-template-columns:minmax(0,1.12fr) minmax(390px,.88fr);min-height:720px}.visual{display:grid;place-items:center;min-width:0;border-right:1px solid var(--line);overflow:hidden}.shirt-stage{position:relative;width:min(650px,100%);height:650px;display:grid;place-items:center}.shirt{width:80%;height:88%;position:relative;z-index:2;transition:all .4s ease}.shirt.fitted{width:77%}.orbit{position:absolute;border:1px solid #c9c5b9;border-radius:50%}.orbit-one{width:570px;height:570px}.orbit-two{width:420px;height:420px;border-style:dashed;animation:spin 70s linear infinite}.price-tag{position:absolute;z-index:3;right:6%;bottom:17%;background:var(--accent);color:#fff;width:112px;height:112px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;transform:rotate(8deg);box-shadow:0 12px 30px #a32e1e3d}.price-tag span{text-decoration:line-through;font-size:12px;opacity:.7}.price-tag strong{font-size:23px;letter-spacing:-1px}.price-tag small{font:8px DM Mono;letter-spacing:1px}.buy-panel{padding:65px 60px 45px;align-self:center}.eyebrow,legend{font:500 10px DM Mono,monospace;letter-spacing:1.6px;text-transform:uppercase}.eyebrow{color:var(--accent);margin-bottom:18px}.buy-panel h1{font-size:65px;line-height:.95;letter-spacing:-4px;margin:0 0 25px;font-weight:600}.buy-panel h1 em{font-family:Newsreader,Georgia,serif;font-weight:500}.lede{font-size:15px;line-height:1.7;color:var(--muted);max-width:480px;margin:0 0 32px}fieldset{border:0;padding:0;margin:0 0 25px}legend{margin-bottom:11px}.option-grid{display:grid;gap:9px}.fit-grid{grid-template-columns:1fr 1fr}.option-grid button{background:transparent;border:1px solid var(--line);border-radius:3px;color:var(--ink);cursor:pointer;transition:.15s}.fit-grid button{padding:14px 15px;text-align:left;display:flex;flex-direction:column}.fit-grid b{font-size:13px}.fit-grid small{font-size:10px;color:var(--muted);margin-top:3px}.option-grid button:hover{border-color:#999}.option-grid button.selected{border-color:var(--ink);box-shadow:inset 0 0 0 1px var(--ink);background:#fff9}.size-grid{grid-template-columns:repeat(4,1fr)}.size-grid button{height:45px;font:500 12px DM Mono}.checkout{width:100%;border:0;background:var(--ink);color:#fff;height:62px;padding:0 21px;display:flex;align-items:center;justify-content:space-between;font-weight:600;cursor:pointer;border-radius:3px;transition:.2s}.checkout:hover{background:var(--accent);transform:translateY(-1px)}.checkout:disabled{opacity:.7;cursor:wait}.checkout span{font:12px DM Mono}.trust{display:flex;justify-content:space-between;margin-top:15px;color:var(--muted);font:9px DM Mono;letter-spacing:.1px}.error{color:#b82e1e;font-size:12px;background:#fff0ed;padding:10px 12px;border-left:3px solid var(--accent)}.spinner{width:16px;height:16px;border:2px solid #fff5;border-top-color:#fff;border-radius:50%;animation:spin .8s linear infinite}footer{border-top:1px solid var(--line);max-width:1240px;margin:auto;padding:27px 30px;display:flex;justify-content:space-between;font:10px DM Mono;color:var(--muted);text-transform:uppercase;letter-spacing:.6px}footer a{color:inherit}@keyframes spin{to{transform:rotate(360deg)}}
+@media(max-width:900px){nav{height:70px}.hero{grid-template-columns:1fr}.visual{border-right:0;border-bottom:1px solid var(--line)}.shirt-stage{height:510px}.shirt{height:92%;width:72%}.orbit-one{width:440px;height:440px}.orbit-two{width:330px;height:330px}.buy-panel{padding:50px 30px}.buy-panel h1{font-size:56px}.price-tag{right:16%;bottom:10%;width:96px;height:96px}.trust{gap:8px;flex-wrap:wrap}}@media(max-width:520px){nav{padding:0 18px}.nav-note{display:none}.shirt-stage{height:410px}.shirt,.shirt.fitted{width:92%;height:95%}.orbit-one{width:360px;height:360px}.orbit-two{width:280px;height:280px}.price-tag{right:5%;bottom:7%;width:84px;height:84px}.price-tag strong{font-size:19px}.buy-panel{padding:42px 20px}.buy-panel h1{font-size:48px;letter-spacing:-3px}.fit-grid{grid-template-columns:1fr}.trust{justify-content:flex-start}footer{padding:22px 20px;display:block;line-height:1.6}}
+.success-page{min-height:100vh;display:grid;place-items:center;padding:30px;position:relative}.success-page>.wordmark{position:absolute;top:30px;left:35px}.success-card{width:min(570px,100%);text-align:center;background:#faf8f2;border:1px solid var(--line);padding:65px 55px;box-shadow:0 24px 80px #34312612}.success-card h1{font:500 52px/1 Newsreader,Georgia,serif;margin:12px 0 20px}.success-card p{color:var(--muted);font-size:14px;line-height:1.7}.success-mark{width:64px;height:64px;margin:0 auto 25px;border-radius:50%;display:grid;place-items:center;background:#dff1e1;color:#378a4b;font-size:28px}.success-mark.working{animation:pulse 1.4s infinite}.success-mark.error-mark{background:#ffe4df;color:var(--accent)}.order-ref{margin:30px auto;padding:15px;background:var(--paper);font:9px DM Mono;letter-spacing:1.5px}.order-ref strong{font-size:13px;letter-spacing:.4px}.back-link{display:inline-block;margin-top:22px;color:var(--ink);font:11px DM Mono;text-transform:uppercase}.success-card a{color:var(--ink)}@keyframes pulse{50%{transform:scale(.92);opacity:.6}}
