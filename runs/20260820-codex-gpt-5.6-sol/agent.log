diff --git a/tests/e2e-checkout.mjs b/tests/e2e-checkout.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..83912ab300cceb23e717ce439f09397812b0f908
--- /dev/null
+++ b/tests/e2e-checkout.mjs
@@ -0,0 +1,32 @@
+import { chromium } from 'playwright';
+
+const browser = await chromium.launch({ headless: true, channel: 'chrome' });
+const page = await browser.newPage({ viewport: { width: 1280, height: 900 } });
+try {
