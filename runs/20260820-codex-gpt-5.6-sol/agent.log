@@ -0,0 +1,26 @@
+{
+  "name": "datetime-store",
+  "version": "1.0.0",
+  "type": "module",
+  "private": true,
+  "scripts": {
+    "dev": "next dev",
+    "build": "next build",
+    "start": "next start",
+    "lint": "eslint .",
+    "test": "node --test tests/*.test.mjs"
+  },
+  "dependencies": {
+    "@stripe/stripe-js": "^7.9.0",
+    "next": "^16.3.1",
+    "react": "^19.1.1",
+    "react-dom": "^19.1.1",
+    "sharp": "^0.35.3",
+    "stripe": "^18.5.0"
+  },
