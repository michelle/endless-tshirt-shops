index 0000000000000000000000000000000000000000..b896e847545ad5342a1ae693e757fc8d25cb571d
--- /dev/null
+++ b/package.json
@@ -0,0 +1,28 @@
+{
+  "name": "datetime-store",
+  "version": "1.0.0",
+  "type": "module",
+  "private": true,
+  "scripts": {
+    "dev": "next dev",
+    "build": "next build",
+    "start": "next start",
+    "lint": "eslint .",
+    "test": "node --test tests/*.test.mjs",
+    "test:e2e": "node tests/e2e-checkout.mjs"
+  },
+  "dependencies": {
+    "@stripe/stripe-js": "^7.9.0",
+    "next": "^16.3.1",
+    "react": "^19.1.1",
+    "react-dom": "^19.1.1",
+    "sharp": "^0.35.3",
