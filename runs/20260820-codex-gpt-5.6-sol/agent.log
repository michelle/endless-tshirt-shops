}.eyebrow{color:var(--accent);margin-bottom:18px}.buy-panel h1{font-size:65px;line-height:.95;letter-spacing:-4px;margin:0 0 25px;font-weight:600}.buy-panel h1 em{font-family:Newsreader,Georgia,serif;font-weight:500}.lede{font-size:15px;line-height:1.7;color:var(--muted);max-width:480px;margin:0 0 32px}fieldset{border:0;padding:0;margin:0 0 25px}legend{margin-bottom:11px}.option-grid{display:grid;gap:9px}.fit-grid{grid-template-columns:1fr 1fr}.option-grid button{background:transparent;border:1px solid var(--line);border-radius:3px;color:var(--ink);cursor:pointer;transition:.15s}.fit-grid button{padding:14px 15px;text-align:left;display:flex;flex-direction:column}.fit-grid b{font-size:13px}.fit-grid small{font-size:10px;color:var(--muted);margin-top:3px}.option-grid button:hover{border-color:#999}.option-grid button.selected{border-color:var(--ink);box-shadow:inset 0 0 0 1px var(--ink);background:#fff9}.size-grid{grid-template-columns:repeat(4,1fr)}.size-grid button{height:45px;font:500 12px DM Mono}.checkout{width:100%;border:0;background:var(--ink);color:#fff;height:62px;padding:0 21px;display:flex;align-items:center;justify-content:space-between;font-weight:600;cursor:pointer;border-radius:3px;transition:.2s}.checkout:hover{background:var(--accent);transform:translateY(-1px)}.checkout:disabled{opacity:.7;cursor:wait}.checkout span{font:12px DM Mono}.trust{display:flex;justify-content:space-between;margin-top:15px;color:var(--muted);font:9px DM Mono;letter-spacing:.1px}.error{color:#b82e1e;font-size:12px;background:#fff0ed;padding:10px 12px;border-left:3px solid var(--accent)}.spinner{width:16px;height:16px;border:2px solid #fff5;border-top-color:#fff;border-radius:50%;animation:spin .8s linear infinite}footer{border-top:1px solid var(--line);max-width:1240px;margin:auto;padding:27px 30px;display:flex;justify-content:space-between;font:10px DM Mono;color:var(--muted);text-transform:uppercase;letter-spacing:.6px}footer a{color:inherit}@keyframes spin{to{transform:rotate(360deg)}}
