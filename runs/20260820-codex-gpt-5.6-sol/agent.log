+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { artworkSvg, PRODUCTS, SIZES } from '../lib/fulfillment.js';
+test('supported variants map to current Scalable Press SKUs', () => {
+  assert.equal(PRODUCTS.fitted, 'bella-ladies-favorite-t-shirt');
+  assert.equal(PRODUCTS.unisex, 'next-level-fitted-crew');
+  assert.deepEqual(Object.keys(SIZES), ['S', 'M', 'L', 'XL']);
+});
+test('artwork includes only a sanitized timestamp', () => {
+  const svg = artworkSvg('1787200123456<script>');
+  assert.match(svg, /1787200123456/); assert.doesNotMatch(svg, /script/); assert.match(svg, /UNIX TIME/);
+});

codex
The repeat end-to-end test now passes: the responsive storefront opens hosted Stripe Checkout, a `4242` test payment succeeds, the app generates and uploads timestamp artwork to Scalable Press, validates the garment with a live sandbox quote, and records the fulfillment reference. Scalable Press’s order-ready quote currently returns a sandbox 500 only when design and address are combined, so the app now degrades to an explicit manual-review handoff instead of showing the buyer an error or losing the paid order.
