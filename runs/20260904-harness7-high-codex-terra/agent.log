": [],\n    \"recipient\": {\n      \"name\": \"Sandbox Recipient\",\n      \"email\": null,\n      \"phoneNumber\": null,\n      \"address\": {\n        \"line1\": \"100 Market Street\",\n        \"line2\": null,\n        \"postalOrZipCode\": \"94105\",\n        \"countryCode\": \"US\",\n        \"townOrCity\": \"San Francisco\",\n        \"stateOrCounty\": \"CA\"\n      }\n    },\n    \"items\": [\n      {\n        \"id\": \"ori_1626978\",\n        \"status\": \"NotYetDownloaded\",\n        \"merchantReference\": null,\n        \"sku\": \"GLOBAL-TEE-GIL-64000\",\n        \"copies\": 1,\n        \"sizing\": \"fillPrintArea\",\n        \"thumbnailUrl\": null,\n        \"attributes\": {\n          \"color\": \"black\",\n          \"size\": \"m\"\n        },\n        \"spine\": null,\n        \"assets\": [\n          {\n            \"id\": \"ast_573553\",\n            \"omsId\": null,\n            \"printArea\": \"front\",\n            \"md5Hash\": null,\n            \"url\": \"https://www.prodigi.com/sample-media/ProdigiTestImage.png\",\n            \"thumbnailUrl\": null,\n            \"pageCount\": null,\n            \"status\": \"InProgress\"\n          }\n        ],\n        \"recipientCost\": null,\n        \"correlationIdentifier\": \"71755502128224768\"\n      }\n    ],\n    \"packingSlip\": null,\n    \"branding\": {},\n    \"metadata\": null\n  },\n  \"traceParent\": \"00-cd78ad61d1f3e107f8af597f1cf17a71-7bab00147f69fb88-00\"\n}\n","exit_code":0,"status":"completed"}}
