# Stripe test/live secret key. Never expose this to the browser.
STRIPE_SECRET_KEY=sk_test_...
# Stripe webhook signing secret for /api/stripe-webhook.
STRIPE_WEBHOOK_SECRET=whsec_...
# Prodigi sandbox key for preview; use a live key only after launch checks.
PRODIGI_API_KEY=...
# sandbox (default) or live
PRODIGI_ENV=sandbox
