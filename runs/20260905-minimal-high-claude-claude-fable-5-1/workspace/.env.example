# Stripe (test mode). Get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Signing secret for the /api/webhooks/stripe endpoint (optional locally, required in prod)
STRIPE_WEBHOOK_SECRET=whsec_...

# Prodigi Print API. Sandbox: https://api.sandbox.prodigi.com/v4.0, live: https://api.prodigi.com/v4.0
PRODIGI_API_KEY=...
PRODIGI_API_BASE=https://api.sandbox.prodigi.com/v4.0

# Public origin used to build artwork URLs Prodigi downloads. Falls back to VERCEL_PROJECT_PRODUCTION_URL.
# SITE_URL=https://datetime.store
