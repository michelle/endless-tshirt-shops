+@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Libre+Franklin:wght@400;500;600&display=swap');
+:root{--ink:#111;--blue:#a4d5ff;--soft:#f5f5f3}*{box-sizing:border-box}body{margin:0;color:var(--ink);font-family:"Libre Franklin",Arial,sans-serif;background:#fff}main{max-width:1180px;margin:auto;padding:42px 40px 28px}header{border-bottom:1px solid #ddd;padding-bottom:22px;margin-bottom:42px}.wordmark{font:500 31px/1 "DM Mono",monospace;text-decoration:none;color:inherit;letter-spacing:-1.8px}header p{font-size:16px;color:#1776bb;margin:10px 0 0}.product{display:grid;grid-template-columns:minmax(360px,1.2fr) minmax(300px,.8fr);gap:9vw;align-items:start}.visual{min-width:0}.shirt-wrap{position:relative;max-width:610px;margin:0 auto}.shirt-wrap svg{display:block;width:100%;height:auto}.shirt-wrap path{fill:#111}.timestamp{position:absolute;z-index:1;top:20.5%;left:0;width:100%;text-align:center;color:white;font:500 clamp(13px,2.5vw,31px)/1 "DM Mono",monospace;letter-spacing:-1px}.price{position:absolute;top:70%;left:12%;background:#1877b9;color:white;border-radius:3px;padding:6px 9px;font-size:18px;font-weight:500}.caption{font-size:13px;line-height:1.5;color:#666;margin:8px 0 0;text-align:center}.order{padding-top:10px}fieldset{border:0;margin:0 0 26px;padding:0}legend{font-size:13px;font-weight:600;margin-bottom:10px}.options{display:grid;gap:2px}.two{grid-template-columns:1fr 1fr}.four{grid-template-columns:repeat(4,1fr)}.options label{cursor:pointer}.options input{position:absolute;opacity:0}.options span{display:block;text-align:center;padding:13px 6px;background:var(--blue);font-size:15px;transition:.15s}.options input:checked+span{background:var(--ink);color:white}.options label:hover span{opacity:.82}.summary{border-top:1px solid #ddd;border-bottom:1px solid #ddd;padding:16px 0;display:flex;justify-content:space-between;font-size:14px}.summary strong{font-size:16px}button,.again{display:flex;justify-content:center;align-items:center;gap:12px;width:100%;border:0;background:#111;color:#fff;padding:16px;margin-top:22px;font:500 16px "Libre Franklin",sans-serif;cursor:pointer;text-decoration:none;transition:background .15s}button:hover,.again:hover{background:#1877b9}button:disabled{opacity:.6;cursor:wait}.fineprint{font-size:12px;line-height:1.5;color:#777;text-align:center;margin:15px 10px}.error{font-size:13px;color:#be123c;margin:0 0 12px}.success-page{max-width:760px}.success-page section{text-align:center;padding:55px 20px}.success-page h1{font-size:27px;font-weight:500;margin:17px 0 12px}.success-page section p{color:#555;line-height:1.6;max-width:520px;margin:0 auto}.check{height:52px;width:52px;border-radius:50%;background:#111;color:#fff;font-size:30px;line-height:52px;margin:auto}.again{max-width:260px;margin:28px auto 0}@media(max-width:760px){main{padding:25px 20px}header{margin-bottom:28px}.wordmark{font-size:26px}.product{grid-template-columns:1fr;gap:28px}.shirt-wrap{max-width:480px}.order{max-width:500px;margin:auto;width:100%}}
