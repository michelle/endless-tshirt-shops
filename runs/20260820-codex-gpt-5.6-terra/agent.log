f;cursor:pointer;text-decoration:none;transition:background .15s}button:hover,.again:hover{background:#1877b9}button:disabled{opacity:.6;cursor:wait}.fineprint{font-size:12px;line-height:1.5;color:#777;text-align:center;margin:15px 10px}.error{font-size:13px;color:#be123c;margin:0 0 12px}.success-page{max-width:760px}.success-page section{text-align:center;padding:55px 20px}.success-page h1{font-size:27px;font-weight:500;margin:17px 0 12px}.success-page section p{color:#555;line-height:1.6;max-width:520px;margin:0 auto}.check{height:52px;width:52px;border-radius:50%;background:#111;color:#fff;font-size:30px;line-height:52px;margin:auto}.again{max-width:260px;margin:28px auto 0}@media(max-width:760px){main{padding:25px 20px}header{margin-bottom:28px}.wordmark{font-size:26px}.product{grid-template-columns:1fr;gap:28px}.shirt-wrap{max-width:480px}.order{max-width:500px;margin:auto;width:100%}}
