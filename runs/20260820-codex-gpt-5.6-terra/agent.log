import React from 'react';
import {FormGroup, FormControl, HelpBlock, ControlLabel, Radio, Button, Glyphicon} from 'react-bootstrap';
import CheckoutForm from './CheckoutForm';
import './Checkout.css';

const STRIPE_KEY = process.env.NODE_ENV === 'production' ? '[REDACTED_STRIPE_KEY]' : '[REDACTED_STRIPE_KEY]';
const API_URL = process.env.NODE_ENV === 'production' ? '/order' : 'http://localhost:3002/order';

export default class extends React.Component {
  static propTypes = {
    onStyleChange: React.PropTypes.func.isRequired,
    onCheckout: React.PropTypes.func.isRequired,
    onComplete: React.PropTypes.func.isRequired,
  }

  constructor(props) {
    super(props);
    this.state = {
      disabled: false,
      orderId: null,
      orderErrors: [],
    };
    this.setupStripe();
  }
  setupStripe() {
    this._stripe = Stripe(STRIPE_KEY); // eslint-disable-line
    this._cardField = this._stripe.elements().create('card', {
      classes: {
        empty: 'is-empty',
        focus: 'is-focused',
        invalid: 'is-invalid',
      },
      style: {
        base: {
          lineHeight: '28px',
          placeholderColor: '#ccc',
          fontSize: '16px',
          fontWeight: 400,
          fontSmoothing: 'antialiased',
          fontFamily: 'Helvetica Neue, Helvetica, sans-serif',
        },
      },
    });
    this._cardField.on('change', (payload) => {
      this.setState({error: payload.error});
    });
  }

  handleSubmit = (data) => {
    this.setState({disabled: true});
    this.props.onCheckout();
    this._stripe.createToken(this._cardField).then(({token, error}) => {
      if (token) {
        return fetch(API_URL, {
          method: 'POST',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({...data, stripeToken: token.id}),
        });
      } else {
        throw error;
      }
    }).then((res) => {
      // TODO
      return res.json();
    }).then((payload) => {
      this.setState({disabled: false, orderId: payload.order, error: payload.error, orderErrors: payload.issues || payload.orderIssues || []});
    }).catch((err) => {
      // TODO
      console.log('got error', err);
      this.setState({disabled: false});
      this.props.onComplete();
    });
  }
  handleReset = () => {
    this.setState({orderId: null});
    this.props.onComplete();
  }
  renderForm() {
    const {disabled, error, orderErrors} = this.state;
    return <CheckoutForm onStyleChange={this.props.onStyleChange} onSubmit={this.handleSubmit} cardElement={this._cardField} disabled={disabled} error={error} orderErrors={orderErrors} />;
  }
  renderSuccess() {
    return (
      <div className="Checkout-success">
        <p className="Checkout-success-title">
          Congrats on your pretty cool shirt!
        </p>
        <p>
          You should receive an email shortly with your order confirmation number.
        </p>
        <button onClick={this.handleReset}>
          <Glyphicon glyph="heart" />{' '}
          Get another shirt
        </button>
      </div>
    );
  }
  render() {
    const {orderId} = this.state;
    if (orderId) {
      return this.renderSuccess();
    } else {
      return this.renderForm();
    }
  }
};
const express = require('express');
const path = require('path');
const request = require('request');
const bodyParser = require('body-parser');
const PassThrough = require('stream').PassThrough;

const app = express();

app.use(bodyParser.json({limit: '5mb'}));

const SP_API = 'https://api.scalablepress.com/v2/';
const SP_AUTH = process.env.SP_AUTH;
const STRIPE_AUTH = process.env.STRIPE_AUTH;

if (!SP_AUTH || !STRIPE_AUTH) {
  throw new Error('SP_AUTH and STRIPE_AUTH must be configured before starting the checkout server.');
}

const stripe = require('stripe')(STRIPE_AUTH);

// {
//   shirt: {
//     size:,
//     style:,
//     artwork:,
//   },
//   stripeToken: ...,
//   address: {
//     street1:,
//     street2:,
//     city:
//     zipcode:,
//   }
// }

const PRODUCTS = {
  fitted: 'bella-ladies-favorite-t-shirt',
  unisex: 'next-level-fitted-crew', // 16.94
  //unisex: 'american-apparel-t-shirt',
  //unisex: 'american-apparel-50-50-t-shirt',
  //unisex: 'next-level-cvc-crew', // 17.16
  //unisex: 'canvas-v-neck-t-shirt', // 17.46
  //unisex: 'canvas-unisex-t-shirt', // 16.81
  //unisex: 'alternative-apparel-basic-crew-t-shirt', //18.36
};
const SIZES = {
  S: 'sml',
  M: 'med',
  L: 'lrg',
  XL: 'xlg',
};

app.use(function(req, res, next) {
  res.header("Access-Control-Allow-Origin", "*");
  res.header("Access-Control-Allow-Headers", "Origin, X-Requested-With, Content-Type, Accept");
  next();
});

const auth = {
  user: '',
  password: SP_AUTH,
};

function scalablePressError(operation, err, response) {
  if (err) {
    return err;
  }

  const body = response && response.body;
  if (!response || !body || response.statusCode >= 300 || body.statusCode >= 300) {
    const error = new Error(`${operation} failed`);
    error.clientMessage = (body && body.message) || `${operation} could not be completed by Scalable Press.`;
    error.issues = body && (body.issues || body.orderIssues);
    return error;
  }

  return null;
}

function missingScalablePressValue(operation, valueName) {
  const error = new Error(`${operation} returned no ${valueName}`);
  error.clientMessage = `${operation} returned an incomplete response from Scalable Press.`;
  return error;
}

app.post('/order', (req, res, next) => {
  res.header('Content-Type', 'application/json');
  const {shirt, address, stripeToken, email} = req.body;

  // CREATE DESIGNID
  const r = request.post({
    url: `${ SP_API }design`,
    auth,
    json: true,
  }, (err, response) => {

    const designError = scalablePressError('Design creation', err, response);
    if (designError) {
      console.log('[Design error]', response && response.body || designError);
      return next(designError);
    } else if (!response.body.designId) {
      return next(missingScalablePressValue('Design creation', 'design ID'));
    } else {

      // CREATE ORDERTOKEN
      request.post({
        url: `${SP_API}quote`,
        auth,
        body: {
          type: 'dtg',
          products: [{
            id: PRODUCTS[shirt.style],
            color: shirt.style === 'fitted' ? 'Black' : 'Black',
            quantity: 1,
            size: SIZES[shirt.size],
          }],
          designId: response.body.designId,
          address,
        },
        json: true,
      }, (err, response) => {

        const quoteError = scalablePressError('Quote creation', err, response);
        if (quoteError || (response.body.orderIssues && response.body.orderIssues.length)) {
          const error = quoteError || new Error('Quote creation returned order issues');
          error.clientMessage = error.clientMessage || 'Scalable Press cannot fulfill this order as requested.';
          error.issues = error.issues || response.body.orderIssues;
          console.log('[Quote error]', response && response.body || error);
          return next(error);
        } else if (!response.body.orderToken) {
          return next(missingScalablePressValue('Quote creation', 'order token'));
        } else {

          // CREATE PAYMENT
          stripe.charges.create({
            amount: 2250,
            currency: 'usd',
            card: stripeToken,
            receipt_email: email,
            description: `A datetime shirt (ID: ${response.body.orderToken})`,
          }, (err, charge) => {

            if (err) {
              console.log('[Stripe error]', err);
              return next({error: {message: err.message, type: err.type, code: err.code}});
            } else {

              // CREATE ORDERID
              request.post({
                url: `${SP_API}order`,
                json: true,
                auth,
                body: {
                  orderToken: response.body.orderToken,
                }
              }, (err, response) => {

                const orderError = scalablePressError('Order submission', err, response);
                if (orderError) {
                  console.log('[Order error]', response && response.body || orderError);
                  return next(orderError);
                } else if (!response.body.orderId) {
                  return next(missingScalablePressValue('Order submission', 'order ID'));
                } else {
                  console.log('ORDER', response.body.orderId);
                  res.json({order: response.body.orderId});
                }
              });
            }
          });

        }
      });
    }
  });

  const artUri = shirt.artwork;
  const artBuffer = new Buffer(artUri.split(',')[1], 'base64');

  const form = r.form();
  form.append('type', 'dtg');
  form.append('sides[front][artwork]', artBuffer, {
    filename: 'artwork.png',
    contentType: 'image/png',
  });
  form.append('sides[front][dimensions][width]', '8'); // inches
  form.append('sides[front][position][horizontal]', 'C');
  form.append('sides[front][position][offset][top]', '3'); // inches
});

app.use('/static', express.static(path.join(__dirname, '../build/static')));
app.get('*', (req, res) => res.sendFile(path.join(__dirname, '../build/index.html')));
app.use((err, req, res, next) => {
  console.error(err.stack || err);
  res.status(err.statusCode || 502).json({
    error: {
      message: err.clientMessage || 'Checkout could not be completed. Contact support if your card was charged.',
    },
    issues: err.issues || [],
  });
});

const server = app.listen(process.env.PORT || 3000, () => {
  console.log(`listening on port ${ server.address().port }`)
});
* {
  font-family: "Helvetica Neue", Helvetica;
  font-size: 16px;
  font-variant: normal;
  padding: 0;
  margin: 0;
}

body {
  -webkit-font-smoothing: antialiased;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100%;
}

label {
  position: relative;
  color: black;
  display: block;
  margin-top: 28px;
  margin-bottom: 18px;
  width: 100%;
}

label > span {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  font-weight: 400;
  line-height: 28px;
  color: black;
  border-bottom: 1px solid #a4d5ff;
  transition: border-bottom-color 200ms ease-in-out;
}

label > span span {
  position: absolute;
  top: 0;
  left: 0;
  transform-origin: 0% 50%;
  transition: transform 200ms ease-in-out;
  cursor: text;
}

label .field:focus + span,
label .field.is-focused + span,
label .field:not(.is-empty) + span {
  color: #337ab7;
  pointer-events: none;
}

label .field:focus + span span,
label .field.is-focused + span span,
label .field:not(.is-empty) + span span {
  transform: scale(0.8) translateY(-28px);
  cursor: default;
}

label .field:focus + span,
label .field.is-focused + span {
  border-bottom-color: #337ab7;
}
label .field.is-invalid + span {
  color: #eb1c26;
  border-bottom-color: #eb1c26;
}

.field {
  background: transparent;
  font-weight: 400;
  border: 0;
  color: black;
  outline: none;
  cursor: text;
  display: block;
  width: 100%;
  line-height: 28px;
  padding-bottom: 3px;
  transition: opacity 200ms ease-in-out;
}

.field::-webkit-input-placeholder { color: #ccc; }
.field::-moz-placeholder { color: #ccc; }

.field.is-empty:not(.is-focused),
.field.is-empty:not(:focus) {
  opacity: 0;
}
.field.is-empty:focus,
.field.is-empty.is-focused {
  opacity: 1;
}

button {
  float: left;
  display: block;
  background: black;
  color: white;
  border: 0;
  margin-top: 15px;
  margin-bottom: 50px;
  font-size: 19px;
  font-weight: 400;
  width: 100%;
  height: 47px;
  line-height: 45px;
  outline: none;
}

button:focus {
  background: #337ab7;
}

button:active {
  background: #337ab7;
}

.styles .radio {
  display: inline-block;
  width: 50%;
  line-height: 28px;
}
.sizes .radio {
  display: inline-block;
  width: 25%;
  line-height: 28px;
}

.styles, .sizes {
  width: 100%;
}

.radio {
  text-align: center;
}
.radio input {
  opacity: 0;
}

.radio input:checked + label {
  background-color: black;
  color: white;
}

.radio label {
  background-color: #a4d5ff;
  width: 100%;
  display: inline-block;
  padding: 8px 14px;;
  margin: 0;
}
button, label {
  transition: opacity 200ms ease-in-out;
}
button:hover, label:hover {
  opacity: 0.8;
}
