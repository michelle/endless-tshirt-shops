# Prodigi Print API sandbox key (https://sandbox-beta-dashboard.pwinty.com)
PRODIGI_API_KEY=

# Stripe — Test mode keys (https://dashboard.stripe.com/test/apikeys)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe CLI endpoint secrets (https://stripe.com/docs/stripe-cli)
# Generated by `stripe listen --forward-to .../api/webhook`
STRIPE_CLI_WEBHOOK_SECRET=

# Public base URL of the deployed site. Used to construct absolute asset URLs.
APP_BASE_URL=http://localhost:3000

# Path Prodigi uses as the directory for print files (default: OS temp).
TEMP_DIR=

# Optional override path for order persistence (default: ./data).
DATA_DIR=
