request (default: test)\n  -s, --show-headers            Show response headers\n      --stripe-account string   Set a header identifying the connected account\n      --stripe-context string   Set a header identifying the compartment\n                                context\n  -v, --stripe-version string   Set the Stripe API version to use for your\n                                request\n\nGlobal flags:\n      --api-key string        Your API key to use for the command\n      --color string          turn on/off color output (on, off, auto)\n      --config string         config file (default is\n                              $HOME/.config/stripe/config.toml)\n      --device-name string    device name\n      --log-level string      log level (debug, info, trace, warn, error)\n                              (default \"info\")\n      --map string[=\"tree\"]   Print a command tree [tree|compact|paths|json]\n  -p, --project-name string   the project name to read from for config\n                              (default \"default\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/zsh -lc \"site_url='https://benchmark-20260904-harness7-high-co-rouge.vercel.app'\ncurl -sS -o /dev/null -w 'site:%{http_code}\\\\n' \\\"\"'$site_url\"\nstripe_key=$(awk -F\"'\"'\\\" '/test_mode_api_key/ {print \"'$2}'\"' \\\"\"'$HOME/.config/stripe/config.toml\")\nvercel env add STRIPE_SECRET_KEY production,preview --value \"$stripe_key\" --yes --sensitive --project \"$BENCHMARK_VERCEL_PROJECT\"\nvercel env add PRODIGI_API_KEY production,preview --value \"$PRODIGI_API_KEY\" --yes --sensitive --project \"$BENCHMARK_VERCEL_PROJECT\"\nvercel env add PRODIGI_API_BASE_URL production,preview --value '\"'https://api.sandbox.prodigi.com/v4.0' --yes --project \\\"\"'$BENCHMARK_VERCEL_PROJECT\"\nvercel env add SITE_URL production,preview --value \"$site_url\" --yes --project \"$BENCHMARK_VERCEL_PROJECT\"\nstripe post /v1/webhook_endpoints --confirm '\"\\\\\n  -d \\\"url=\"'$site_url/api/webhooks/stripe\" '\"\\\\\n  -d 'enabled_events[]=checkout.session.completed' \\\\\n  -d 'enabled_events[]=checkout.session.async_payment_succeeded' \\\\\n  -i \\\"\"'$BENCHMARK_VERCEL_PROJECT-webhook\" > /tmp/datetime-webhook.json\nwebhook_secret=$(jq -r '\"'.secret' /tmp/datetime-webhook.json)\nwebhook_id=\"'$(jq -r '\"'.id' /tmp/datetime-webhook.json)\nif [ -z \\\"\"'$webhook_secret\" ] || [ \"$webhook_secret\" = null ]; then jq '\"'{error,type,message}' /tmp/datetime-webhook.json; exit 1; fi\nvercel env add STRIPE_WEBHOOK_SECRET production,preview --value \\\"\"'$webhook_secret\" --yes --sensitive --project \"$BENCHMARK_VERCEL_PROJECT\"\nprintf '\"'webhook configured: %s\\\\n' \\\"\"'$webhook_id\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
