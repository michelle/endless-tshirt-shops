# Stripe test-mode secret key (sk_test_... or rkcs_test_...)
STRIPE_SECRET_KEY=
# Optional but recommended. Enables signed webhook fulfillment.
STRIPE_WEBHOOK_SECRET=

# Scalable Press test key. Basic-auth password used against API v2.
SP_AUTH=
# true: submit the quoted order. false: stop safely after the quote.
SP_PLACE_ORDERS=false

# Optional canonical URL, e.g. https://datetime.example.com
NEXT_PUBLIC_SITE_URL=
