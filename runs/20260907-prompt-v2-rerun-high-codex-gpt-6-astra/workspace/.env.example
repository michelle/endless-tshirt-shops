# Never commit credentials. All requests are hard-coded to Prodigi SANDBOX.
PRODIGI_API_KEY=your-prodigi-sandbox-key
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ORDER_SECRET=replace-with-a-random-secret-at-least-32-characters
# Must be the public, HTTPS deployment origin, reachable by Prodigi.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
