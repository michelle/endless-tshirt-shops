# Stripe (test mode). Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Signing secret for the /api/webhooks/stripe endpoint.
# Create with: stripe listen --forward-to localhost:3000/api/webhooks/stripe (local)
# or via the Stripe Dashboard / API for a deployed webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...

# Prodigi Print API (sandbox). https://www.prodigi.com/print-api/
PRODIGI_API_KEY=...
PRODIGI_API_BASE_URL=https://api.sandbox.prodigi.com/v4.0

# Public URL of this deployment, used to build Stripe success/cancel URLs
# and the artwork image URL Prodigi fetches. Falls back to the request's
# own origin if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
