r: #fff; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: clamp(13px, 2.05vw, 24px); font-weight: 700; letter-spacing: .02em; }\n.price-tag { position: absolute; z-index: 2; left: 6%; bottom: 12%; padding: 10px 14px; color: #fff; background: var(--blue); font-size: 19px; font-weight: 700; transform: rotate(-2deg); }\n.price-tag s { opacity: .7; font-weight: 400; margin-right: 5px; }\n.caption { color: #716f68; margin: 13px 0 0; font-size: 13px; }\n.eyebrow { margin: 0 0 14px; color: var(--blue); font-size: 12px; font-weight: 800; letter-spacing: .16em; }\n.purchase-panel h1 { margin: 0; max-width: 430px; font-size: clamp(40px, 5vw, 66px); line-height: .96; letter-spacing: -.055em; }\n.intro { margin: 22px 0 34px; max-width: 400px; color: #66635c; font-size: 17px; line-height: 1.55; }\nfieldset { border: 0; margin: 0 0 24px; padding: 0; }\nlegend { margin-bottom: 10px; font-size: 13px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }\n.choice-grid { display: grid; border: 1px solid var(--ink); }\n.choice-grid.two { grid-template-columns: repeat(2, 1fr); }\n.choice-grid.four { grid-template-columns: repeat(4, 1fr); }\n.choice { min-height: 48px; display: grid; place-items: center; border-right: 1px solid var(--ink); cursor: pointer; transition: .16s ease; }\n.choice:last-child { border-right: 0; }\n.choice input { position: absolute; opacity: 0; }\n.choice.active { color: #fff; background: var(--ink); }\n.choice:hover { background: var(--blue-soft); color: var(--ink); }\n.buy-button { width: 100%; min-height: 58px; display: flex; justify-content: space-between; align-items: center; margin-top: 7px; padding: 0 20px; border: 0; color: #fff; background: var(--blue); cursor: pointer; font-weight: 800; transition: transform .16s ease, background .16s ease; }\n.buy-button:hover { background: #1559c8; transform: translateY(-1px); }\n.buy-button:focus-visible, .choice:focus-within { outline: 3px solid #8ab7ff; outl