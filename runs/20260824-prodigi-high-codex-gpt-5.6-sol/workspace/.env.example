# A Stripe sandbox or test-mode restricted secret key.
STRIPE_SECRET_KEY=rk_test_...
# Created after deployment for /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=whsec_...

# Prodigi sandbox credentials. Do not use a live key during development.
PRODIGI_API_KEY=...
PRODIGI_API_BASE=https://api.sandbox.prodigi.com

# Long, random value used to sign public artwork URLs.
ARTWORK_SIGNING_SECRET=replace-with-at-least-32-random-characters
# Canonical deployed origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
NEXT_PUBLIC_STORE_MODE=sandbox

# Optional merchandising controls.
PRODUCT_PRICE_CENTS=2250
STORE_CURRENCY=usd
