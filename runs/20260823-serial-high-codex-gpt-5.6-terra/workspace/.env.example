# Stripe sandbox or test secret key. Never expose this in the browser.
STRIPE_SECRET_KEY=sk_test_replace_me
# Used by /api/stripe-webhook in production. Create with `stripe listen` or Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Scalable Press API key. Keep it server-side.
SP_AUTH=replace_me
# Optional; accepts `true` to exercise the Stripe flow without submitting a print order.
SP_DRY_RUN=false
