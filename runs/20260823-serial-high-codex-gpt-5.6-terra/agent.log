{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '220,520p' /tmp/datetime-store-reference/src/Checkout.js; sed -n '1,320p' /tmp/datetime-store-reference/src/App.css; sed -n '1,360p' /tmp/datetime-store-reference/src/Checkout.css; sed -n '1,260p' /tmp/datetime-store-reference/src/Shirt.css; sed -n '1,220p' /tmp/datetime-store-reference/src/index.css; cat /tmp/datetime-store-reference/package.json\"","aggregated_output":"          Get another shirt\n        </button>\n      </div>\n    );\n  }\n  renderStyles() {\n    return (\n      <div className=\"styles\">\n        {[['fitted', 'Fitted'], ['unisex', 'Unisex']].map(style => (\n          <div className=\"radio\">\n            <input\n              id={style[0]}\n              type=\"radio\"\n              key={style[0]}\n              name=\"style\"\n              value={style[0]}\n              onChange={this.handleChange('style')}\n              checked={this.state.style === style[0]}\n            />\n            <label htmlFor={style[0]}>\n              {style[1]}\n            </label>\n          </div>\n        ))}\n      </div>\n    );\n  }\n  renderSizes() {\n    return (\n      <div className=\"sizes\">\n        {['S', 'M', 'L', 'XL'].map(size => (\n          <div className=\"radio\">\n            <input\n              id={size}\n              type=\"radio\"\n              key={size}\n              name=\"size\"\n              value={size}\n              onChange={this.handleChange('size')}\n              checked={this.state.size === size}\n            />\n            <label htmlFor={size}>\n              {size}\n            </label>\n          </div>\n        ))}\n      </div>\n    );\n  }\n  render() {\n    const {orderId} = this.state;\n    if (orderId) {\n      return this.renderSuccess();\n    } else if (this.state.loading) {\n      // TODO: loading state?\n      return <span />;\n    } else if (this.state.manual) {\n      return (\n        <div>\n          {this.renderStyles()}\n          {this.renderSizes()}\n          {this.renderForm()}\n        </div>\n      );\n    } else {\n      return (\n        <div className=\"Checkout-prapi\">\n          {this.renderStyles()}\n          {this.renderSizes()}\n          <div className=\"Checkout-prapi-button\" ref={this.handlePrapiButton} />\n          <a className=\"Checkout-prapi-switch\" onClick={this.handleSwitchClick}>\n            Or enter details manually\n          </a>\n        </div>\n      );\n    }\n  }\n}\n.form-control.is-focused {\n  border-color: #66afe9;\n  outline: 0;\n  box-shadow: inset 0 1px 1px rgba(0,0,0,.075), 0 0 8px rgba(102, 175, 233, .6);\n}\n\n.page-header h1 {\n  font-weight: 300;\n}\n.page-header h2 {\n  color: #337ab7;\n  font-weight: 400;\n  font-size: 19px;\n  margin: 0;\n  margin-top: 5px;\n  padding: 0;\n}\n\n.page-header small {\n  color: #aaa;\n}\n\n.glyphicon.spinning {\n  animation: spin 1s infinite linear;\n  -webkit-animation: spin2 1s infinite linear;\n}\n\n@keyframes spin {\n  from { transform: scale(1) rotate(0deg);}\n  to { transform: scale(1) rotate(360deg);}\n}\n\n@-webkit-keyframes spin2 {\n  from { -webkit-transform: rotate(0deg);}\n  to { -webkit-transform: rotate(360deg);}\n}\n\n.glyphicon-left {\n  margin-right: 7px;\n}\n\n.Checkout-success, .Checkout-prapi {\n  text-align: center;\n}\n.Checkout-success {\n  font-size: 16px;\n  padding-top: 20%;\n}\n.Checkout-prapi-button {\n  margin-top: 20px;\n}\n.Checkout-prapi-switch{\n  margin-top: 5px;\n  cursor: pointer;\n  font-size: 14px;\n}\n.Checkout-success-title {\n  font-size: 20px;\n  font-weight: 500;\n}\n.Shirt {\n  position: relative;\n  letter-spacing: 0.7px;\n  width: 100%;\n  max-width: 600px;\n}\n\n.Shirt-time {\n  font-family: 'Chivo', sans-serif;\n  position: absolute;\n  top: 20%;\n  color: #fff;\n  font-weight: 500;\n  width: 100%;\n  font-size: 22px;\n  line-height: 1em;\n  margin-left: 10px;\n}\n.Shirt-time-d,\n.Shirt-time-s,\n.Shirt-time-ms {\n  text-align: center;\n  margin: 0 auto;\n}\n.Shirt-time-s {\n  line-height: 1em;\n  font-size: 100%;\n}\n.Shirt-time-ms {\n  line-height: 1.2em;\n  font-size: 10px;\n}\n\n.Shirt-price {\n  position: absolute;\n  top: 70%;\n  left: 10%;\n}\n\n.Shirt-price .label {\n  font-weight: 300 !important;\n}\n* {\n  font-family: \"Helvetica Neue\", Helvetica;\n  font-size: 16px;\n  font-variant: normal;\n  padding: 0;\n  margin: 0;\n}\n\nbody {\n  -webkit-font-smoothing: antialiased;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 100%;\n}\n\nlabel {\n  position: relative;\n  color: black;\n  display: block;\n  margin-top: 28px;\n  margin-bottom: 18px;\n  width: 100%;\n}\n\nlabel > span {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  font-weight: 400;\n  line-height: 28px;\n  color: black;\n  border-bottom: 1px solid #a4d5ff;\n  transition: border-bottom-color 200ms ease-in-out;\n}\n\nlabel > span span {\n  position: absolute;\n  top: 0;\n  left: 0;\n  transform-origin: 0% 50%;\n  transition: transform 200ms ease-in-out;\n  cursor: text;\n}\n\nlabel .field:focus + span,\nlabel .field.is-focused + span,\nlabel .field:not(.is-empty) + span {\n  color: #337ab7;\n  pointer-events: none;\n}\n\nlabel .field:focus + span span,\nlabel .field.is-focused + span span,\nlabel .field:not(.is-empty) + span span {\n  transform: scale(0.8) translateY(-28px);\n  cursor: default;\n}\n\nlabel .field:focus + span,\nlabel .field.is-focused + span {\n  border-bottom-color: #337ab7;\n}\nlabel .field.is-invalid + span {\n  color: #eb1c26;\n  border-bottom-color: #eb1c26;\n}\n\n.field {\n  background: transparent;\n  font-weight: 400;\n  border: 0;\n  color: black;\n  outline: none;\n  cursor: text;\n  display: block;\n  width: 100%;\n  line-height: 28px;\n  padding-bottom: 3px;\n  transition: opacity 200ms ease-in-out;\n}\n\n.field::-webkit-input-placeholder { color: #ccc; }\n.field::-moz-placeholder { color: #ccc; }\n\n.field.is-empty:not(.is-focused),\n.field.is-empty:not(:focus) {\n  opacity: 0;\n}\n.field.is-empty:focus,\n.field.is-empty.is-focused {\n  opacity: 1;\n}\n\nbutton {\n  float: left;\n  display: block;\n  background: black;\n  color: white;\n  border: 0;\n  margin-top: 15px;\n  margin-bottom: 50px;\n  font-size: 19px;\n  font-weight: 400;\n  width: 100%;\n  height: 47px;\n  line-height: 45px;\n  outline: none;\n}\n\nbutton:focus {\n  background: #337ab7;\n}\n\nbutton:active {\n  background: #337ab7;\n}\n\n.styles .radio {\n  display: inline-block;\n  width: 50%;\n  line-height: 28px;\n}\n.sizes .radio {\n  display: inline-block;\n  width: 25%;\n  line-height: 28px;\n}\n\n.styles, .sizes {\n  width: 100%;\n}\n\n.radio {\n  text-align: center;\n}\n.radio input {\n  opacity: 0;\n}\n\n.radio input:checked + label {\n  background-color: black;\n  color: white;\n}\n\n.radio label {\n  background-color: #a4d5ff;\n  width: 100%;\n  display: inline-block;\n  padding: 8px 14px;;\n  margin: 0;\n}\nbutton, label {\n  transition: opacity 200ms ease-in-out;\n}\nbutton:hover, label:hover {\n  opacity: 0.8;\n}\n{\n  \"name\": \"datetimestore\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"dependencies\": {\n    \"autoprefixer\": \"7.1.2\",\n    \"babel-core\": \"6.25.0\",\n    \"babel-eslint\": \"7.2.3\",\n    \"babel-jest\": \"20.0.3\",\n    \"babel-loader\": \"7.1.1\",\n    \"babel-preset-react-app\": \"^3.0.2\",\n    \"babel-runtime\": \"6.26.0\",\n    \"body-parser\": \"^1.18.1\",\n    \"bootstrap\": \"^3.3.7\",\n    \"case-sensitive-paths-webpack-plugin\": \"2.1.1\",\n    \"chalk\": \"1.1.3\",\n    \"copy-webpack-plugin\": \"^4.0.1\",\n    \"css-loader\": \"0.28.4\",\n    \"dotenv\": \"4.0.0\",\n    \"eslint\": \"4.4.1\",\n    \"eslint-config-react-app\": \"^2.0.0\",\n    \"eslint-loader\": \"1.9.0\",\n    \"eslint-plugin-flowtype\": \"2.35.0\",\n    \"eslint-plugin-import\": \"2.7.0\",\n    \"eslint-plugin-jsx-a11y\": \"5.1.1\",\n    \"eslint-plugin-r