{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' /tmp/datetime-reference.x0C5oR/src/CheckoutForm.js && sed -n '1,240p' /tmp/datetime-reference.x0C5oR/src/Checkout.css && sed -n '1,220p' /tmp/datetime-reference.x0C5oR/src/App.css && git status --short && printf 'PROJECT=%s\\\\n' \\\"\"'$BENCHMARK_VERCEL_PROJECT\" && npx --yes vercel@latest whoami'","aggregated_output":"import React from 'react';\nimport {\n  label,\n  HelpBlock,\n  ControlLabel,\n  Radio,\n  Button,\n  Glyphicon,\n  ListGroup,\n  ListGroupItem,\n} from 'react-bootstrap';\n\nexport default class extends React.Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      name: '',\n      address1: '',\n      address2: '',\n      state: '',\n      city: '',\n      zip: '',\n      email: '',\n    };\n  }\n  componentDidMount() {\n    this.props.cardElement.mount('.Stripe');\n  }\n  componentWillUnmount() {\n    this.props.cardElement.unmount('.Stripe');\n  }\n  handleSubmit = ev => {\n    ev.preventDefault();\n    const {name, city, state, address1, address2, zip, email} = this.state;\n    this.props.onSubmit({\n      email,\n      address: {\n        name,\n        city,\n        state,\n        address1,\n        address2,\n        zip,\n      },\n    });\n  };\n\n  handleChange = name => e => {\n    this.setState({[name]: e.target.value});\n  };\n  render() {\n    const {disabled, error, orderErrors} = this.props;\n    return (\n      <form className=\"App-form\" onSubmit={this.handleSubmit}>\n        {orderErrors.length\n          ? <ListGroup>\n              {orderErrors.map(error => {\n                return (\n                  <ListGroupItem bsStyle=\"danger\">\n                    {error && error.message}\n                  </ListGroupItem>\n                );\n              })}\n            </ListGroup>\n          : ''}\n        <label>\n          <input\n            className={`field ${this.state.name ? '' : 'is-empty'}`}\n            type=\"text\"\n            name=\"name\"\n            autoComplete=\"name\"\n            value={this.state.name}\n            placeholder=\"Jenny Rosen\"\n            onChange={this.handleChange('name')}\n            required\n          />\n          <span><span>Name</span></span>\n        </label>\n        <label>\n          <input\n            className={`field ${this.state.address1 ? '' : 'is-empty'}`}\n            type=\"text\"\n            name=\"address1\"\n            value={this.state.address1}\n            placeholder=\"185 Berry St\"\n            onChange={this.handleChange('address1')}\n            required\n          />\n          <span><span>Shipping address</span></span>\n        </label>\n        <label>\n          <input\n            className={`field ${this.state.address2 ? '' : 'is-empty'}`}\n            type=\"text\"\n            name=\"address2\"\n            value={this.state.address2}\n            placeholder=\"Suite 550\"\n            onChange={this.handleChange('address2')}\n          />\n          <span><span>Apartment or Suite (optional)</span></span>\n        </label>\n        <label>\n          <input\n            className={`field ${this.state.city ? '' : 'is-empty'}`}\n            type=\"text\"\n            name=\"city\"\n            value={this.state.city}\n            placeholder=\"San Francisco\"\n            onChange={this.handleChange('city')}\n            required\n          />\n          <span><span>City</span></span>\n        </label>\n        <label>\n          <input\n            className={`field ${this.state.state ? '' : 'is-empty'}`}\n            type=\"text\"\n            name=\"state\"\n            value={this.state.state}\n            placeholder=\"CA\"\n            onChange={this.handleChange('state')}\n            required\n          />\n          <span><span>State</span></span>\n        </label>\n        <label>\n          <input\n            className={`field ${this.state.zip ? '' : 'is-empty'}`}\n            type=\"text\"\n            name=\"zip\"\n            value={this.state.zip}\n            placeholder=\"94107\"\n            onChange={this.handleChange('zip')}\n            required\n          />\n          <span><span>Postal code</span></span>\n        </label>\n        <label>\n          <input\n            className={`field ${this.state.email ? '' : 'is-empty'}`}\n            type=\"email\"\n            name=\"email\"\n            value={this.state.email}\n            placeholder=\"michelle@stripe.com\"\n            onChange={this.handleChange('email')}\n            required\n          />\n          <span><span>Email (for receipt)</span></span>\n        </label>\n        <label style={{display: 'block'}}>\n          <div className=\"Stripe field\" id=\"card\" />\n          <span><span>{error ? error.message : 'Card details'}</span></span>\n        </label>\n        <button type=\"submit\" disabled={disabled}>\n          <Glyphicon\n            glyph={disabled ? 'refresh' : 'shopping-cart'}\n            bsClass={disabled ? 'spinning glyphicon' : 'glyphicon'}\n          />\n          {' '}\n          {disabled ? 'Processing...' : 'Buy now'}\n        </button>\n      </form>\n    );\n  }\n}\n.form-control.is-focused {\n  border-color: #66afe9;\n  outline: 0;\n  box-shadow: inset 0 1px 1px rgba(0,0,0,.075), 0 0 8px rgba(102, 175, 233, .6);\n}\n\n.page-header h1 {\n  font-weight: 300;\n}\n.page-header h2 {\n  color: #337ab7;\n  font-weight: 400;\n  font-size: 19px;\n  margin: 0;\n  margin-top: 5px;\n  padding: 0;\n}\n\n.page-header small {\n  color: #aaa;\n}\n\n.glyphicon.spinning {\n  animation: spin 1s infinite linear;\n  -webkit-animation: spin2 1s infinite linear;\n}\n\n@keyframes spin {\n  from { transform: scale(1) rotate(0deg);}\n  to { transform: scale(1) rotate(360deg);}\n}\n\n@-webkit-keyframes spin2 {\n  from { -webkit-transform: rotate(0deg);}\n  to { -webkit-transform: rotate(360deg);}\n}\n\n.glyphicon-left {\n  margin-right: 7px;\n}\n\n.Checkout-success, .Checkout-prapi {\n  text-align: center;\n}\n.Checkout-success {\n  font-size: 16px;\n  padding-top: 20%;\n}\n.Checkout-prapi-button {\n  margin-top: 20px;\n}\n.Checkout-prapi-switch{\n  margin-top: 5px;\n  cursor: pointer;\n  font-size: 14px;\n}\n.Checkout-success-title {\n  font-size: 20px;\n  font-weight: 500;\n}\nfatal: not a git repository (or any of the parent directories): .git\n","exit_code":128,"status":"failed"}}
