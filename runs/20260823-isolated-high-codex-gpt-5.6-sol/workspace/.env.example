# Stripe test keys for local development. Never commit real values.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Scalable Press test key.
SP_AUTH=...

# quote (safe default) creates a design + quote but never a physical order.
# Change to live only after completing the production-readiness checklist.
FULFILLMENT_MODE=quote

# Optional canonical URL; request origin is used when omitted.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
