<span class=\"w\"> </span><span class=\"p\">:</span><span class=\"w\"> </span><span class=\"s2\">\"https://sample/delivery_note_bw.jpg\"</span><span class=\"p\">},</span><span class=\"w\">\n634-        </span><span class=\"nl\">\"packing_slip_color\"</span><span class=\"w\"> </span><span class=\"p\">:</span><span class=\"w\"> </span><span class=\"p\">{</span><span class=\"w\"> </span><span class=\"nl\">\"url\"</span><span class=\"w\"> </span><span class=\"p\">:</span><span class=\"w\"> </span><span class=\"s2\">\"https://sample/delivery_note_color.jpg\"</span><span class=\"p\">},</span><span class=\"w\">\n635-        </span><span class=\"nl\">\"sticker_exterior_round\"</span><span class=\"w\"> </span><span class=\"p\">:</span><span class=\"w\"> </span><span class=\"p\">{</span><span class=\"w\"> </span><span class=\"nl\">\"url\"</span><span class=\"w\"> </span><span class=\"p\">:</span><span class=\"w\"> </span><span class=\"s2\">\"https://sample/sticker_round.jpg\"</span><span class=\"p\">},</span><span class=\"w\">\n636-        </span><span class=\"nl\">\"sticker_exterior_rectangle\"</span><span class=\"w\">  </span><span class=\"p\">:{</span><span class=\"w\"> </span><span class=\"nl\">\"url\"</span><span class=\"w\"> </span><span class=\"p\">:</span><span class=\"w\"> </span><span class=\"s2\">\"https://sample/sticker_rect.jpg\"</span><span class=\"p\">},</span><span class=\"w\">\n637-        </span><span class=\"nl\">\"sticker_interior_round\"</span><span class=\"w\"> </span><span class=\"p\">:</span><span class=\"w\"> </span><span class=\"p\">{</span><span class=\"w\"> </span><span class=\"nl\">\"url\"</span><span class=\"w\"> </span><span class=\"p\">:</span><span class=\"w\"> </span><span class=\"s2\">\"https://sample/sticker_round.jpg\"</span><span class=\"p\">},</span><span class=\"w\">\n638-        </span><span class=\"nl\">\"sticker_interior_rectangle\"</span><span class=\"p\">:</span><span class=\"w\"> </span><span class=\"p\">{</span><span class=\"w\">