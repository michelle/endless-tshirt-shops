{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -lc \"export TASK_STRIPE_SECRET='rkcs_test_51U7aABPa9kwpL8gYSPMVV6X9DEwU6GgCxTnlAus159QWlzCRD7pFG7ierkzIbh9A40BtAhbaivHW1fKPGJGAKf00cpmCOPgR'\nexport TASK_STORE_ORIGIN='https://benchmark-20260824-prodigi-high-cod-three.vercel.app'\nnode --input-type=module <<'EOF'\nimport Stripe from 'stripe';\nconst stripe = new Stripe(process.env.TASK_STRIPE_SECRET);\nconst origin = process.env.TASK_STORE_ORIGIN;\nconst customer = {name:'Final Sandbox Buyer',email:'final-sandbox@example.com',address:{line1:'1 Infinite Loop',line2:'',city:'Cupertino',state:'CA',postalCode:'95014',country:'US'}};\nconst createResponse = await fetch(\"'`${origin}/api/create-payment-intent`, {method:'\"'POST',headers:{'content-type':'application/json'},body:JSON.stringify({style:'unisex',size:'L',timestamp:Date.now(),email:customer.email})});\nconst created = await createResponse.json();\nif (\"'!createResponse.ok) throw new Error(JSON.stringify(created));\nconst intent = await stripe.paymentIntents.confirm(created.paymentIntentId,{payment_method:'\"'pm_card_visa'});\nconst fulfill = async () => fetch(\"'`${origin}/api/fulfill-order`,{method:'\"'POST',headers:{'content-type':'application/json'},body:JSON.stringify({paymentIntentId:created.paymentIntentId,customer})});\nconst firstResponse = await fulfill();\nconst first = await firstResponse.json();\nconst retryResponse = await fulfill();\nconst retry = await retryResponse.json();\nconsole.log(JSON.stringify({create_status:createResponse.status,stripe_status:intent.status,first_fulfill_status:firstResponse.status,prodigi_order:first.orderId,prodigi_state:first.status,retry_status:retryResponse.status,retry_same_order:retry.orderId===first.orderId}));\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
