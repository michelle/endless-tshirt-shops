8px;\n  padding-bottom: 3px;\n  transition: opacity 200ms ease-in-out;\n}\n\n.field::-webkit-input-placeholder { color: #ccc; }\n.field::-moz-placeholder { color: #ccc; }\n\n.field.is-empty:not(.is-focused),\n.field.is-empty:not(:focus) {\n  opacity: 0;\n}\n.field.is-empty:focus,\n.field.is-empty.is-focused {\n  opacity: 1;\n}\n\nbutton {\n  float: left;\n  display: block;\n  background: black;\n  color: white;\n  border: 0;\n  margin-top: 15px;\n  margin-bottom: 50px;\n  font-size: 19px;\n  font-weight: 400;\n  width: 100%;\n  height: 47px;\n  line-height: 45px;\n  outline: none;\n}\n\nbutton:focus {\n  background: #337ab7;\n}\n\nbutton:active {\n  background: #337ab7;\n}\n\n.styles .radio {\n  display: inline-block;\n  width: 50%;\n  line-height: 28px;\n}\n.sizes .radio {\n  display: inline-block;\n  width: 25%;\n  line-height: 28px;\n}\n\n.styles, .sizes {\n  width: 100%;\n}\n\n.radio {\n  text-align: center;\n}\n.radio input {\n  opacity: 0;\n}\n\n.radio input:checked + label {\n  background-color: black;\n  color: white;\n}\n\n.radio label {\n  background-color: #a4d5ff;\n  width: 100%;\n  display: inline-block;\n  padding: 8px 14px;;\n  margin: 0;\n}\nbutton, label {\n  transition: opacity 200ms ease-in-out;\n}\nbutton:hover, label:hover {\n  opacity: 0.8;\n}\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <link rel=\"shortcut icon\" href=\"%PUBLIC_URL%/favicon.ico\">\n    <link href=\"https://fonts.googleapis.com/css?family=Chivo\" rel=\"stylesheet\">\n    <script src=\"https://js.stripe.com/v3/\"></script>\n    <!--\n      Notice the use of %PUBLIC_URL% in the tag above.\n      It will be replaced with the URL of the `public` folder during the build.\n      Only files inside the `public` folder can be referenced from the HTML.\n\n      Unlike \"/favicon.ico\" or \"favicon.ico\", \"%PUBLIC_URL%/favicon.ico\" will\n      work correctly both with client-side routing and a non-root public URL.\n      Learn how to configure a non-root public URL by running `npm run build`.\n    -->\n    <title>the datetime store</title>\n  </head>\n  <body>\n    <div id=\"root\"></div>\n    <!--\n      This HTML file is a template.\n      If you open it directly in the browser, you will see an empty page.\n\n      You can add webfonts, meta tags, or analytics to this file.\n      The build step will place the bundled scripts into the <body> tag.\n\n      To begin the development, run `npm start`.\n      To create a production bundle, use `npm run build`.\n    -->\n  </body>\n</html>\n","exit_code":0,"status":"completed"}}
