# Stripe (test keys from `stripe sandbox create` / Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe webhook_endpoints create` or Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Prodigi Print API (sandbox key for testing; live key for real orders)
PRODIGI_API_KEY=...
PRODIGI_API_BASE=https://api.sandbox.prodigi.com
# Set to "live" only when you are ready to print and ship real shirts
PRODIGI_ENV=sandbox

# Public origin used to build artwork URLs that Prodigi downloads (must be reachable from the internet)
NEXT_PUBLIC_SITE_URL=https://datetime.store

# Random secret protecting /admin/orders
ADMIN_TOKEN=change-me

# Optional: comma separated ISO country codes customers can ship to (default US)
SHIP_COUNTRIES=US
