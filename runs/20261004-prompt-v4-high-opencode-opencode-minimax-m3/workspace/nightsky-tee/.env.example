# Production env example. Copy to .env and fill in.

# Stripe:
#   Get from https://dashboard.stripe.com/apikeys (must be sk_live_… in production)
STRIPE_SECRET_KEY=sk_test_…

# Webhook signing secret:
#   Get from https://dashboard.stripe.com/webhooks after pointing at /webhook/stripe
STRIPE_WEBHOOK_SECRET=whsec_…

# Prodigi Print API:
#   Get from https://dashboard.prodigi.com  (sandbox: api.sandbox.prodigi.com)
PRODIGI_API_KEY=…

# Where the rendered shirts live, and where Stripe redirects customers.
# MUST be HTTPS (Stripe & Prodigi require it).
PUBLIC_URL=https://your-store.example.com

# Express port
PORT=8787

# Production hides preview URLs from /api/order/:id responses
NODE_ENV=production
