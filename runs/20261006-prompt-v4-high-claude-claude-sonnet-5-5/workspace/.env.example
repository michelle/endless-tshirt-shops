# Public https URL of the deployed store (used for Prodigi asset links and Stripe redirects)
PUBLIC_URL=https://your-store.example.com
# Long random string: openssl rand -hex 32  (REQUIRED in production; changing it invalidates in-flight orders)
SIGNING_SECRET=
# Prodigi: sandbox until you have a live key and a funded Prodigi account
PRODIGI_API_KEY=
PRODIGI_ENV=sandbox
# Stripe (leave empty to run the built-in test-mode payment page)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PORT=3000
