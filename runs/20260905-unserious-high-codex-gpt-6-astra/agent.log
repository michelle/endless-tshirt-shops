{"type":"item.started","item":{"id":"item_76","type":"command_execution","command":"/bin/zsh -lc \"node --env-file=.env.local --input-type=module <<'EOF'\nimport fs from 'node:fs';import Stripe from 'stripe';import assert from 'node:assert/strict';\nconst s=new Stripe(process.env.STRIPE_SECRET_KEY);const j=JSON.parse(fs.readFileSync('/tmp/datetime-integration-result.json','utf8'));\ntry {\nconst session=await s.checkout.sessions.retrieve(j.sessionId);const orderId=session.metadata.prodigi_order_id;\nconst r=await fetch('https://api.sandbox.prodigi.com/v4.0/orders/'+orderId,{headers:{'X-API-Key':process.env.PRODIGI_API_KEY}});const order=(await r.json()).order;\nconsole.log({orderId,status:order.status,assets:order.items.map(i=>({status:i.status,assets:i.assets.map(a=>({status:a.status,printArea:a.printArea}))}))});\nconst asset=await fetch(process.env.APP_URL+'/api/artwork/'+j.artworkToken);console.log({artworkStatus:asset.status,type:asset.headers.get('content-type'),bytes:(await asset.arrayBuffer()).byteLength});\nconst bad=await fetch(process.env.APP_URL+'/api/webhooks/stripe',{method:'POST',body:'{}',headers:{'stripe-signature':'invalid'}});assert.equal(bad.status,400);console.log({unsignedWebhookRejected:true});\n// Simulate failure after Prodigi accepted an order but before Stripe metadata persisted.\nawait s.checkout.sessions.update(j.sessionId,{metadata:{prodigi_order_id:'',fulfillment:'pending'}});\nconst retries=await Promise.all([1,2,3].map(async()=>{const r=await fetch(process.env.APP_URL+'/api/orders/status?session_id='+j.sessionId);return r.json();}));\nassert.ok(retries.every(result=>result.orderId===orderId));console.log({concurrentRetries:3,sameProdigiOrder:true,orderId});\nfs.mkdirSync('test-results',{recursive:true});fs.writeFileSync('test-results/integration-summary.json',JSON.stringify({testDate:new Date().toISOString(),paidSession:j.sessionId,orderId,concurrentRetries:3,sameProdigiOrder:true,artworkStatus:asset.status,prodigiStatus:order.status},null,2));\n} catch(error){console.error({message:error.message,type:error.type,code:error.code});process.exitCode=1;}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
