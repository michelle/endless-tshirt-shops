: [34,38,43,46] },\n} as const;\nexport const checkoutSchema = z.object({\n  style: z.enum(STYLES), size: z.enum(SIZES), requestId: z.uuid(),\n});\nexport const momentSchema = z.object({\n  timestamp: z.number().int().min(1_000_000_000_000).max(9_999_999_999_999),\n  style: z.enum(STYLES), size: z.enum(SIZES),\n});\nexport type Moment = z.infer<typeof momentSchema>;\nexport function printDimensions() { return { width: 4677, height: 5881 }; }\nEOF\ncat > app/layout.tsx <<'EOF'\nimport type { Metadata } from 'next';\nimport './globals.css';\nexport const metadata: Metadata = {\n  metadataBase: new URL(process.env.APP_URL || 'https://datetime.store'),\n  title: 'datetime.store — Wear right now. Forever.',\n  description: 'A black t-shirt. The current Unix timestamp. A completely unnecessary way to hold on to a moment. Pick your fit and capture right now.',\n  robots: { index: false, follow: false },\n};\nexport default function RootLayout({ children }: { children: React.ReactNode }) {\n  return <html lang=\\\"en\\\"><body>{children}</body></html>;\n}\nEOF\ncat > app/page.tsx <<'EOF'\nimport Store from './store';\nexport default function Page() { return <Store testMode={process.env.COMMERCE_MODE \"'!== '\"'live'} />; }\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
