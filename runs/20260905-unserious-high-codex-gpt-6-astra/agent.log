{"type":"item.started","item":{"id":"item_80","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\np='app/api/checkout/route.ts';s=open(p).read().replace(\\\"mode: 'payment', payment_method_types: ['card'],\\\", \\\"mode: 'payment', adaptive_pricing: { enabled: false }, payment_method_types: ['card'],\\\");open(p,'w').write(s)\np='lib/server.ts';s=open(p).read().replace(\\\"origin \"'!== appUrl() && !(process.env.NODE_ENV\", \"origin !== appUrl() && origin !== new URL(request.url).origin && !(process.env.NODE_ENV\");open(p,'\"'w').write(s)\np='lib/catalog.ts';s=open(p).read();s=s.replace(\\\"export const checkoutSchema = z.object({\\\\n  style: z.enum(STYLES), size: z.enum(SIZES), requestId: z.uuid(),\\\\n});\\\\n\\\",'');open(p,'w').write(s)\np='app/store.tsx';s=open(p).read().replace('ArrowUpRight, ArrowRight, Check, Clock3','ArrowUpRight, Clock3');open(p,'w').write(s)\nPY\nnpm test && npm run build\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_81","type":"command_execution","command":"/bin/zsh -lc \"node --env-file=.env.local --input-type=module <<'EOF'\nimport fs from 'node:fs';import assert from 'node:assert/strict';import Stripe from 'stripe';const stripe=new Stripe(process.env.STRIPE_SECRET_KEY);const base=process.env.APP_URL;\ntry {\n for (const [path,body,expected] of [['/api/moment',{style:'bad',size:'M'},400],['/api/checkout',{token:'forged',requestId:crypto.randomUUID()},400]]) {const r=await fetch(base+path,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});assert.equal(r.status,expected);console.log({path,invalidInputRejected:true});}\n const cross=await fetch(base+'/api/moment',{method:'POST',headers:{'Content-Type':'application/json',Origin:'https://malicious.example'},body:JSON.stringify({style:'unisex',size:'M'})});assert.equal(cross.status,403);console.log({crossOriginRejected:true});\n const capture=await fetch(base+'/api/moment',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({style:'fitted',size:'XL'})}).then(r=>r.json());\n const r=await fetch(base+'/api/checkout',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({token:[REDACTED_SECRET] j=await r.json();assert.equal(r.status,200,JSON.stringify(j));\n const id=new URL(j.url).pathname.split('/').pop();const session=await stripe.checkout.sessions.retrieve(id);assert.equal(session.metadata.style,'fitted');assert.equal(session.metadata.size,'XL');await stripe.checkout.sessions.expire(id);console.log({fittedXLCheckout:true,amount:session.amount_total});\n const test=JSON.parse(fs.readFileSync('/tmp/datetime-integration-result.json','utf8'));const paid=await stripe.checkout.sessions.retrieve(test.sessionId);const p=await fetch('https://api.sandbox.prodigi.com/v4.0/orders/'+paid.metadata.prodigi_order_id,{headers:{'X-API-Key':process.env.PRODIGI_API_KEY}}).then(r=>r.json());console.log({orderId:p.order.id,stage:p.order.status.stage,details:p.order.status.details,issues:p.order.status.issues,assetState:p.order.items[0].assets[0].status});\n} catch(e){console.log({message:e.message,code:e.code});process.exitCode=1;}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
