{"type":"item.started","item":{"id":"item_96","type":"command_execution","command":"/bin/zsh -lc \"node --env-file=.env.local --input-type=module <<'EOF'\nimport Stripe from 'stripe';import fs from 'node:fs';import assert from 'node:assert/strict';const base=process.env.APP_URL;const stripe=new Stripe(process.env.STRIPE_SECRET_KEY);\ntry {\n const home=await fetch(base);assert.equal(home.status,200);const html=await home.text();assert.ok(html.includes('Wear right now.'));assert.ok(html.includes('Test checkout. No real charge.'));console.log({publicStore:200,productContent:true});\n const capture=await fetch(base+'/api/moment',{method:'POST',headers:{'Content-Type':'application/json',Origin:base},body:JSON.stringify({style:'fitted',size:'XL'})}).then(r=>r.json());\n const checkout=await fetch(base+'/api/checkout',{method:'POST',headers:{'Content-Type':'application/json',Origin:base},body:JSON.stringify({token:[REDACTED_SECRET] data=await checkout.json();assert.equal(checkout.status,200,JSON.stringify(data));const id=new URL(data.url).pathname.split('/').pop();const session=await stripe.checkout.sessions.retrieve(id);assert.equal(session.adaptive_pricing.enabled,false);assert.equal(session.metadata.style,'fitted');await stripe.checkout.sessions.expire(id);console.log({deployedFittedCheckout:200,usdPrice:session.amount_total,adaptivePricing:false});\n const result=JSON.parse(fs.readFileSync('/tmp/datetime-integration-result.json','utf8'));const status=await fetch(base+'/api/orders/status?session_id='+result.sessionId).then(r=>r.json());assert.equal(status.orderId,'ord_1170586');assert.equal(status.fulfillment,'submitted');const evt=await stripe.events.retrieve(result.eventId);console.log({paid:status.paid,prodigiOrder:status.orderId,fulfillment:status.fulfillment,webhookPending:evt.pending_webhooks});\n for(const path of ['/.env.local','/SANDBOX_CLAIM.txt']){const r=await fetch(base+path);assert.equal(r.status,404);}\n console.log({privateFilesNotPublic:true});\n} catch(e){console.error({message:e.message,code:e.code});process.exitCode=1;}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
