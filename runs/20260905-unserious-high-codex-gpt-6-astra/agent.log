{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"node <<'EOF'\nconst fs=require('fs');const crypto=require('crypto');let s=fs.readFileSync('/tmp/datetime-stripe-provision-final.log','utf8');const j=JSON.parse(s.slice(s.indexOf('{'),s.lastIndexOf('}')+1));\nfs.writeFileSync('.env.local', \"'`STRIPE_SECRET_KEY=${j.secret_key}'\"\\\\nPRODIGI_API_KEY=\"'${process.env.PRODIGI_API_KEY}'\"\\\\nCOMMERCE_MODE=test\\\\nARTWORK_SIGNING_SECRET=\"'${crypto.randomBytes(32).toString('\"'hex')}\\\\nAPP_URL=https://\"'${process.env.BENCHMARK_VERCEL_PROJECT}.vercel.app'\"\\\\n\"'`,{mode:0o600});\nfs.writeFileSync('\"'SANDBOX_CLAIM.txt',\"'`Claim the Stripe sandbox before ${j.expires_at}:'\"\\\\n\"'${j.claim_url}'\"\\\\n\\\\nSandbox account: \"'${j.account_id}'\"\\\\nProvisioned with test email datetime-test@example.com. Claim with your own Stripe account.\\\\n\"'`,{mode:0o600});\nconsole.log('\"'Stripe sandbox configured. Expiration:',j.expires_at);\nEOF\nprintf '\\\\nSANDBOX_CLAIM.txt\\\\n' >> .gitignore\nnpm run dev\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
