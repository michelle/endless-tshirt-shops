n  };\n\n  handleChange = name => e => {\n    this.setState({[name]: e.target.value});\n  };\n  render() {\n    const {disabled, error, orderErrors} = this.props;\n    return (\n      <form className=\"App-form\" onSubmit={this.handleSubmit}>\n        {orderErrors.length\n          ? <ListGroup>\n              {orderErrors.map(error => {\n                return (\n                  <ListGroupItem bsStyle=\"danger\">\n                    {error && error.message}\n                  </ListGroupItem>\n                );\n              })}\n            </ListGroup>\n          : ''}\n        <label>\n          <input\n            className={`field ${this.state.name ? '' : 'is-empty'}`}\n            type=\"text\"\n            name=\"name\"\n            autoComplete=\"name\"\n            value={this.state.name}\n            placeholder=\"Jenny Rosen\"\n            onChange={this.handleChange('name')}\n            required\n          />\n          <span><span>Name</span></span>\n        </label>\n        <label>\n          <input\n            className={`field ${this.state.address1 ? '' : 'is-empty'}`}\n            type=\"text\"\n            name=\"address1\"\n            value={this.state.address1}\n            placeholder=\"185 Berry St\"\n            onChange={this.handleChange('address1')}\n            required\n          />\n          <span><span>Shipping address</span></span>\n        </label>\n        <label>\n          <input\n            className={`field ${this.state.address2 ? '' : 'is-empty'}`}\n            type=\"text\"\n            name=\"address2\"\n            value={this.state.address2}\n            placeholder=\"Suite 550\"\n            onChange={this.handleChange('address2')}\n          />\n          <span><span>Apartment or Suite (optional)</span></span>\n        </label>\n        <label>\n          <input\n            className={`field ${this.state.city ? '' : 'is-empty'}`}\n            type=\"text\"\n            name=\"city\"\n            value={this.state.city}\n            placeholder=\"San Francisco\"\n            onChange={this.handleChange('city')}\n            required\n          />\n          <span><span>City</span></span>\n        </label>\n        <label>\n          <input\n            className={`field ${this.state.state ? '' : 'is-empty'}`}\n            type=\"text\"\n            name=\"state\"\n            value={this.state.state}\n            placeholder=\"CA\"\n            onChange={this.handleChange('state')}\n            required\n          />\n          <span><span>State</span></span>\n        </label>\n        <label>\n          <input\n            className={`field ${this.state.zip ? '' : 'is-empty'}`}\n            type=\"text\"\n            name=\"zip\"\n            value={this.state.zip}\n            placeholder=\"94107\"\n            onChange={this.handleChange('zip')}\n            required\n          />\n          <span><span>Postal code</span></span>\n        </label>\n        <label>\n          <input\n            className={`field ${this.state.email ? '' : 'is-empty'}`}\n            type=\"email\"\n            name=\"email\"\n            value={this.state.email}\n            placeholder=\"michelle@stripe.com\"\n            onChange={this.handleChange('email')}\n            required\n          />\n          <span><span>Email (for receipt)</span></span>\n        </label>\n        <label style={{display: 'block'}}>\n          <div className=\"Stripe field\" id=\"card\" />\n          <span><span>{error ? error.message : 'Card details'}</span></span>\n        </label>\n        <button type=\"submit\" disabled={disabled}>\n          <Glyphicon\n            glyph={disabled ? 'refresh' : 'shopping-cart'}\n            bsClass={disabled ? 'spinning glyphicon' : 'glyphicon'}\n          />\n          {' '}\n          {disabled ? 'Processing...' : 'Buy now'}\n        </button>\n      </form>\n    );\n  }\n}\n* {\n  font-family: \"Helvetica Neue\", Helvetica;\n  font-size: 16px;\n  font-variant: normal;\n  padding: 0;\n  margin: 0;\n}\n\nbody {\n  -webkit-font-smoothing: antialiased;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 100%;\n}\n\nlabel {\n  position: relative;\n  color: black;\n  display: block;\n  margin-top: 28px;\n  margin-bottom: 18px;\n  width: 100%;\n}\n\nlabel > span {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  font-weight: 400;\n  line-height: 28px;\n  color: black;\n  border-bottom: 1px solid #a4d5ff;\n  transition: border-bottom-color 200ms ease-in-out;\n}\n\nlabel > span span {\n  position: absolute;\n  top: 0;\n  left: 0;\n  transform-origin: 0% 50%;\n  transition: transform 200ms ease-in-out;\n  cursor: text;\n}\n\nlabel .field:focus + span,\nlabel .field.is-focused + span,\nlabel .field:not(.is-empty) + span {\n  color: #337ab7;\n  pointer-events: none;\n}\n\nlabel .field:focus + span span,\nlabel .field.is-focused + span span,\nlabel .field:not(.is-empty) + span span {\n  transform: scale(0.8) translateY(-28px);\n  cursor: default;\n}\n\nlabel .field:focus + span,\nlabel .field.is-focused + span {\n  border-bottom-color: #337ab7;\n}\nlabel .field.is-invalid + span {\n  color: #eb1c26;\n  border-bottom-color: #eb1c26;\n}\n\n.field {\n  background: transparent;\n  font-weight: 400;\n  border: 0;\n  color: black;\n  outline: none;\n  cursor: text;\n  display: block;\n  width: 100%;\n  line-height: 28px;\n  padding-bottom: 3px;\n  transition: opacity 200ms ease-in-out;\n}\n\n.field::-webkit-input-placeholder { color: #ccc; }\n.field::-moz-placeholder { color: #ccc; }\n\n.field.is-empty:not(.is-focused),\n.field.is-empty:not(:focus) {\n  opacity: 0;\n}\n.field.is-empty:focus,\n.field.is-empty.is-focused {\n  opacity: 1;\n}\n\nbutton {\n  float: left;\n  display: block;\n  background: black;\n  color: white;\n  border: 0;\n  margin-top: 15px;\n  margin-bottom: 50px;\n  font-size: 19px;\n  font-weight: 400;\n  width: 100%;\n  height: 47px;