"><span>Payment</span><strong>{order.payment==='paid'?'Test payment confirmed':order.payment}</strong></div><div className=\\\"status-row\\\"><span>Print partner</span><strong>{order.stage}</strong></div>{order.orderId&&<p className=\\\"status-label\\\">Prodigi reference: {order.orderId}</p>}{order.issues&&<p>The print partner has flagged an issue. The store operator can review it in Prodigi.</p>}{order.items?.map(i=><div className=\\\"status-row\\\" key={i.id+i.size}><span>{products.find(p=>p.id===i.id)?.name} · {i.size.toUpperCase()} × {i.quantity}</span><span>{money(i.quantity*3200)}</span></div>)}{order.amount&&<div className=\\\"status-row\\\"><strong>Total including shipping</strong><strong>{money(order.amount)}</strong></div>}{order.tracking&&<a href={order.tracking} rel=\\\"noreferrer\\\" target=\\\"_blank\\\">Track shipment ↗</a>}</div>}<p>Keep this private link to check your order again. Fulfillment updates can take a minute. Status refreshes automatically.</p><button className=\\\"add-button\\\" onClick={refresh}>Refresh order status ↻</button><a className=\\\"add-button\\\" href=\\\"/\\\">Back to the collection ↗</a><p><a href=\\\"/policies\\\">Store policies</a></p></main>;\n}\nEOF\ncat > app/policies/page.tsx <<'EOF'\nexport default function Policies(){return <main className=\\\"simple-page\\\"><a className=\\\"wordmark\\\" href=\\\"/\\\">NIGHT SHIFT<span>✳</span></a><h1>The small print.</h1><p>Night Shift is currently a working test store. Every checkout is a Stripe test payment, and every print order goes to the Prodigi sandbox. No real payments, manufacturing, or shipping take place.</p><h2>Pricing & delivery</h2><p>Shirts are \"'$32 USD each. Standard US shipping is $6 per order, shown before checkout. US delivery addresses only. Test orders have no delivery promise. Sales tax is not calculated in this test release.</p><h2>Returns & cancellations</h2><p>There are no physical returns or monetary refunds for test orders. Before accepting real orders, the operator must publish a customer support contact, delivery estimates, and a complete cancellation, defect, and return policy. Product images are mockups; print scale and color may vary.</p><h2>Your information</h2><p>Stripe collects payment details and a delivery address during checkout. The store does not receive your full card number. The name, email, delivery address, and ordered items are sent to Prodigi for simulated fulfillment. Use test information when trying the store.</p><p>The shopping bag is stored in your browser. Order records are held by Stripe and Prodigi. Your confirmation link is private: anyone with it can view the order’s items and fulfillment status, but this page does not disclose your delivery address or email. No advertising or analytics trackers are installed. Google Fonts receives a request when the store loads.</p><h2>Questions about a test order</h2><p>Contact the person who shared this store with you and include the reference shown on your confirmation page. Customer support is not yet staffed for a public launch.</p><p><a href=\"https://stripe.com/privacy\">Stripe privacy policy ↗</a><br/><a href=\"https://www.prodigi.com/privacy-policy/\">Prodigi privacy policy ↗</a></p><a className=\"add-button\" href=\"/\">Back to the collection ↗</a></main>}\nEOF\nnode scripts/artwork.mjs\nnpm run build'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc \"cp /tmp/nightshift-assets/black-shirt-render.png public/black-shirt.png\ncp /tmp/nightshift-assets/SOURCE.txt public/asset-source.txt\ncat > app/page.tsx <<'EOF'\n'use client';\nimport {useEffect,useRef,useState} from 'react';\nimport {products,sizes,PRICE,SHIPPING,money,cartSchema,type CartItem} from '../lib/catalog';\nexport default function Store(){\n const [selected,setSelected]=useState(0),[size,setSize]=useState('m'),[cart,setCart]=useState<CartItem[]>([]),[ready,setReady]=useState(false),[busy,setBusy]=useState(false),[notice,setNotice]=useState(''),[showBag,setShowBag]=useState(false);\n const bag=useRef<HTMLDialogElement>(null);const p=products[selected];const count=cart.reduce((s,i)=>s+i.quantity,0);const subtotal=count*PRICE;\n useEffect(()=>{try{const s=JSON.parse(localStorage.getItem('nightshift-bag-v1')||'[]');if(s.length&&cartSchema.safeParse(s).success)setCart(s);}catch{}setReady(true);if(new URLSearchParams(location.search).get('checkout')==='cancelled'){setNotice('Checkout cancelled. Your bag is right here.');setShowBag(true);}},[]);\n useEffect(()=>{if(ready)localStorage.setItem('nightshift-bag-v1',JSON.stringify(cart));},[cart,ready]);\n useEffect(()=>{if(showBag&&\"'!bag.current?.open)bag.current?.showModal();if(!showBag&&bag.current?.open)bag.current.close();},[showBag]);\n function add(id:string=p.id,chosenSize:string=size){\n  let next=[...cart];let index=next.findIndex(i=>i.id===id&&i.size===chosenSize);if(index>=0)next[index]={...next[index],quantity:next[index].quantity+1};else next.push({id,size:chosenSize,quantity:1} as CartItem);\n  if(!cartSchema.safeParse(next).success){setNotice('\"'Your bag can hold 10 shirts, with up to 5 of each size and design.');return false;}setCart(next);setNotice('Added to your bag.');setShowBag(true);return true;\n }\n function change(index:number,delta:number){const next=cart.map((i,n)=>n===index?{...i,quantity:i.quantity+delta}:i).filter(i=>i.quantity>0);if(\"'!next.length||cartSchema.safeParse(next).success)setCart(next);else setNotice('\"'Maximum 5 per style and size, and 10 shirts per order.');}\n useEffect(()=>{const context=(document as unknown as {modelContext?:{registerTool:(tool:unknown,options:unknown)=>Promise<void>|void}}).modelContext;if(\"'!context)return;const lifecycle=new AbortController();Promise.resolve(context.registerTool({name:'\"'add_shirt_to_bag',description:'Stage a Night Shift shirt in the shopping bag. Does not start checkout or charge money.',inputSchema:{type:'object',properties:{id:{type:'string',enum:products.map(p=>p.id)},size:{type:'string',enum:[...sizes]}},required:['id','size'],additionalProperties:false},annotations:{readOnlyHint:false},execute:(input:unknown)=>{const item=cartSchema.element.safeParse({...input as object,quantity:1});if(\"'!item.success)throw Error('\"'Invalid design or size');if(\"'!add(item.data.id,item.data.size))throw Error('\"'Bag limit reached');return {added:true,...item.data};}},{signal:lifecycle.signal})).catch(()=>{});return()=>lifecycle.abort();},[cart]);\n async function checkout(){setBusy(true);setNotice('');try{const r=await fetch('/api/checkout',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:cart})});const d=await r.json();if(\"'!r.ok)throw Error(d.error);location.assign(d.url);}catch(e){setNotice(e instanceof Error?e.message:'\"'Unable to start checkout.');setBusy(false);}}\n return <>\n <div className=\\\"testbar\\\"><span className=\\\"status-dot\\\"/> TEST FLIGHT — Explore the store. Test payments only. No physical orders.</div>\n <header><a href=\\\"/\\\" className=\\\"wordmark\\\" aria-label=\\\"Night Shift home\\\">NIGHT SHIFT<span>✳</span></a><nav><a href=\\\"#collection\\\">The collection</a><a href=\\\"#details\\\">The details</a><button className=\\\"bag-button\\\" onClick={()=>setShowBag(true)}>Bag <span>{count.toString().padStart(2,'0')}</span></button></nav></header>\n <main>\n <section className=\\\"intro\\\"><div className=\\\"eyebrow\\\"><span className=\\\"cross\\\">+</span> GOOD COMPANY. DARK SKIES.</div><h1>For people<br/>who <em>look up.</em></h1><div className=\\\"intro-side\\\"><p>Late nights. Distant worlds.<br/>A small collection for your<br/>very large obsession.</p><a href=\\\"#collection\\\">Meet your night shift <span>↘</span></a></div><span className=\\\"edition\\\">AFTER DARK COLLECTION / VOL. 001</span></section>\n <section id=\\\"collection\\\" className=\\\"product-section\\\" aria-label=\\\"Shop the collection\\\">\n <div className=\\\"product-photo\\\"><div className=\\\"photo-top\\\"><span>NS — {p.number}</span><span>BLACK / {p.ink==='x'?'':'FRONT PRINT'}</span></div><div className=\\\"shirt-preview\\\"><img className=\\\"shirt\\\" src=\\\"/black-shirt.png\\\" alt=\\\"Black Gildan Softstyle t-shirt\\\" width=\\\"1200\\\" height=\\\"1200\\\"/><img className=\\\"shirt-print\\\" src={\"'`/artwork/${p.id}-v1.svg`} alt={`${p.name} astronomy print`} width=\"800\" height=\"1006\"/></div><div className=\"photo-bottom\"><span>MADE FOR THE AFTER HOURS</span><span>↗</span></div><small className=\"mockup-note\">Product mockup · print size and color may vary slightly</small></div>\n <div className=\"product-info\"><div className=\"eyebrow\">PICK YOUR OBSESSION</div><div className=\"design-tabs\" role=\"group\" aria-label=\"Choose a design\">{products.map((d,i)=><button key={d.id} aria-pressed={selected===i} className={selected===i?'\"'active':''} onClick={()=>{setSelected(i);setNotice('');}}>{d.number}<span>{['Orbit','Moon','Pluto'][i]}</span></button>)}</div>\n <div className=\\\"product-title\\\"><span className=\\\"eyebrow\\\">{p.label}</span><h2>{p.name}</h2><div className=\\\"price-row\\\"><span>{money(PRICE)}</span><span>USD</span></div></div><p className=\\\"product-story\\\">{p.story}</p>\n <div className=\\\"color-label\\\"><i/> Black <span> / {['Observatory green','Moonlight','Deep-space blue'][selected]} print</span></div>\n <div className=\\\"size-heading\\\"><span>Size <strong>{size.toUpperCase()}</strong></span><a href=\\\"#size-guide\\\">Size guide ↗</a></div><div className=\\\"sizes\\\" role=\\\"group\\\" aria-label=\\\"Select shirt size\\\">{sizes.map(s=><button key={s} aria-pressed={s===size} className={s===size?'active':''} onClick={()=>setSize(s)}>{s.toUpperCase()}</button>)}</div>\n <button className=\\\"add-button\\\" onClick={()=>add()}>Add to bag — {money(PRICE)} <span>↗</span></button><p className=\\\"shipping-note\\\">Printed to order · {money(SHIPPING)} US shipping per order</p><p aria-live=\\\"polite\\\" className=\\\"notice\\\">{\"'!showBag&&notice}</p>\n <div className=\"spec-strip\"><span>100% cotton</span><span>Unisex fit</span><span>Front print</span></div>\n </div></section>\n <section className=\"collection-strip\" aria-label=\"All designs\">{products.map((d,i)=><button key={d.id} onClick={()=>{setSelected(i);document.getElementById('\"'collection')?.scrollIntoView({behavior:'smooth'});}} className={selected===i?'chosen':''}><span className=\\\"eyebrow\\\">0{i+1} / {['ORBITAL STUDY','LUNAR CLUB','PLUTO APPRECIATION SOCIETY'][i]}</span><div className=\\\"art-card\\\" style={{color:d.ink}}><img src={\"'`/artwork/${d.id}-v1.svg`} alt={d.name} width=\"800\" height=\"1006\"/></div><span className=\"card-name\">{d.name}<span>↗</span></span><span className=\"card-subtitle\">{d.subtitle}</span></button>)}</section>\n <section id=\"details\" className=\"details\"><div><div className=\"eyebrow\">LESS STUFF. MORE STARGAZING.</div><h2>Your favorite<br/>night-out shirt.<br/><em>Way out.</em></h2></div><div className=\"detail-content\"><details open><summary>The shirt</summary><p>Gildan 64000 Softstyle. Black, 100% ring-spun cotton with a crew neck and a semi-fitted unisex cut. Original Night Shift artwork printed on the front by Prodigi.</p></details><details><summary>Made when you order</summary><p>Each shirt is printed on demand. This store is currently in test mode: checkout uses test cards and Prodigi simulates fulfillment. No item will be manufactured or shipped.</p></details><details><summary>Shipping & care</summary><p>US addresses only. Standard shipping is $6 per order. Live delivery estimates will be added after sample testing. Wash inside out on cold, avoid bleach, and do not iron directly over the print.</p></details><details id=\"size-guide\"><summary>Find your fit</summary><p>Measure a tee you already love, laid flat. Chest is the full circumference in inches; length is shoulder to hem. Manufacturing tolerances apply.</p><table><thead><tr><th>Size</th><th>Chest</th><th>Length</th></tr></thead><tbody>{[['\"'S','36','28'],['M','40','29'],['L','44','30'],['XL','48','31'],['2XL','52','32']].map(r=><tr key={r[0]}>{r.map((c,i)=><td key={i}>{c}{i>0?'″':''}</td>)}</tr>)}</tbody></table><a href=\\\"https://www.prodigi.com/products/mens-clothing/t-shirts/classic/gildan-64000/\\\" target=\\\"_blank\\\" rel=\\\"noreferrer\\\">Manufacturer’s product details ↗</a></details></div></section>\n </main><footer><a href=\\\"/\\\" className=\\\"wordmark\\\">NIGHT SHIFT<span>✳</span></a><p>See you after sunset.</p><a href=\\\"/policies\\\">Shipping, returns & privacy ↗</a><span>© {new Date().getFullYear()} NIGHT SHIFT</span></footer>\n <dialog ref={bag} className=\\\"bag-dialog\\\" onCancel={()=>setShowBag(false)} onClose={()=>setShowBag(false)}><div className=\\\"bag-header\\\"><h2>Your bag <small>({count})</small></h2><button aria-label=\\\"Close bag\\\" onClick={()=>setShowBag(false)}>✕</button></div>{cart.length? <><div className=\\\"bag-items\\\">{cart.map((i,n)=><div className=\\\"bag-item\\\" key={i.id+i.size}><div className=\\\"bag-art\\\"><img src={\"'`/artwork/${i.id}-v1.svg`} alt=\"\" width=\"80\" height=\"100\"/></div><div><strong>{products.find(p=>p.id===i.id)!.name}</strong><p>Black / {i.size.toUpperCase()}</p><div className=\"quantity\"><button aria-label={`Decrease ${i.id} quantity`} onClick={()=>change(n,-1)}>−</button><span>{i.quantity}</span><button aria-label={`Increase ${i.id} quantity`} onClick={()=>change(n,1)}>+</button><button className=\"remove\" onClick={()=>setCart(cart.filter((_,j)=>j!==n))}>Remove</button></div></div><span>{money(i.quantity*PRICE)}</span></div>)}</div><div className=\"bag-totals\"><p><span>Subtotal</span><span>{money(subtotal)}</span></p><p><span>US shipping</span><span>{money(SHIPPING)}</span></p><p className=\"total\"><span>Total</span><span>{money(subtotal+SHIPPING)}</span></p></div><p className=\"test-note\">Test mode · no real charge or shipment.<br/>Use card 4242 4242 4242 4242 at checkout.</p><button className=\"add-button\" disabled={busy} onClick={checkout}>{busy?'\"'Preparing secure checkout…':'Continue to checkout'} <span>↗</span></button><p className=\\\"shipping-note\\\">Secure checkout with Stripe</p><p className=\\\"notice\\\" role=\\\"status\\\">{notice}</p><a className=\\\"policy-link\\\" href=\\\"/policies\\\">Shipping, returns & privacy</a></>:<div className=\\\"empty-bag\\\"><span>✳</span><h3>A little space in your bag.</h3><p>Find the tee for your next late night.</p><button className=\\\"add-button\\\" onClick={()=>setShowBag(false)}>Explore the collection ↗</button></div>}</dialog>\n </>;\n}\nEOF\ncat > app/globals.css <<'EOF'\n@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n:root{--bg:#f4f3ef;--ink:#19241e;--green:#d3ebbd;--line:#cccfc6;--muted:#626b61;--dark:#19271e}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:25px}body{margin:0;background:var(--bg);color:var(--ink);font-family:'DM Sans',Arial,sans-serif;font-size:16px;line-height:1.5}button,a,input{ -webkit-tap-highlight-color:transparent}button{font:inherit;color:inherit;cursor:pointer}a{color:inherit;text-underline-offset:4px}button:disabled{opacity:.55;cursor:wait}button:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid #648149;outline-offset:5px}button{border-radius:0}img{display:block;max-width:100%;height:auto}.testbar{background:var(--dark);color:#e4ebde;text-align:center;font-size:12px;letter-spacing:.065em;padding:9px 20px}.status-dot{display:inline-block;background:var(--green);width:6px;height:6px;border-radius:50%;margin:0 9px 2px 0}header{height:105px;display:flex;align-items:center;justify-content:space-between;max-width:1440px;margin:auto;padding:0 5%;border-bottom:1px solid var(--line)}.wordmark{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:27px;letter-spacing:-1.5px;text-decoration:none;white-space:nowrap}.wordmark span{margin-left:12px;font-size:36px;vertical-align:-3px}nav{display:flex;gap:36px;align-items:center;font-size:14px}nav a{text-decoration:none}.bag-button{background:none;border:0}.bag-button span{background:var(--ink);color:var(--bg);padding:5px 8px;font-size:12px;margin-left:8px}main{max-width:1440px;margin:auto;padding:0 5%}.intro{padding:52px 0 36px;position:relative;display:grid;grid-template-columns:1fr 1fr;align-items:end}.eyebrow{font-family:'Space Grotesk',sans-serif;font-size:12px;font-weight:500;letter-spacing:.11em}.intro>.eyebrow{grid-column:1/-1;margin-bottom:25px}.cross{margin-right:12px;font-size:20px}h1,h2,h3,p{margin:0}h1,h2,h3{font-family:'Space Grotesk',sans-serif}h1{font-size:clamp(60px,6.6vw,96px);line-height:.98;font-weight:500;letter-spacing:-5px}em{font-family:Georgia,serif;font-weight:400}.intro-side{padding-left:21%;padding-bottom:12px}.intro-side p{color:var(--muted);font-size:17px;line-height:1.6}.intro-side a{display:inline-block;margin-top:25px;text-decoration:none;border-bottom:1px solid var(--ink);padding-bottom:7px;font-size:14px}.intro-side a span{margin-left:33px;font-size:22px}.edition{grid-column:1/-1;margin-top:40px;text-align:right;letter-spacing:.08em;font-size:11px;color:var(--muted)}.product-section{display:grid;grid-template-columns:1.12fr 1fr;border:1px solid var(--line)}.product-photo{background:#e5e7df;position:relative;min-width:0;display:flex;flex-direction:column;justify-content:center;overflow:hidden}.photo-top,.photo-bottom{display:flex;justify-content:space-between;font-size:11px;letter-spacing:.1em;margin:25px 28px;z-index:1}.photo-top{margin-bottom:0}.photo-bottom{margin-top:0}.photo-bottom>span:last-child{font-size:22px}.shirt-preview{position:relative;margin:0 auto;width:100%;max-width:660px;mix-blend-mode:multiply}.shirt{width:100%}.shirt-print{position:absolute;width:31%;left:34.5%;top:28%;height:auto}.mockup-note{font-size:11px;text-align:center;color:var(--muted);margin:-8px 10px 16px}.product-info{padding:36px 44px 24px;background:#f9f9f5}.design-tabs{display:flex;border-bottom:1px solid var(--line);margin:12px 0 27px}.design-tabs button{flex:1;text-align:left;background:none;border:0;padding:12px 0;font-size:12px;color:var(--muted);border-bottom:2px solid transparent}.design-tabs button span{margin-left:10px;font-size:15px}.design-tabs button.active{border-bottom-color:var(--ink);color:var(--ink)}.product-title>.eyebrow{font-size:10px;color:var(--muted)}.product-title h2{font-weight:500;font-size:42px;line-height:1.06;letter-spacing:-1.9px;margin-top:8px;max-width:360px}.price-row{margin-top:13px;display:flex;gap:9px;align-items:center;font-size:21px}.price-row span:last-child{font-size:11px;color:var(--muted)}.product-story{font-size:14px;color:var(--muted);margin:16px 0 22px;line-height:1.7;max-width:410px}.color-label{font-size:13px;display:flex;align-items:center;gap:7px}.color-label i{display:inline-block;width:17px;height:17px;background:#171918;border:3px solid #f8f8f3;outline:1px solid #747b70;border-radius:50%;margin-right:4px}.color-label span{color:var(--muted)}.size-heading{display:flex;justify-content:space-between;margin:25px 0 12px;font-size:12px}.size-heading strong{margin-left:8px}.sizes{display:flex;gap:8px;margin-bottom:19px}.sizes button{flex:1;padding:11px 3px;border:1px solid var(--line);background:transparent;font-size:13px}.sizes button.active{background:var(--ink);color:var(--bg);border-color:var(--ink)}.add-button{width:100%;border:0;padding:17px 19px;background:var(--green);display:flex;justify-content:space-between;font-size:14px;font-weight:600;text-align:left}.add-button:hover{background:#c1dfa7}.shipping-note{text-align:center;font-size:11px;color:var(--muted);margin-top:10px}.notice{font-size:13px;color:#3e6531;margin:10px 0;min-height:0}.spec-strip{display:flex;justify-content:space-between;font-size:11px;padding-top:17px;margin-top:15px;border-top:1px solid var(--line)}.collection-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin:48px 0 80px}.collection-strip>button{background:none;border:0;padding:0;text-align:left}.collection-strip .eyebrow{font-size:10px}.art-card{background:var(--dark);height:250px;margin:13px 0 17px;display:flex;justify-content:center;align-items:center;transition:background .2s}.art-card img{height:210px;width:auto}.chosen .art-card,.collection-strip button:hover .art-card{background:#314334}.card-name{display:flex;justify-content:space-between;font-family:'Space Grotesk',sans-serif;font-size:19px;font-weight:500}.card-subtitle{display:block;margin-top:6px;color:var(--muted);font-size:12px}.details{display:grid;grid-template-columns:1fr 1fr;gap:60px;padding:55px 0 80px;border-top:1px solid var(--line)}.details h2{font-size:53px;line-height:1.05;font-weight:400;letter-spacing:-2px;margin-top:25px}.detail-content details{border-bottom:1px solid var(--line);padding:19px 0}.detail-content details:first-child{padding-top:0}.detail-content summary{font-size:16px;cursor:pointer;list-style:none;display:flex;justify-content:space-between}.detail-content summary:after{content:'+'}.detail-content details[open] summary:after{content:'−'}.detail-content p{color:var(--muted);font-size:14px;line-height:1.8;padding:15px 0 3px}.detail-content a{font-size:13px}table{width:100%;border-collapse:collapse;font-size:13px;margin:15px 0}th,td{text-align:left;border-bottom:1px solid var(--line);padding:8px}footer{background:var(--dark);color:#e7eddf;padding:40px 5%;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:20px}footer>p{text-align:right;font-family:Georgia,serif;font-style:italic;font-size:25px}footer>a:not(.wordmark){font-size:12px}footer>span{text-align:right;font-size:10px;letter-spacing:.1em;opacity:.7}.bag-dialog{border:0;position:fixed;inset:0 0 0 auto;margin:0;height:100dvh;max-height:100dvh;width:min(540px,100%);max-width:100%;padding:30px;background:var(--bg);color:var(--ink)}.bag-dialog::backdrop{background:#0a190e99;backdrop-filter:blur(3px)}.bag-header{display:flex;align-items:center;justify-content:space-between;padding-bottom:25px;border-bottom:1px solid var(--line)}.bag-header h2{font-size:29px;font-weight:500;letter-spacing:-1px}.bag-header small{font-size:17px}.bag-header button{background:none;border:0;padding:10px}.bag-item{display:grid;grid-template-columns:65px 1fr auto;gap:15px;border-bottom:1px solid var(--line);padding:24px 0;font-size:13px}.bag-art{background:var(--dark);height:85px;display:flex;align-items:center;justify-content:center}.bag-art img{width:52px}.bag-item p{font-size:12px;margin:5px 0;color:var(--muted)}.quantity{display:flex;gap:12px;align-items:center;font-size:13px}.quantity button{background:none;border:1px solid var(--line);width:25px;height:25px;padding:0}.quantity .remove{width:auto;border:0;font-size:11px;text-decoration:underline;margin-left:5px}.bag-totals{padding:25px 0}.bag-totals p{display:flex;justify-content:space-between;padding:5px 0;font-size:14px}.bag-totals .total{font-size:21px;padding-top:15px}.test-note{font-size:12px;background:#e8edde;padding:12px 15px;margin-bottom:20px}.policy-link{font-size:12px;display:block;text-align:center}.empty-bag{padding:70px 0;text-align:center}.empty-bag>span{font-size:70px}.empty-bag h3{font-size:24px;font-weight:500}.empty-bag p{color:var(--muted);margin:15px 0 30px}.simple-page{max-width:780px;margin:auto;padding:65px 25px}.simple-page h1{font-size:56px;letter-spacing:-2px;margin:30px 0}.simple-page h2{margin:35px 0 10px;font-size:25px}.simple-page p,.simple-page li{color:var(--muted);margin:12px 0;line-height:1.8}.simple-page .status-card{border:1px solid var(--line);padding:25px;margin:30px 0}.simple-page .add-button{text-decoration:none;margin-top:25px}.status-row{display:flex;justify-content:space-between;gap:20px;padding:10px 0}.status-label{font-size:12px;letter-spacing:.06em;color:var(--muted)}\n@media(min-width:1440px){footer{padding-left:calc((100vw - 1296px)/2);padding-right:calc((100vw - 1296px)/2)}}@media(max-width:950px){.product-info{padding:25px}.product-title h2{font-size:34px}.intro-side{padding-left:15%}.color-label{flex-wrap:wrap}.product-story{font-size:13px}.art-card{height:210px}.art-card img{height:180px}.details h2{font-size:45px}}@media(max-width:700px){header{height:82px}.wordmark{font-size:23px}nav{gap:20px}nav>a{display:none}.intro{padding-top:34px;grid-template-columns:1fr}.intro>.eyebrow{margin-bottom:20px}h1{font-size:64px;letter-spacing:-3.6px}.intro-side{padding:23px 0 0;display:flex;align-items:end;justify-content:space-between;gap:15px}.intro-side p{font-size:13px}.intro-side a{font-size:12px;white-space:nowrap}.intro-side a span{margin-left:10px}.edition{font-size:9px;margin-top:30px}.product-section{grid-template-columns:1fr}.product-photo{max-height:610px}.shirt-preview{max-width:560px}.photo-top,.photo-bottom{margin:18px 20px}.product-info{padding:28px 24px 22px}.product-title h2{font-size:42px;max-width:none}.product-story{font-size:14px}.design-tabs{margin-bottom:25px}.collection-strip{gap:12px;margin:35px 0 45px}.collection-strip .eyebrow{font-size:8px;letter-spacing:0}.art-card{height:155px;margin-top:9px}.art-card img{height:138px}.card-name{font-size:13px;line-height:1.2;gap:3px}.card-subtitle{display:none}.details{grid-template-columns:1fr;gap:32px;padding:35px 0 50px}.details h2{font-size:43px}.details h2 br:nth-child(2){display:none}.details h2 em{margin-left:10px}.testbar{font-size:10px;padding:8px 16px}.bag-dialog{padding:24px}.bag-item{gap:10px;grid-template-columns:55px 1fr auto}footer{padding-top:30px;padding-bottom:30px}footer>p{font-size:18px}footer>a:not(.wordmark){font-size:10px}.simple-page h1{font-size:44px}.simple-page{padding-top:35px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none\"'!important}}\nEOF\ncat > app/checkout/success/page.tsx <<'\"'EOF'\n'use client';\nimport {useEffect,useState} from 'react';\nimport {money,products,type CartItem} from '../../../lib/catalog';\ntype Order={payment:string;stage:string;orderId?:string;reference?:string;amount?:number;items?:CartItem[];tracking?:string;issues?:boolean};\nexport default function Success(){const [order,setOrder]=useState<Order|null>(null),[error,setError]=useState('');\n async function refresh(){const id=new URLSearchParams(location.search).get('session_id');if(\"'!id){setError('\"'This link is missing an order reference. Return using the link from checkout.');return;}try{const r=await fetch('/api/orders?session_id='+encodeURIComponent(id),{cache:'no-store'});const d=await r.json();if(\"'!r.ok)throw Error(d.error);setOrder(d);setError('\"'');if(d.payment==='paid')localStorage.removeItem('nightshift-bag-v1');}catch(e){setError(e instanceof Error?e.message:'Unable to load order');}}\n useEffect(()=>{refresh();const t=setInterval(refresh,7000);return()=>clearInterval(t);},[]);\n return <main className=\\\"simple-page\\\"><a className=\\\"wordmark\\\" href=\\\"/\\\">NIGHT SHIFT<span>✳</span></a><h1>{order?.payment==='paid'?'You’re on the night shift.':'Checking your order.'}</h1><p>This is a test order. No money is charged and no shirt will be physically shipped.</p>{error&&<p role=\\\"alert\\\">{error}</p>}{order&&<div className=\\\"status-card\\\"><div className=\\\"eyebrow\\\">ORDER {order.reference||'STATUS'}</div><div className=\\\"status-row\\\"><span>Payment</span><strong>{order.payment==='paid'?'Test payment confirmed':order.payment}</strong></div><div className=\\\"status-row\\\"><span>Print partner</span><strong>{order.stage}</strong></div>{order.orderId&&<p className=\\\"status-label\\\">Prodigi reference: {order.orderId}</p>}{order.issues&&<p>The print partner has flagged an issue. The store operator can review it in Prodigi.</p>}{order.items?.map(i=><div className=\\\"status-row\\\" key={i.id+i.size}><span>{products.find(p=>p.id===i.id)?.name} · {i.size.toUpperCase()} × {i.quantity}</span><span>{money(i.quantity*3200)}</span></div>)}{order.amount&&<div className=\\\"status-row\\\"><strong>Total including shipping</strong><strong>{money(order.amount)}</strong></div>}{order.tracking&&<a href={order.tracking} rel=\\\"noreferrer\\\" target=\\\"_blank\\\">Track shipment ↗</a>}</div>}<p>Keep this private link to check your order again. Fulfillment updates can take a minute. Status refreshes automatically.</p><button className=\\\"add-button\\\" onClick={refresh}>Refresh order status ↻</button><a className=\\\"add-button\\\" href=\\\"/\\\">Back to the collection ↗</a><p><a href=\\\"/policies\\\">Store policies</a></p></main>;\n}\nEOF\ncat > app/policies/page.tsx <<'EOF'\nexport default function Policies(){return <main className=\\\"simple-page\\\"><a className=\\\"wordmark\\\" href=\\\"/\\\">NIGHT SHIFT<span>✳</span></a><h1>The small print.</h1><p>Night Shift is currently a working test store. Every checkout is a Stripe test payment, and every print order goes to the Prodigi sandbox. No real payments, manufacturing, or shipping take place.</p><h2>Pricing & delivery</h2><p>Shirts are \"'$32 USD each. Standard US shipping is $6 per order, shown before checkout. US delivery addresses only. Test orders have no delivery promise. Sales tax is not calculated in this test release.</p><h2>Returns & cancellations</h2><p>There are no physical returns or monetary refunds for test orders. Before accepting real orders, the operator must publish a customer support contact, delivery estimates, and a complete cancellation, defect, and return policy. Product images are mockups; print scale and color may vary.</p><h2>Your information</h2><p>Stripe collects payment details and a delivery address during checkout. The store does not receive your full card number. The name, email, delivery address, and ordered items are sent to Prodigi for simulated fulfillment. Use test information when trying the store.</p><p>The shopping bag is stored in your browser. Order records are held by Stripe and Prodigi. Your confirmation link is private: anyone with it can view the order’s items and fulfillment status, but this page does not disclose your delivery address or email. No advertising or analytics trackers are installed. Google Fonts receives a request when the store loads.</p><h2>Questions about a test order</h2><p>Contact the person who shared this store with you and include the reference shown on your confirmation page. Customer support is not yet staffed for a public launch.</p><p><a href=\"https://stripe.com/privacy\">Stripe privacy policy ↗</a><br/><a href=\"https://www.prodigi.com/privacy-policy/\">Prodigi privacy policy ↗</a></p><a className=\"add-button\" href=\"/\">Back to the collection ↗</a></main>}\nEOF\nnode scripts/artwork.mjs\nnpm run build'","aggregated_output":"Created print artwork: orbit 4677 × 5881\nCreated print artwork: phase 4677 × 5881\nCreated print artwork: pluto 4677 × 5881\n\n> night-shift-store@1.0.0 build\n> next build\n\n▲ Next.js 16.3.4 (Turbopack)\n- Environments: .env.local\n✓ Running next.config.ts took 1194ms\n\n  Creating an optimized production build ...\n✓ Compiled successfully in 1265ms\n  Running TypeScript ...\n\n  We detected TypeScript in your project and created a tsconfig.json file for you.\napp/page.tsx(23,103): error TS2367: This comparison appears to be unintentional because the types '\"#c7efb7\" | \"#e8dcbc\" | \"#c7d9fa\"' and '\"x\"' have no overlap.\nFailed to type check.\n\n","exit_code":1,"status":"failed"}}
