{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/zsh -lc \"node --env-file=.env.local - <<'JS'\nconst fs=require('fs');const Stripe=require('stripe');(async()=>{let r=JSON.parse(fs.readFileSync('verification.json'));let response=await fetch('https://api.sandbox.prodigi.com/v4.0/orders/'+r.fulfillment.orderId,{headers:{'X-API-Key':process.env.PRODIGI_API_KEY}});let d=await response.json();console.log('Final Prodigi status:',JSON.stringify(d.order.status));console.log('Print asset URLs:',d.order.items.map(i=>i.assets.map(a=>({url:a.url,status:a.status}))));r.fulfillment.stage=d.order.status.stage;r.fulfillment.issues=d.order.status.issues;r.fulfillment.assetStates=d.order.items.map(i=>i.assets.map(a=>a.status));fs.writeFileSync('verification.json',JSON.stringify(r,null,2));const es=await new Stripe(process.env.STRIPE_SECRET_KEY).events.list({type:'checkout.session.completed',limit:3});console.log('Actual Stripe event pending webhooks:',es.data.find(e=>e.data.object.id===r.checkoutSessionId)?.pending_webhooks);let p=fs.readFileSync('PRIVATE_HANDOFF.md','utf8');p=p.replace(/session_id=cs_test_[A-Za-z0-9]+/, 'session_id='+r.checkoutSessionId);fs.writeFileSync('PRIVATE_HANDOFF.md',p);})();\nJS\nchmod 600 .env.local PRIVATE_HANDOFF.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
