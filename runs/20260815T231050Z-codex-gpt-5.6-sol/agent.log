max-width:1300px;margin:auto;display:grid;grid-template-columns:repeat(3,1fr)}.how-grid>div{padding:5px 7%;border-left:1px solid var(--line)}.how-grid>div:first-child{border-left:0;padding-left:0}.how h2{font-size:18px;letter-spacing:-.03em}.how p{font-size:12px;line-height:1.6;color:var(--muted);max-width:280px}footer{padding:35px 5vw;display:flex;align-items:center;justify-content:space-between;font-size:10px;color:var(--muted)}.success-page{display:flex;flex-direction:column;align-items:center;padding:40px}.success-page>.brand{align-self:flex-start}.success-card{background:#fff;padding:clamp(35px,7vw,80px);max-width:760px;width:100%;text-align:center;margin:auto;box-shadow:0 20px 80px #34312614}.success-card h1{font-size:clamp(44px,6vw,72px)}.check{margin:0 auto 25px;width:48px;height:48px;border-radius:50%;display:grid;place-items:center;background:#e8f1e8;color:#347044}.receipt-moment{margin:25px auto;padding:16px;border:1px solid var(--line);font-size:20px}.status{font-size:14px;font-weight:600}.success-card>p:not(.eyebrow):not(.status){font-size:12px;line-height:1.7;color:var(--muted)}.text-link{display:inline-block;margin-top:22px;color:var(--orange);font-size:12px;font-weight:700;text-decoration:none}
