+  const key = process.env.STRIPE_SECRET_KEY;
+  if (!key) throw new Error("Stripe is not configured");
+  return new Stripe(key, { apiVersion: "2025-07-30.basil", appInfo: { name: "datetime.store", version: "1.0.0" } });
+}
