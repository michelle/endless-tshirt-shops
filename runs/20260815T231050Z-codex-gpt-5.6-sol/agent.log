+:root{--ink:#171714;--paper:#f3f0e9;--orange:#ef5b30;--line:#d5d0c5;--muted:#77736a}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Manrope,Arial,sans-serif}button,a{font:inherit}button{color:inherit}main{min-height:100vh}nav{height:84px;padding:0 5vw;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}.brand{font-family:'DM Mono',monospace;font-weight:500;font-size:18px;color:inherit;text-decoration:none;letter-spacing:-.04em}.nav-note{font-size:11px;text-transform:uppercase;letter-spacing:.14em;color:var(--muted)}.hero{max-width:1440px;margin:auto;display:grid;grid-template-columns:.9fr 1.25fr .95fr;gap:3vw;align-items:center;padding:68px 5vw 82px;min-height:calc(100vh - 84px)}.eyebrow{text-transform:uppercase;font-size:11px;letter-spacing:.18em;font-weight:700;color:var(--orange);margin:0 0 20px}.intro h1,.success-card h1{font-size:clamp(52px,5vw,84px);line-height:.89;letter-spacing:-.06em;margin:0 0 30px;font-weight:600}.intro h1 em,.success-card h1 em{font-family:Newsreader,serif;font-weight:500}.lede{font-size:15px;line-height:1.7;color:#5f5b54;max-width:430px}.moment{border-left:2px solid var(--orange);margin-top:38px;padding-left:18px;display:flex;flex-direction:column}.moment span{font-size:10px;text-transform:uppercase;letter-spacing:.16em;color:var(--muted)}.moment strong,.receipt-moment{font:500 clamp(20px,2vw,28px)/1.5 'DM Mono',monospace;letter-spacing:.02em}.moment small{font-size:10px;color:var(--muted)}.freeze-note{font-size:10px;color:var(--muted);display:flex;align-items:center;gap:8px;margin-top:14px}.dot{width:7px;height:7px;border-radius:50%;background:var(--orange);box-shadow:0 0 0 5px #ef5b3025;animation:pulse 1.4s infinite}.dot.stopped{animation:none;background:var(--ink);box-shadow:none}@keyframes pulse{50%{box-shadow:0 0 0 9px transparent}}.shirt-stage{position:relative;align-self:center}.shirt-stage svg{display:block;width:100%;max-height:600px;overflow:visible}.price{position:absolute;right:3%;bottom:5%;background:var(--orange);color:white;width:112px;height:112px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;transform:rotate(6deg)}.price s{font-size:11px;opacity:.7}.price strong{font-size:20px}.price span{font-size:8px;text-transform:uppercase;letter-spacing:.08em}.order-card{background:#fff;padding:30px;box-shadow:0 20px 70px #34312616}.step{padding-bottom:26px}.step+.step{border-top:1px solid #e5e1d8;padding-top:24px}.step-title{display:flex;gap:13px;align-items:center;margin-bottom:14px;font-size:13px}.step-title span,.how-grid span{font:500 10px 'DM Mono',monospace;color:var(--orange)}.choices{display:grid;grid-template-columns:1fr 1fr;gap:8px}.choice{border:1px solid #d8d4ca;background:white;text-align:left;padding:13px;cursor:pointer}.choice b,.choice small{display:block}.choice b{font-size:12px}.choice small{font-size:9px;color:var(--muted);margin-top:3px}.choice.active,.size.active{border-color:var(--orange);box-shadow:inset 0 0 0 1px var(--orange);background:#fff8f4}.sizes{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.size{height:43px;border:1px solid #d8d4ca;background:white;font:500 12px 'DM Mono';cursor:pointer}.summary{border-top:1px solid #e5e1d8;padding:20px 0 15px;display:flex;justify-content:space-between;font-size:11px;color:var(--muted)}.summary strong{font-size:14px;color:var(--ink)}.buy{width:100%;border:0;background:var(--ink);color:white;padding:16px;cursor:pointer;font-size:12px;font-weight:700;transition:.2s}.buy:hover{background:var(--orange);transform:translateY(-1px)}.buy:disabled{opacity:.6;cursor:wait}.secure{text-align:center;font-size:8px;letter-spacing:.04em;color:#99948b;margin:12px 0 0}.error{font-size:11px;color:#b12d1c;text-align:center}.how{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:72px 5vw}.how>.eyebrow{max-width:1300px;margin:0 auto 30px}.how-grid{max-width:1300px;margin:auto;display:grid;grid-template-columns:repeat(3,1fr)}.how-grid>div{padding:5px 7%;border-left:1px solid var(--line)}.how-grid>div:first-child{border-left:0;padding-left:0}.how h2{font-size:18px;letter-spacing:-.03em}.how p{font-size:12px;line-height:1.6;color:var(--muted);max-width:280px}footer{padding:35px 5vw;display:flex;align-items:center;justify-content:space-between;font-size:10px;color:var(--muted)}.success-page{display:flex;flex-direction:column;align-items:center;padding:40px}.success-page>.brand{align-self:flex-start}.success-card{background:#fff;padding:clamp(35px,7vw,80px);max-width:760px;width:100%;text-align:center;margin:auto;box-shadow:0 20px 80px #34312614}.success-card h1{font-size:clamp(44px,6vw,72px)}.check{margin:0 auto 25px;width:48px;height:48px;border-radius:50%;display:grid;place-items:center;background:#e8f1e8;color:#347044}.receipt-moment{margin:25px auto;padding:16px;border:1px solid var(--line);font-size:20px}.status{font-size:14px;font-weight:600}.success-card>p:not(.eyebrow):not(.status){font-size:12px;line-height:1.7;color:var(--muted)}.text-link{display:inline-block;margin-top:22px;color:var(--orange);font-size:12px;font-weight:700;text-decoration:none}
+@media(max-width:1050px){.hero{grid-template-columns:1fr 1.1fr}.intro{grid-column:1}.shirt-stage{grid-column:2}.order-card{grid-column:1/-1;max-width:620px;width:100%;justify-self:center}.shirt-stage svg{max-height:500px}}
