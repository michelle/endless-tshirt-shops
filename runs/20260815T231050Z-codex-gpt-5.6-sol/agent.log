+@media(max-width:680px){nav{height:68px}.nav-note{display:none}.hero{display:flex;flex-direction:column;padding-top:45px}.intro h1{font-size:56px}.shirt-stage{width:95%;margin:10px auto}.price{width:92px;height:92px}.order-card{padding:24px}.how-grid{grid-template-columns:1fr}.how-grid>div{border-left:0;border-top:1px solid var(--line);padding:25px 0}.how-grid>div:first-child{border-top:0}footer{align-items:flex-start;gap:14px;flex-direction:column}.success-page{padding:25px 18px}.success-card{margin-top:50px}}
