# Stripe payment settings. Use test keys while validating.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Prodigi. Sandbox is the safe default; change to false only after go-live checks.
PRODIGI_API_KEY=...
PRODIGI_SANDBOX=true

# Optional. Used when a request-host header is unavailable.
NEXT_PUBLIC_APP_URL=https://your-store.vercel.app
