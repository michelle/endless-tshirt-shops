{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-build",
    "rootDir": ".",
    "noEmit": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "lib/catalog.ts",
    "lib/artwork.ts",
    "tests/**/*.ts"
  ]
}
