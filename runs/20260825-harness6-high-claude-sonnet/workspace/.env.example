# Stripe (test/sandbox keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Prodigi Print API
PRODIGI_API_KEY=...
# "sandbox" (default) or "live"
PRODIGI_ENVIRONMENT=sandbox

# Optional: overrides the origin used to build print-artwork URLs for
# Prodigi to fetch. Defaults to the incoming request's own origin, which is
# correct on Vercel — only set this if you need to pin a specific domain.
# PUBLIC_BASE_URL=https://your-deployment.vercel.app
