{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"/bin/zsh -lc \"cat > scripts/browser-verify.mjs <<'EOF'\nimport {chromium} from '@playwright/test';\nimport fs from 'node:fs';\nconst browser=await chromium.launch({headless:true});\nconst page=await browser.newPage({viewport:{width:1440,height:1100}});\nconst errors=[];page.on('pageerror',e=>errors.push(e.message));\nawait page.goto(process.env.APP_URL,{waitUntil:'networkidle'});\nfs.mkdirSync('artifacts',{recursive:true});\nawait page.screenshot({path:'artifacts/desktop.png',fullPage:true});\nconsole.log('Title:',await page.title());\nawait page.getByRole('button',{name:'Size guide'}).click();\nawait page.getByRole('button',{name:'Got it'}).click();\nawait page.getByRole('button',{name:'Fitted',exact:true}).click();\nawait page.getByRole('button',{name:'L',exact:true}).click();\nawait page.getByRole('button',{name:'Capture this moment',exact:true}).click();\nconst timestamp=await page.locator('.captured-number').innerText();\nconsole.log('Captured',timestamp);\nawait page.screenshot({path:'artifacts/review.png'});\nawait page.getByRole('button',{name:'Continue to checkout'}).click();\nawait page.waitForURL('https://checkout.stripe.com/**',{timeout:60000});\nawait page.waitForLoadState('domcontentloaded');\nawait page.screenshot({path:'artifacts/stripe-checkout.png',fullPage:true});\nconsole.log('Checkout URL',page.url());\nconsole.log((await page.locator('body').innerText()).slice(0,10000));\nconsole.log('Input fields',await page.locator('input,select').evaluateAll(el=>el.map(x=>({tag:x.tagName,id:x.id,name:x.name,type:x.type,placeholder:x.placeholder}))));\nfs.writeFileSync('artifacts/checkout-url.txt',page.url());\nconsole.log('Errors',errors);\nawait browser.close();\nEOF\nnode --env-file=.env.local scripts/browser-verify.mjs\"","aggregated_output":"Title: 404: NOT_FOUND\nnode:internal/modules/run_main:129\n    triggerUncaughtException(\n    ^\n\nlocator.click: Timeout 30000ms exceeded.\nCall log:\n\u001b[2m  - waiting for getByRole('button', { name: 'Size guide' })\u001b[22m\n\n    at /private/var/folders/mq/v8s9bp2x5gg6gvywwjfszb8r0000gn/T/benchmark-workspace.1eIjTp/scripts/browser-verify.mjs:10:52 {\n  log: [ \"  - waiting for getByRole('button', { name: 'Size guide' })\" ],\n  name: 'TimeoutError'\n}\n\nNode.js v20.18.0\n","exit_code":1,"status":"failed"}}
