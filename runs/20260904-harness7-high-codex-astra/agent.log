{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/zsh -lc \"cat > tsconfig.json <<'EOF'\n{\\\"compilerOptions\\\":{\\\"target\\\":\\\"ES2022\\\",\\\"lib\\\":[\\\"dom\\\",\\\"dom.iterable\\\",\\\"esnext\\\"],\\\"allowJs\\\":true,\\\"skipLibCheck\\\":true,\\\"strict\\\":true,\\\"noEmit\\\":true,\\\"esModuleInterop\\\":true,\\\"module\\\":\\\"esnext\\\",\\\"moduleResolution\\\":\\\"bundler\\\",\\\"resolveJsonModule\\\":true,\\\"isolatedModules\\\":true,\\\"jsx\\\":\\\"preserve\\\",\\\"incremental\\\":true,\\\"plugins\\\":[{\\\"name\\\":\\\"next\\\"}],\\\"paths\\\":{\\\"@/*\\\":[\\\"./*\\\"]}},\\\"include\\\":[\\\"next-env.d.ts\\\",\\\"**/*.ts\\\",\\\"**/*.tsx\\\",\\\".next/types/**/*.ts\\\"],\\\"exclude\\\":[\\\"node_modules\\\",\\\"reference\\\"]}\nEOF\ncat > next.config.ts <<'EOF'\nimport type { NextConfig } from 'next';\nconst config: NextConfig = {\n  poweredByHeader: false,\n  outputFileTracingIncludes: {'/api/artwork/*': ['./public/fonts/IBMPlexMono-Regular.ttf']},\n  async headers() { return [{source:'/(.*)',headers:[{key:'X-Content-Type-Options',value:'nosniff'},{key:'Referrer-Policy',value:'strict-origin-when-cross-origin'},{key:'X-Frame-Options',value:'DENY'},{key:'Permissions-Policy',value:'camera=(), microphone=(), geolocation=()'}]}]; }\n};\nexport default config;\nEOF\ncat > lib/catalog.ts <<'EOF'\nimport { z } from 'zod';\nexport const SIZES = ['S', 'M', 'L', 'XL'] as const;\nexport const PRICE = 3000;\nexport const SHIPPING = 600;\nexport const catalog = {\n  unisex: {name:'Unisex', sku:'GLOBAL-TEE-BC-3001', model:'Bella+Canvas 3001', description:'A classic, easy fit. Soft ring-spun cotton, a crew neck, and room to move.', material:'100% combed, ring-spun cotton', chest:[34,38,43,46],length:[28,29,30,31]},\n  fitted: {name:'Fitted', sku:'GLOBAL-TEE-BC-6004', model:'Bella+Canvas 6004', description:'A closer silhouette with a shaped waist and shorter sleeves. Size up for a little more room.', material:'Cotton blend; composition varies by supply region',chest:[30,32,34,36],length:[26.25,26.75,27.375,28]}\n} as const;\nexport const orderSchema = z.object({fit:z.enum(['unisex','fitted']),size:z.enum(SIZES),timestamp:z.number().int().min(1000000000000).max(9999999999999),requestId:z.uuid()}).strict();\nexport type Fit = keyof typeof catalog;\nexport function formatMoment(timestamp:number) {return new Intl.DateTimeFormat('en-US',{month:'long',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit',second:'2-digit',timeZone:'UTC',hour12:false}).format(timestamp)+' UTC';}\nexport function money(cents:number) {return new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:2}).format(cents/100);}\nEOF\ncat > app/layout.tsx <<'EOF'\nimport type {Metadata} from 'next';\nimport './globals.css';\nexport const metadata:Metadata={title:'datetime.store — Wear this very moment.',description:'A timestamp. A t-shirt. Yours. Capture the current moment on a black, made-to-order tee.',metadataBase:new URL(process.env.APP_URL || 'http://localhost:3000'),openGraph:{title:'Wear this very moment. — datetime.store',description:'A timestamp. A t-shirt. Yours.',type:'website'},twitter:{card:'summary_large_image'}};\nexport default function RootLayout({children}:{children:React.ReactNode}) {return <html lang=\\\"en\\\"><body>{children}</body></html>}\nEOF\ncat > app/page.tsx <<'EOF'\nimport Store from './store';\nexport default function Page(){return <Store sandbox={process.env.SHOP_MODE \"'!== '\"'live'}/>}\nEOF\ncat > app/store.tsx <<'EOF'\n'use client';\nimport {useEffect,useRef,useState} from 'react';\nimport {ArrowUpRight,ArrowRight,Clock3,Plus,Check,LockKeyhole,X,Package,RotateCcw} from 'lucide-react';\nimport {catalog,SIZES,PRICE,SHIPPING,Fit,money,formatMoment} from '@/lib/catalog';\nexport default function Store({sandbox}:{sandbox:boolean}) {\n const [now,setNow]=useState<number|null>(null),[fit,setFit]=useState<Fit>('unisex'),[size,setSize]=useState('M'),[captured,setCaptured]=useState<number|null>(null),[modal,setModal]=useState<'size'|'capture'|null>(null),[busy,setBusy]=useState(false),[error,setError]=useState(''),[view,setView]=useState<'front'|'detail'>('front'),[cancelled,setCancelled]=useState(false);\n const dialog=useRef<HTMLDialogElement>(null),requestId=useRef('');\n useEffect(()=>{setNow(Date.now());const timer=setInterval(()=>setNow(Date.now()),47);setCancelled(new URLSearchParams(location.search).has('cancelled'));return()=>clearInterval(timer)},[]);\n useEffect(()=>{if(modal)dialog.current?.showModal();else dialog.current?.close()},[modal]);\n function capture(){const stamp=Date.now();setCaptured(stamp);requestId.current=crypto.randomUUID();setError('');setModal('capture')}\n async function checkout(){setBusy(true);setError('');try{const r=await fetch('/api/checkout',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({fit,size,timestamp:captured,requestId:requestId.current})});const data=await r.json();if(\"'!r.ok)throw new Error(data.error||'\"'Checkout is temporarily unavailable. Please try again.');location.assign(data.url)}catch(e){setError(e instanceof Error?e.message:'Please try again.');setBusy(false)}}\n const stamp=captured&&modal==='capture'?captured:now;\n return <><a className=\\\"skip\\\" href=\\\"#shop\\\">Skip to shop</a>{sandbox&&<div className=\\\"sandbox-bar\\\"><span className=\\\"sandbox-dot\\\"/> Sandbox shop <span className=\\\"sandbox-separator\\\">/</span> Test payments only. No shirts will be shipped.</div>}\n <header className=\\\"header\\\"><a className=\\\"wordmark\\\" href=\\\"/\\\">datetime<span className=\\\"brand-dot\\\">.</span>store<sup>®</sup></a><nav aria-label=\\\"Main navigation\\\"><a href=\\\"#how-it-works\\\">The idea</a><a href=\\\"#details\\\">The details</a><a href=\\\"#faq\\\">Good questions <ArrowUpRight size={13}/></a></nav><span className=\\\"header-note\\\"><span className=\\\"live-dot\\\"/> MADE FOR RIGHT NOW</span></header>\n <main><section className=\\\"intro\\\"><div className=\\\"eyebrow\\\"><span className=\\\"tiny-cross\\\">+</span> AN ONGOING EDITION OF ONE</div><div className=\\\"intro-line\\\"><h1>Wear this<br/><span>very moment.</span></h1><p>We sell a T-shirt with the current datetime.<br/>Not yesterday. Not someday.<br/><strong>The exact moment you make it yours.</strong></p></div></section>\n {cancelled&&<div className=\\\"cancel-notice\\\" role=\\\"status\\\">Checkout cancelled. Nothing was charged. Your next moment is waiting. <button onClick={()=>setCancelled(false)} aria-label=\\\"Dismiss cancellation notice\\\"><X size={16}/></button></div>}\n <section className=\\\"shop\\\" id=\\\"shop\\\" aria-label=\\\"Customize your timestamp T-shirt\\\"><div className=\\\"product-stage\\\"><div className=\\\"stage-top\\\"><span>OBJECT NO. 001</span><span><span className=\\\"live-dot\\\"/> {modal==='capture'?'MOMENT CAPTURED':'LIVE PREVIEW'}</span></div>\n {view==='front'?<div className={\"'`shirt-wrap ${fit}`}><img className=\"shirt-image\" src={`/shirt-${fit}.svg`} alt={`Black ${fit} T-shirt with your Unix timestamp printed in white`} width=\"600\" height=\"650\"/><span className=\"shirt-print\" aria-hidden=\"true\">{stamp||'\"'0000000000000'}</span></div>:<div className=\\\"detail-photo\\\"><img src=\\\"/shirt-detail.webp\\\" alt=\\\"Close view of the black Bella+Canvas unisex tee fabric and crew neck\\\"/><span>Fabric reference · Unisex fit</span></div>}\n <div className=\\\"stage-bottom\\\"><div className=\\\"view-switch\\\"><button aria-pressed={view==='front'} onClick={()=>setView('front')}>01 <span>Front</span></button><button aria-pressed={view==='detail'} onClick={()=>setView('detail')}>02 <span>On body</span></button></div><span className=\\\"preview-note\\\">{view==='front'?'DIGITAL MOCKUP · PLACEMENT APPROXIMATE':'GARMENT REFERENCE'}</span></div></div>\n <div className=\\\"product-controls\\\"><div className=\\\"product-heading\\\"><div><span className=\\\"eyebrow\\\">THE ORIGINAL</span><h2>The datetime tee</h2></div><span className=\\\"price\\\">{money(PRICE)}<small>USD</small></span></div><p className=\\\"product-description\\\">One black tee. Thirteen digits. A tiny piece of time, made tangible.</p><div className=\\\"live-readout\\\"><div><span className=\\\"live-dot\\\"/><span>{modal==='capture'?'YOUR CAPTURED MOMENT':'THE MOMENT, RIGHT NOW'}</span><Clock3 size={14}/></div><span className=\\\"time-value\\\" aria-label=\\\"Live Unix timestamp in milliseconds\\\">{stamp||'0000000000000'}</span><small>Milliseconds since January 1, 1970.</small></div>\n <fieldset><legend>01 <span>Choose your fit</span></legend><div className=\\\"fit-options\\\">{(Object.keys(catalog) as Fit[]).map(f=><button key={f} aria-pressed={fit===f} onClick={()=>setFit(f)}>{catalog[f].name}{fit===f&&<Check size={16}/>}</button>)}</div><p className=\\\"fit-help\\\">{catalog[fit].description}</p></fieldset>\n <fieldset><legend>02 <span>Choose your size</span></legend><button className=\\\"size-guide\\\" onClick={()=>setModal('size')}>Size guide <ArrowUpRight size={13}/></button><div className=\\\"size-options\\\">{SIZES.map(s=><button key={s} aria-pressed={size===s} onClick={()=>setSize(s)}>{s}</button>)}</div></fieldset>\n <div className=\\\"color-row\\\"><span>Color</span><span><i/> Black / white print</span></div><button className=\\\"capture-button\\\" onClick={capture}><span>Capture this moment</span><ArrowUpRight size={21}/></button><p className=\\\"button-help\\\">Your timestamp freezes when you click. It’s yours to keep.</p><div className=\\\"trust-row\\\"><span><LockKeyhole size={13}/> Secure checkout</span><span><Package size={14}/> Made to order</span></div><p className=\\\"shipping-note\\\">US shipping {money(SHIPPING)} · Total {money(PRICE+SHIPPING)} before any applicable tax</p></div></section>\n <section className=\\\"idea\\\" id=\\\"how-it-works\\\"><div className=\\\"eyebrow\\\">TIME DOESN’T REPEAT ITSELF.</div><h2>Neither does your tee.</h2><div className=\\\"steps\\\"><article><span>01 /</span><h3>Watch it happen.</h3><p>The number on your tee is alive. Every millisecond is a moment you’ll never get back.</p></article><article><span>02 /</span><h3>Make it stop.</h3><p>Choose your fit and size, then hit capture. That exact timestamp becomes your design.</p></article><article><span>03 /</span><h3>Take it with you.</h3><p>We print your moment onto a black tee, just for you. An ordinary shirt. An unrepeatable time.</p></article></div></section>\n <section className=\\\"details-section\\\" id=\\\"details\\\"><div><span className=\\\"eyebrow\\\">NOTHING EXTRA. JUST THE GOOD STUFF.</span><h2>A little less,<br/>a little more meaning.</h2></div><div className=\\\"spec-list\\\"><div><span>The canvas</span><p>Bella+Canvas tees. Unisex or fitted.<br/>Black, because the moment is the point.</p></div><div><span>The print</span><p>Crisp white type, printed directly onto the garment. Your thirteen digits, front and center.</p></div><div><span>The process</span><p>Made individually after you order, fulfilled by Prodigi. No pile of pre-printed moments.</p></div><div><span>The care</span><p>Wash inside out on a cool cycle. Hang dry. Give your moment a little more time.</p></div></div></section>\n <section className=\\\"faq-section\\\" id=\\\"faq\\\"><div><span className=\\\"eyebrow\\\">A FEW GOOD QUESTIONS</span><h2>Wait a second.</h2></div><div className=\\\"faq-list\\\">{[\n ['What do the numbers mean?','They’re a Unix timestamp: the number of milliseconds elapsed since January 1, 1970 at 00:00:00 UTC. Every place on Earth shares the same timestamp for a given instant. A universal little souvenir.'],\n ['When is my timestamp captured?','The instant you press “Capture this moment.” You can review it before continuing to Stripe. It stays frozen through checkout and is the exact number sent to the printer. Cancel the review to catch a new moment.'],\n ['Can I choose a date in the past?','This edition is about right now. The timestamp is captured live; custom dates aren’t available.'],\n ['Where do you ship, and how long does it take?',sandbox?'This sandbox accepts US addresses for testing. Nothing is manufactured or shipped. For a live launch, allow roughly 3–5 business days for printing plus shipping time; delivery estimates need to be confirmed with the printer.':'We currently ship within the United States. Each tee is made to order. Printing typically takes 3–5 business days; shipping time is additional and varies by destination.'],\n ['What if there’s a problem with my order?','Keep the private order-status link shown after checkout. It displays payment and fulfillment progress. This is a sandbox storefront; a customer support address and final returns policy must be published before real orders open.'],\n ['Is this a real purchase?',sandbox?'This is a working sandbox. Stripe takes test payments and Prodigi receives sandbox print orders. Use card 4242 4242 4242 4242 with a future expiry and any three-digit CVC. No money moves and no shirt is shipped.':'Yes. Checkout is securely handled by Stripe, and your tee is printed to order by Prodigi.']\n ].map(([q,a])=><details key={q}><summary>{q}<Plus size={17}/></summary><p>{a}</p></details>)}</div></section>\n <div className=\\\"closing\\\"><span>YOU ARE HERE. IT IS NOW.</span><a href=\\\"#shop\\\">Make a moment of it. <ArrowUpRight size={30}/></a></div></main>\n <footer><a className=\\\"wordmark\\\" href=\\\"/\\\">datetime<span className=\\\"brand-dot\\\">.</span>store</a><span>A timestamp. A T-shirt. Yours.</span><div><a href=\\\"/policies\\\">Shop policies</a><span>© {new Date().getFullYear()} datetime.store</span></div></footer>\n <dialog ref={dialog} onCancel={e=>{if(busy)e.preventDefault();else setModal(null)}} onClick={e=>{if(e.target===dialog.current&&\"'!busy)setModal(null)}}><div className=\"modal-content\"><button className=\"modal-close\" disabled={busy} onClick={()=>setModal(null)} aria-label=\"Close dialog\"><X size={20}/></button>{modal==='\"'size'?<><span className=\\\"eyebrow\\\">FIND YOUR EVERYDAY FIT</span><h2>{catalog[fit].name} size guide</h2><p>{catalog[fit].model}. Measurements in inches. Compare with a tee you love; allow for manufacturing variation.</p><table><thead><tr><th>Size</th><th>Chest around</th><th>Length</th></tr></thead><tbody>{SIZES.map((s,i)=><tr key={s}><th>{s}</th><td>{catalog[fit].chest[i]}″</td><td>{catalog[fit].length[i]}″</td></tr>)}</tbody></table><p className=\\\"muted\\\">{fit==='fitted'?'A slim, women’s cut. Consider sizing up.':'A classic unisex cut with a tailored shape.'}</p><button className=\\\"capture-button\\\" onClick={()=>setModal(null)}>Got it <Check size={18}/></button></>:<><span className=\\\"eyebrow\\\"><span className=\\\"live-dot\\\"/> MOMENT CAPTURED</span><h2>That one is yours.</h2><p>The world kept moving. This number didn’t.</p><div className=\\\"captured-number\\\">{captured}</div><p className=\\\"captured-date\\\">{captured?formatMoment(captured):''}</p><div className=\\\"review-lines\\\"><div><span>The datetime tee · {catalog[fit].name} · {size}</span><span>{money(PRICE)}</span></div><div><span>US shipping</span><span>{money(SHIPPING)}</span></div><div><strong>Total before tax</strong><strong>{money(PRICE+SHIPPING)}</strong></div></div>{sandbox&&<div className=\\\"test-note\\\">Sandbox checkout · Use test card <strong>4242 4242 4242 4242</strong>, a future expiry, and any CVC. No charge or shipment.</div>}{error&&<p className=\\\"error\\\" role=\\\"alert\\\">{error}</p>}<button className=\\\"capture-button\\\" disabled={busy} onClick={checkout}>{busy?'Preparing your checkout…':'Continue to checkout'}{\"'!busy&&<ArrowRight size={20}/>}</button><button className=\"recapture\" disabled={busy} onClick={()=>setModal(null)}><RotateCcw size={13}/> Catch another moment</button><p className=\"button-help\">By continuing, you agree to our <a href=\"/policies\">shop policies</a>.</p></>}</div></dialog></>;\n}\nEOF\ncat > app/globals.css <<'