p>{order.orderId?\"'`Prodigi reference: ${order.orderId}`:'\"'If the printer is busy, we’ll retry automatically.'}</p></div></div><div className=\\\"status-row\\\"><Clock3 size={21} className=\\\"status-icon\\\"/><div><h3>{order.stage==='Complete'?'Fulfillment complete':order.issues?'Printer needs attention':order.orderId?'Print order received':'Your moment is safely saved'}</h3><p>{order.sandbox?'Sandbox simulation. No physical fulfillment.':\"'`Status: ${order.stage}.`}</p></div></div>{order.tracking.map((t,i)=><p key={i}>{t.url&&/''^https:'\"\\\\/\\\\//.test(t.url)?<a href={t.url} rel=\\\"noopener noreferrer\\\" target=\\\"_blank\\\">Track your shipment <ArrowUpRight size={12}/></a>:t.number}</p>)}{paid&&\"'!order.orderId&&<button className=\"capture-button\" disabled={retrying} onClick={retry}>{retrying?'\"'Checking with the printer…':'Check print submission'}<ArrowUpRight size={18}/></button>}</div><p className=\\\"private-note\\\">Bookmark this page to return to your order. This link is private; anyone with it can see this order’s status. No address or payment details are displayed.</p></>}<a className=\\\"capture-button\\\" href=\\\"/\\\">{paid?'Catch another moment':'Return to the shop'}<ArrowUpRight size={19}/></a></main></>}\nEOF\ncat > app/policies/page.tsx <<'EOF'\nimport type {Metadata} from 'next';\nexport const metadata:Metadata={title:'Shop policies — datetime.store',description:'Sandbox shop policies, privacy, shipping, and returns.'};\nexport default function Policies(){return <><header className=\\\"header\\\"><a className=\\\"wordmark\\\" href=\\\"/\\\">datetime<span className=\\\"brand-dot\\\">.</span>store</a><a href=\\\"/\\\">Back to the shop ↗</a></header><main className=\\\"policy-shell\\\"><span className=\\\"eyebrow\\\">CLEAR FROM THE START</span><h1>Shop policies.</h1><h2>This is a sandbox shop.</h2><p>This environment demonstrates a complete test checkout and print-on-demand workflow. Payments use Stripe test mode and print orders use Prodigi’s sandbox. No money is collected and no physical goods are manufactured or shipped. Please use fictional contact and shipping information.</p><h2>Your moment</h2><p>Your timestamp freezes when you click “Capture this moment.” Review the timestamp, style, size, and total before continuing. The same timestamp becomes the print artwork. Rendered previews illustrate placement; actual print size and fabric appearance may vary.</p><h2>Pricing and shipping</h2><p>The demo price is \"'$30 USD for one tee plus $6 US shipping. Only US shipping addresses are accepted. Tax calculation is disabled in this sandbox. There is no actual delivery schedule for test orders.</p><h2>Privacy</h2><p>Stripe processes your checkout and stores the email address, billing and shipping details you provide. The application passes the shipping recipient and artwork to Prodigi to fulfill the test order. Card details are handled on Stripe’s hosted checkout and never reach this application. Order status is accessed through a private, unguessable link; keep it private. This site uses no marketing cookies or advertising analytics.</p><h2>Returns and customer support</h2><p>No return or refund is needed for a sandbox purchase. Before accepting real orders, the shop operator must publish a customer support contact, business identity, shipping estimates, a final returns and cancellation policy, and a data retention policy. This environment is not open for real purchases.</p><p><a href=\"/\">← Return to your moment</a></p></main></>}\nEOF\npython3 - <<'\"'PY'\np='app/layout.tsx';s=open(p).read().replace(\\\"type:'website'\\\",\\\"type:'website',images:[{url:'/og.png',width:1536,height:1024,alt:'Wear this very moment. A timestamp. A t-shirt. Yours.'}]\\\").replace(\\\"card:'summary_large_image'\\\",\\\"card:'summary_large_image',images:['/og.png']\\\");open(p,'w').write(s)\nPY\nnpm run build\"","aggregated_output":"\n> datetime-store@1.0.0 build\n> next build\n\n   ▲ Next.js 15.5.25\n   - Environments