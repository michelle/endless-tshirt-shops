cing varies per region.\",\n              \"enum\": [\n                \"aws-us-west-2\",\n                \"aws-us-east-2\",\n                \"aws-us-east-1\",\n                \"aws-eu-west-1\",\n                \"aws-eu-west-2\",\n                \"aws-eu-central-1\",\n                \"aws-ap-southeast-1\",\n                \"aws-ap-southeast-2\",\n                \"aws-ap-northeast-1\",\n                \"aws-ap-south-1\",\n                \"aws-ca-central-1\",\n                \"aws-ap-northeast-2\",\n                \"aws-il-central-1\",\n                \"gcp-us-east1\",\n                \"gcp-us-central1\",\n                \"gcp-europe-west2\",\n                \"gcp-europe-west4\",\n                \"gcp-asia-southeast1\",\n                \"gcp-asia-northeast1\",\n                \"azure-germanywestcentral\",\n                \"azure-eastus2\",\n                \"azure-westus3\"\n              ]\n            },\n            \"minReplicaMemoryGb\": {\n              \"type\": \"integer\",\n              \"description\": \"Autoscale lower bound: memory per replica, in GiB. Must be ≤ maxReplicaMemoryGb (enforced server-side). Accepts 8–356 GiB per replica in steps of 4; the maximum drops to 236 GiB on AWS regions due to UI caps.\",\n              \"minimum\": 8,\n              \"maximum\": 356,\n              \"multipleOf\": 4,\n              \"default\": 12\n            },\n            \"maxReplicaMemoryGb\": {\n              \"type\": \"integer\",\n              \"description\": \"Autoscale upper bound: memory per replica, in GiB. Must be ≥ minReplicaMemoryGb (enforced server-side). Accepts 8–356 GiB per replica in steps of 4; the maximum drops to 236 GiB on AWS regions due to UI caps.\",\n              \"minimum\": 8,\n              \"maximum\": 356,\n              \"multipleOf\": 4,\n              \"default\": 12\n            },\n            \"numReplicas\": {\n              \"type\": \"integer\",\n              \"description\": \"Number of replicas (HA