{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/zsh -lc \"cat > tests/orders.test.ts <<'EOF'\nimport test from 'node:test';\nimport assert from 'node:assert/strict';\nimport Stripe from 'stripe';\nimport sharp from 'sharp';\nimport {orderSchema} from '../lib/catalog';\nimport {printRequest,validatePaidOrder} from '../lib/fulfillment';\nimport {artwork} from '../lib/artwork';\nprocess.env.SHOP_MODE='sandbox';process.env.APP_URL='https://example.com';\nconst paid=():Stripe.Checkout.Session=>({id:'cs_test_example',status:'complete',payment_status:'paid',currency:'usd',amount_subtotal:3000,amount_total:3600,shipping_cost:{amount_total:600},total_details:{amount_tax:0},livemode:false,metadata:{shop:'datetime.store',fit:'unisex',size:'M',timestamp:'1788566400123',sku:'GLOBAL-TEE-BC-3001',artworkVersion:'1',shopMode:'sandbox'},collected_information:{shipping_details:{name:'Sandbox Test',address:{line1:'123 Test Street',line2:null,city:'San Francisco',state:'CA',postal_code:'94107',country:'US'}}},customer_details:{email:'test@example.com'}} as Stripe.Checkout.Session);\ntest('reject client-controlled price, invalid sizes, and missing request identity',()=>{const value={fit:'unisex',size:'M',timestamp:Date.now(),requestId:crypto.randomUUID()};assert(orderSchema.safeParse(value).success);assert(\"'!orderSchema.safeParse({...value,price:1}).success);assert(!orderSchema.safeParse({...value,size:'\"'XXS'}).success);assert(\"'!orderSchema.safeParse({...value,requestId:'\"'x'}).success)});\ntest('refuse unpaid, wrong total, wrong environment and wrong SKU fulfillment',()=>{for(const patch of [{payment_status:'unpaid'},{status:'open'},{amount_total:1},{livemode:true},{shipping_cost:{amount_total:0}},{metadata:{...paid().metadata,sku:'OTHER'}}]){assert.throws(()=>validatePaidOrder({...paid(),...patch} as Stripe.Checkout.Session))}});\ntest('fulfillment uses shipping address, exact timestamp and stable deduplication identity',()=>{const session=paid();const a=printRequest(session),b=printRequest(session);assert.equal(a.idempotencyKey,b.idempotencyKey);assert.equal(a.items[0].assets[0].url,'https://example.com/api/artwork/1788566400123.png');assert.equal(a.recipient.address.postalOrZipCode,'94107');assert.equal(a.items[0].attributes.size,'m');assert.equal(a.items[0].sku,'GLOBAL-TEE-BC-3001');assert.notEqual(a.idempotencyKey,printRequest({...session,id:'cs_test_other'}).idempotencyKey)});\ntest('refuse unsupported shipping destinations',()=>{const session=paid();session.collected_information\"'!.shipping_details!.address!.country='\"'GB';assert.throws(()=>printRequest(session))});\ntest('generate deterministic transparent print artwork at 300 DPI',async()=>{const a=await artwork('1788566400123');const b=await artwork('1788566400123');assert.deepEqual(a,b);const metadata=await sharp(a).metadata();assert.equal(metadata.width,4677);assert.equal(metadata.height,5881);assert.equal(metadata.density,300);assert.equal(metadata.hasAlpha,true);const stats=await sharp(a).stats();assert(stats.channels[3].min===0);assert(stats.channels[3].max===255);assert.notDeepEqual(a,await artwork('1788566400124'));await assert.rejects(artwork('<bad>'))});\nEOF\npython3 - <<'PY'\np='lib/catalog.ts';s=open(p).read().replace('chest:[30,32,34,36]','chest:[32,33.5,35.5,37.5]').replace('length:[26.25,26.75,27.375,28]','length:[26.25,26.75,27.375,28]');open(p,'w').write(s)\nPY\nnpm test && npm run build\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
