{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/zsh -lc \"node --env-file=.env.local --input-type=module <<'JS'\nimport fs from 'node:fs';import Stripe from 'stripe';import {spawnSync} from 'node:child_process';\nconst removed=spawnSync('vercel',['env','rm','APP_URL','production','--yes'],{encoding:'utf8'});if(removed.status)throw new Error(removed.stderr);const added=spawnSync('vercel',['env','add','APP_URL','production'],{input:process.env.APP_URL,encoding:'utf8'});if(added.status)throw new Error(added.stderr);console.log('Updated APP_URL');\nconst ep=JSON.parse(fs.readFileSync('docs/stripe-webhook.json','utf8'));ep.url=process.env.APP_URL+'/api/webhooks/stripe';await new Stripe(process.env.STRIPE_SECRET_KEY).webhookEndpoints.update(ep.id,{url:ep.url});fs.writeFileSync('docs/stripe-webhook.json',JSON.stringify(ep,null,2));console.log('Updated Stripe webhook URL');\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
