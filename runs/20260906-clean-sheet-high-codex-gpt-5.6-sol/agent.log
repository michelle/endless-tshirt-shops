n  \"sampleVariants\": [\n    {\n      \"attributes\": {\n        \"brand\": \"Gildan\",\n        \"edge\": \"Crew neck\",\n        \"color\": \"azalea\",\n        \"gender\": \"Unisex\",\n        \"paperType\": \"100% cotton\",\n        \"size\": \"2xl\",\n        \"style\": \"5000\"\n      },\n      \"shipsTo\": [\n        \"AT\",\n        \"BE\",\n        \"CH\",\n        \"CY\",\n        \"CZ\",\n        \"DE\",\n        \"DK\",\n        \"EE\",\n        \"ES\",\n        \"FI\",\n        \"FR\",\n        \"GB\",\n        \"GR\",\n        \"HR\",\n        \"HU\",\n        \"IE\",\n        \"IS\",\n        \"IT\",\n        \"LT\",\n        \"LU\",\n        \"LV\",\n        \"MT\",\n        \"NL\",\n        \"NO\",\n        \"PL\",\n        \"PT\",\n        \"SE\",\n        \"SI\",\n        \"SK\",\n        \"TR\"\n      ]\n    },\n    {\n      \"attributes\": {\n        \"brand\": \"Gildan\",\n        \"edge\": \"Crew neck\",\n        \"color\": \"azalea\",\n        \"gender\": \"Unisex\",\n        \"paperType\": \"100% cotton\",\n        \"size\": \"2xl\",\n        \"style\": \"5000\"\n      },\n      \"shipsTo\": [\n        \"AE\",\n        \"AL\",\n        \"AM\",\n        \"AR\",\n        \"AT\",\n        \"AU\",\n        \"AZ\",\n        \"BA\",\n        \"BB\",\n        \"BD\",\n        \"BE\",\n        \"BG\",\n        \"BH\",\n        \"BM\",\n        \"BO\",\n        \"BR\",\n        \"BS\",\n        \"BY\",\n        \"CA\",\n        \"CH\",\n        \"CI\",\n        \"CL\",\n        \"CN\",\n        \"CO\",\n        \"CR\",\n        \"CY\",\n        \"CZ\",\n        \"DE\",\n        \"DK\",\n        \"DO\",\n        \"EC\",\n        \"EE\",\n        \"EG\",\n        \"ES\",\n        \"FI\",\n        \"FR\",\n        \"GB\",\n        \"GE\",\n        \"GG\",\n        \"GH\",\n        \"GI\",\n        \"GR\",\n        \"HK\",\n        \"HN\",\n        \"HR\",\n        \"HU\",\n        \"ID\",\n        \"IE\",\n        \"IL\",\n        \"IM\",\n        \"IN