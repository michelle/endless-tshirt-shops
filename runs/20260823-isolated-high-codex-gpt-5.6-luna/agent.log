{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc 'SP_AUTH=\"$SP_AUTH\" /Users/michelle/.nodenv/versions/20.18.0/bin/node <<'\"'NODE'\nconst sharp = require('sharp');\nconst key = process.env.SP_AUTH;\nconst headers = {Authorization: \"'`Basic ${Buffer.from(`:${key}`).toString('\"'base64')}\"'`};\nconst svg = '\"'<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"1200\\\" height=\\\"900\\\"><rect width=\\\"1200\\\" height=\\\"900\\\" fill=\\\"none\\\"/><text x=\\\"600\\\" y=\\\"450\\\" text-anchor=\\\"middle\\\" fill=\\\"white\\\" font-family=\\\"Arial\\\" font-size=\\\"120\\\">datetime.store</text></svg>';\nconst png = await sharp(Buffer.from(svg)).png().toBuffer();\nconst form = new FormData();\nform.append('type', 'dtg');\nform.append('sides[front][artwork]', new Blob([png], {type: 'image/png'}), 'verify.png');\nform.append('sides[front][dimensions][width]', '8');\nform.append('sides[front][position][horizontal]', 'C');\nform.append('sides[front][position][offset][top]', '3');\nlet response = await fetch('https://api.scalablepress.com/v2/design', {method:'POST', headers, body:form});\nlet design = await response.json();\nconsole.log('design', response.status, JSON.stringify({statusCode: design.statusCode, designId: design.designId, message: design.message}));\nif (\"'!design.designId) process.exit(1);\nresponse = await fetch('\"'https://api.scalablepress.com/v2/quote', {method:'POST', headers:{...headers,'Content-Type':'application/json'}, body:JSON.stringify({type:'dtg',products:[{id:'next-level-boyfriend-tee',color:'Black',quantity:1,size:'med'}],designId:design.designId,address:{name:'Test Buyer',address1:'185 Berry St',city:'San Francisco',state:'CA',zip:'94107',country:'US'}})});\nconst quote = await response.json();\nconsole.log('quote', response.status, JSON.stringify({statusCode:quote.statusCode, orderToken:quote.orderToken, orderIssues:quote.orderIssues, message:quote.message}));\nNODE\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
