#!/usr/bin/env bash
# Run one model benchmark in a dedicated, reviewable Git branch.
set -uo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/run-benchmark --adapter codex|claude --model MODEL [options] [-- ADAPTER_ARGS...]

Options:
  --run-id ID          Unique, branch-safe run ID (default: UTC timestamp + adapter + model)
  --suite-id ID        Identifier shared by every run in one comparison suite
  --prompt-file FILE   Repository-contained prompt file (default: prompt.md)
  --timeout SECONDS    Hard timeout in seconds (default: 3600)
  --reasoning-effort LEVEL
                      Optional provider reasoning level (low, medium, high, xhigh, or max)
  -h, --help           Show this help

The runner requires PRODIGI_API_KEY, Stripe CLI, a clean repository, an origin remote,
and either timeout or gtimeout. It appends the completed run to
benchmark-results, then returns to the branch that was checked out when it
started. Each run receives a separate local Stripe CLI config under
.benchmark-secrets/stripe/; it is never committed.
EOF
}

die() { printf 'error: %s\n' "$*" >&2; exit 2; }
note() { printf '%s\n' "$*" >&2; }

json_string() {
  local value=${1-}
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  value=${value//$'\t'/\\t}
  printf '"%s"' "$value"
}

sanitize_id() {
  local value=$1
  value=$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9._-' '-')
  value=${value#-}
  value=${value%-}
  printf '%s' "$value"
}

vercel_project_name() {
  # Vercel project names are capped at 100 characters. Keep a stable prefix
  # and leave the run ID visible for easy identification in the dashboard. A
  # hash suffix preserves uniqueness when an unusually long run ID is clipped.
  local run_id=$1
  if (( ${#run_id} <= 90 )); then
    printf 'benchmark-%s' "$run_id"
  else
    printf 'benchmark-%.80s-%s' "$run_id" "$(printf '%s' "$run_id" | shasum -a 256 | cut -c1-8)"
  fi
}

extract_url() {
  grep -Eo 'https://[^[:space:]"'"'"'<>]+' "$1" 2>/dev/null | grep -E 'vercel\.app|vercel\.sh' | tail -n 1 || true
}

assert_no_staged_secrets() {
  local value variable
  for variable in PRODIGI_API_KEY STRIPE_SECRET_KEY STRIPE_PUBLISHABLE_KEY STRIPE_WEBHOOK_SECRET VERCEL_TOKEN; do
    value=${!variable-}
    if [[ -n $value ]] && git grep --cached -n -F -- "$value" -- "runs/$RUN_ID" >/dev/null 2>&1; then
      die "a value from $variable is staged; refusing to commit"
    fi
  done
  if git grep --cached -n -E -- '\b(sk|pk|rkcs|rk)_(test|live)_[A-Za-z0-9_=-]+|\bwhsec_[A-Za-z0-9_=-]+|\b(test|live)_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b' -- "runs/$RUN_ID" >/dev/null 2>&1; then
    die "a provider secret pattern is staged; refusing to commit"
  fi
}

ADAPTER=
MODEL=
RUN_ID=
SUITE_ID=
PROMPT_FILE_ARG=prompt.md
TIMEOUT_SECONDS=3600
REASONING_EFFORT=
EXTRA_ARGS=()

while (($#)); do
  case $1 in
    --adapter) ADAPTER=${2-}; shift 2 ;;
    --model) MODEL=${2-}; shift 2 ;;
    --run-id) RUN_ID=${2-}; shift 2 ;;
    --suite-id) SUITE_ID=${2-}; shift 2 ;;
    --prompt-file) PROMPT_FILE_ARG=${2-}; shift 2 ;;
    --timeout) TIMEOUT_SECONDS=${2-}; shift 2 ;;
    --reasoning-effort) REASONING_EFFORT=${2-}; shift 2 ;;
    --) shift; EXTRA_ARGS=("$@"); break ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

[[ $ADAPTER == codex || $ADAPTER == claude ]] || die "--adapter must be codex or claude"
[[ -n $MODEL ]] || die "--model is required"
[[ $TIMEOUT_SECONDS =~ ^[1-9][0-9]*$ ]] || die "--timeout must be a positive integer"
[[ -z $REASONING_EFFORT || $REASONING_EFFORT =~ ^(low|medium|high|xhigh|max)$ ]] || die "--reasoning-effort must be low, medium, high, xhigh, or max"
[[ -n $PROMPT_FILE_ARG ]] || die "--prompt-file must not be empty"
[[ -n ${PRODIGI_API_KEY-} ]] || die "PRODIGI_API_KEY must be set to a Prodigi API key"

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || die "run this from inside the benchmark repository"
cd "$REPO_ROOT"
if [[ $PROMPT_FILE_ARG == /* ]]; then
  PROMPT_CANDIDATE=$PROMPT_FILE_ARG
else
  PROMPT_CANDIDATE="$REPO_ROOT/$PROMPT_FILE_ARG"
fi
[[ -f $PROMPT_CANDIDATE && ! -L $PROMPT_CANDIDATE ]] || die "prompt file is not a regular file: $PROMPT_FILE_ARG"
PROMPT_DIR=$(cd -P "$(dirname "$PROMPT_CANDIDATE")" 2>/dev/null && pwd) || die "could not resolve prompt file: $PROMPT_FILE_ARG"
PROMPT_FILE="$PROMPT_DIR/$(basename "$PROMPT_CANDIDATE")"
[[ $PROMPT_FILE == "$REPO_ROOT/"* ]] || die "prompt file must be inside the repository: $PROMPT_FILE_ARG"
PROMPT_REF=${PROMPT_FILE#"$REPO_ROOT/"}
[[ -z $(git status --porcelain --untracked-files=all) ]] || die "repository is dirty; commit or stash changes before starting a run"
BASE_BRANCH=$(git symbolic-ref --quiet --short HEAD) || die "a named branch must be checked out"
BASE_COMMIT=$(git rev-parse HEAD)
git remote get-url origin >/dev/null 2>&1 || die "origin remote is required"

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ADAPTER_PATH="$SCRIPT_DIR/adapters/$ADAPTER"
[[ -x $ADAPTER_PATH ]] || die "adapter is not executable: $ADAPTER_PATH"
command -v node >/dev/null 2>&1 || die "Node.js 20.11+ is required for transcript capture"
node -e 'const [major, minor] = process.versions.node.split(".").map(Number); if (major < 20 || (major === 20 && minor < 11)) process.exit(1)' || die "Node.js 20.11+ is required"
command -v "$ADAPTER" >/dev/null 2>&1 || die "$ADAPTER CLI is not installed or not on PATH"
STRIPE_REAL=$(command -v stripe) || die "Stripe CLI is not installed or not on PATH"
TIMEOUT_COMMAND=$(command -v timeout || command -v gtimeout || true)
[[ -n $TIMEOUT_COMMAND ]] || die "install GNU coreutils (timeout/gtimeout) to enforce --timeout"

if [[ -z $RUN_ID ]]; then
  RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$ADAPTER-$(sanitize_id "$MODEL")"
else
  RUN_ID=$(sanitize_id "$RUN_ID")
fi
[[ -n $RUN_ID && $RUN_ID != .* && $RUN_ID != *..* ]] || die "invalid --run-id"
if [[ -n $SUITE_ID ]]; then
  SUITE_ID=$(sanitize_id "$SUITE_ID")
  [[ -n $SUITE_ID && $SUITE_ID != .* && $SUITE_ID != *..* ]] || die "invalid --suite-id"
fi
RESULTS_BRANCH=benchmark-results
EXECUTION_BRANCH="benchmark-run/$RUN_ID"
PUBLISH_BRANCH="benchmark-publish/$RUN_ID"
VERCEL_PROJECT=$(vercel_project_name "$RUN_ID")
RESULT_DIR="$REPO_ROOT/runs/$RUN_ID"
WORKSPACE="$RESULT_DIR/workspace"
RAW_LOG="$RESULT_DIR/agent.raw.log"
REDACTED_LOG="$RESULT_DIR/agent.log"
FINAL_OUTPUT="$RESULT_DIR/final.md"
METADATA="$RESULT_DIR/metadata.json"
USAGE_OUTPUT="$RESULT_DIR/usage.json"
STRIPE_CONFIG_DIR="$REPO_ROOT/.benchmark-secrets/stripe"
STRIPE_CONFIG="$STRIPE_CONFIG_DIR/$RUN_ID.toml"
CAPTURE_DIR="$REPO_ROOT/.benchmark-secrets/transcripts/$RUN_ID"
GLOBAL_STRIPE_CONFIG=${BENCHMARK_GLOBAL_STRIPE_CONFIG:-"${HOME:?}/.config/stripe/config.toml"}
[[ $GLOBAL_STRIPE_CONFIG == /* ]] || die "global Stripe config path must be absolute"

[[ ! -e $RESULT_DIR ]] || die "run directory already exists: runs/$RUN_ID"
[[ ! -e $STRIPE_CONFIG ]] || die "Stripe config already exists for this run: .benchmark-secrets/stripe/$RUN_ID.toml"
[[ ! -e $CAPTURE_DIR ]] || die "private transcript already exists for this run"
git show-ref --verify --quiet "refs/heads/$EXECUTION_BRANCH" && die "temporary branch already exists: $EXECUTION_BRANCH"
git show-ref --verify --quiet "refs/heads/$PUBLISH_BRANCH" && die "temporary branch already exists: $PUBLISH_BRANCH"
git fetch -q origin "$RESULTS_BRANCH" >/dev/null 2>&1 || true
if git show-ref --verify --quiet "refs/remotes/origin/$RESULTS_BRANCH"; then
  RESULTS_BASE="origin/$RESULTS_BRANCH"
  git cat-file -e "$RESULTS_BASE:runs/$RUN_ID" 2>/dev/null && die "run already exists on $RESULTS_BRANCH: runs/$RUN_ID"
else
  RESULTS_BASE=$BASE_COMMIT
fi

restore_base_branch() {
  if [[ ${SWITCHED_BRANCH-0} == 1 ]]; then
    git switch "$BASE_BRANCH" >/dev/null 2>&1 || note "warning: could not restore $BASE_BRANCH"
  fi
}

print_agent_summary() {
  printf '\nagent_summary=%s\n' "$FINAL_OUTPUT"
  cat "$FINAL_OUTPUT"
}

cleanup_local_run() {
  rm -rf -- "$RESULT_DIR"
}

assert_only_run_output_changed() {
  local change unexpected=
  while IFS= read -r change; do
    [[ -z $change || $change == "?? runs/$RUN_ID/"* ]] && continue
    unexpected+="$change"$'\n'
  done < <(git status --porcelain --untracked-files=all)
  if [[ -n $unexpected ]]; then
    note "agent modified files outside runs/$RUN_ID/: ${unexpected%$'\n'}"
    return 1
  fi
}

config_has_test_key() {
  [[ -f $1 ]] && grep -qE '^[[:space:]]*test_mode_api_key[[:space:]]*=' "$1"
}

capture_agent_global_stripe_config() {
  [[ ${GLOBAL_STRIPE_GUARD_ACTIVE-0} == 1 && -f $GLOBAL_STRIPE_CONFIG ]] || return 0
  local captured="$STRIPE_CONFIG_DIR/$RUN_ID.global.toml"
  local wrapper_config="$STRIPE_CONFIG_DIR/$RUN_ID.wrapper.toml"

  # A direct invocation of the real CLI may have written to the default global
  # path. Prefer that file when it contains credentials and the wrapped config
  # does not; otherwise preserve it separately for diagnosis and recovery.
  if [[ ! -s $STRIPE_CONFIG ]] || { config_has_test_key "$GLOBAL_STRIPE_CONFIG" && ! config_has_test_key "$STRIPE_CONFIG"; }; then
    [[ ! -e $wrapper_config ]] || { note "warning: cannot capture wrapper Stripe config: $wrapper_config exists"; return 1; }
    mv -- "$STRIPE_CONFIG" "$wrapper_config"
    mv -- "$GLOBAL_STRIPE_CONFIG" "$STRIPE_CONFIG"
    note "captured Stripe config written outside the wrapper as .benchmark-secrets/stripe/$RUN_ID.toml"
  else
    [[ ! -e $captured ]] || { note "warning: cannot capture global Stripe config: $captured exists"; return 1; }
    mv -- "$GLOBAL_STRIPE_CONFIG" "$captured"
    note "captured additional Stripe config as .benchmark-secrets/stripe/$RUN_ID.global.toml"
  fi
}

restore_global_stripe_config() {
  [[ ${GLOBAL_STRIPE_GUARD_ACTIVE-0} == 1 ]] || return 0
  capture_agent_global_stripe_config || note "warning: could not capture Stripe config created outside the wrapper"
  if [[ ${GLOBAL_STRIPE_ORIGINAL_PRESENT-0} == 1 ]]; then
    if [[ -e $GLOBAL_STRIPE_CONFIG ]]; then
      note "warning: refusing to overwrite Stripe config while restoring; backup remains at $GLOBAL_STRIPE_BACKUP"
      return 1
    fi
    mkdir -p "$(dirname "$GLOBAL_STRIPE_CONFIG")"
    mv -- "$GLOBAL_STRIPE_BACKUP" "$GLOBAL_STRIPE_CONFIG" || {
      note "warning: could not restore global Stripe config; backup remains at $GLOBAL_STRIPE_BACKUP"
      return 1
    }
  fi
  GLOBAL_STRIPE_GUARD_ACTIVE=0
}

cleanup_runtime() {
  local status=$?
  trap - EXIT
  restore_global_stripe_config || true
  [[ -z ${AGENT_WORKSPACE-} ]] || rm -rf -- "$AGENT_WORKSPACE"
  [[ -z ${STRIPE_SHIM_DIR-} ]] || rm -rf -- "$STRIPE_SHIM_DIR"
  if [[ -n ${GLOBAL_STRIPE_BACKUP_DIR-} && -d $GLOBAL_STRIPE_BACKUP_DIR && ! -e ${GLOBAL_STRIPE_BACKUP-} ]]; then
    rm -rf -- "$GLOBAL_STRIPE_BACKUP_DIR"
  fi
  if [[ ${GLOBAL_STRIPE_LOCK_HELD-0} == 1 ]]; then
    rmdir -- "$GLOBAL_STRIPE_LOCK_DIR" 2>/dev/null || note "warning: could not release Stripe config lock: $GLOBAL_STRIPE_LOCK_DIR"
  fi
  exit "$status"
}

SWITCHED_BRANCH=0
git switch --create "$EXECUTION_BRANCH" "$BASE_COMMIT" >/dev/null || die "could not create $EXECUTION_BRANCH"
SWITCHED_BRANCH=1
mkdir -p "$WORKSPACE"
AGENT_WORKSPACE=
STRIPE_SHIM_DIR=
GLOBAL_STRIPE_BACKUP_DIR=
GLOBAL_STRIPE_BACKUP=
GLOBAL_STRIPE_LOCK_DIR="${TMPDIR:-/tmp}/endless-tshirt-benchmark-stripe.lock"
GLOBAL_STRIPE_LOCK_HELD=0
GLOBAL_STRIPE_GUARD_ACTIVE=0
GLOBAL_STRIPE_ORIGINAL_PRESENT=0
trap cleanup_runtime EXIT
AGENT_WORKSPACE=$(mktemp -d "${TMPDIR:-/tmp}/benchmark-workspace.XXXXXX") || die "could not create isolated agent workspace"
STRIPE_SHIM_DIR=$(mktemp -d "${TMPDIR:-/tmp}/benchmark-stripe-shim.XXXXXX") || die "could not create Stripe CLI shim"
GLOBAL_STRIPE_BACKUP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/benchmark-stripe-global.XXXXXX") || die "could not create Stripe config backup directory"
chmod 700 "$GLOBAL_STRIPE_BACKUP_DIR"
GLOBAL_STRIPE_BACKUP="$GLOBAL_STRIPE_BACKUP_DIR/config.toml"
mkdir -p "$STRIPE_CONFIG_DIR"
chmod 700 "$REPO_ROOT/.benchmark-secrets" "$STRIPE_CONFIG_DIR"
umask 077
: >"$STRIPE_CONFIG"
chmod 600 "$STRIPE_CONFIG"
cat >"$STRIPE_SHIM_DIR/stripe" <<EOF
#!/usr/bin/env bash
exec "${STRIPE_REAL}" --config "\${BENCHMARK_STRIPE_CONFIG}" "\$@"
EOF
chmod 700 "$STRIPE_SHIM_DIR/stripe"
cat >"$STRIPE_SHIM_DIR/bash-env" <<EOF
export PATH="${STRIPE_SHIM_DIR}:\$PATH"
EOF
chmod 600 "$STRIPE_SHIM_DIR/bash-env"

if ! mkdir -- "$GLOBAL_STRIPE_LOCK_DIR" 2>/dev/null; then
  die "another benchmark may be using the global Stripe config (lock: $GLOBAL_STRIPE_LOCK_DIR)"
fi
GLOBAL_STRIPE_LOCK_HELD=1
GLOBAL_STRIPE_GUARD_ACTIVE=1
if [[ -e $GLOBAL_STRIPE_CONFIG ]]; then
  [[ -f $GLOBAL_STRIPE_CONFIG && ! -L $GLOBAL_STRIPE_CONFIG ]] || die "global Stripe config is not a regular file: $GLOBAL_STRIPE_CONFIG"
  mv -- "$GLOBAL_STRIPE_CONFIG" "$GLOBAL_STRIPE_BACKUP" || die "could not quarantine global Stripe config"
  GLOBAL_STRIPE_ORIGINAL_PRESENT=1
fi

export BASH_ENV="$STRIPE_SHIM_DIR/bash-env"
LOGIN_SHELL_STRIPE=$(PATH="$STRIPE_SHIM_DIR:$PATH" /bin/bash -lc 'command -v stripe')
[[ $LOGIN_SHELL_STRIPE == "$STRIPE_SHIM_DIR/stripe" ]] || die "Stripe wrapper did not survive a login shell (resolved: $LOGIN_SHELL_STRIPE)"

# Credentials must come from the isolated CLI profile, never from the runner's
# ambient environment.
unset STRIPE_SECRET_KEY STRIPE_API_KEY STRIPE_PUBLISHABLE_KEY STRIPE_WEBHOOK_SECRET

STARTED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
START_EPOCH=$(date +%s)
export BENCHMARK_RUN_ID="$RUN_ID"
export BENCHMARK_WORKSPACE="$AGENT_WORKSPACE"
export BENCHMARK_PROMPT_FILE="$PROMPT_FILE"
export BENCHMARK_MODEL="$MODEL"
export BENCHMARK_FINAL_OUTPUT="$FINAL_OUTPUT"
export BENCHMARK_VERCEL_PROJECT="$VERCEL_PROJECT"
export BENCHMARK_REASONING_EFFORT="$REASONING_EFFORT"
export BENCHMARK_USAGE_OUTPUT="$USAGE_OUTPUT"
export BENCHMARK_STRIPE_CONFIG="$STRIPE_CONFIG"
export BENCHMARK_STRIPE_CONFIG_REF=".benchmark-secrets/stripe/$RUN_ID.toml"
export BENCHMARK_CAPTURE_DIR="$CAPTURE_DIR"

set +e
PATH="$STRIPE_SHIM_DIR:$PATH" "$TIMEOUT_COMMAND" "$TIMEOUT_SECONDS" "$ADAPTER_PATH" "${EXTRA_ARGS[@]}" >"$RAW_LOG" 2>&1
AGENT_EXIT=$?
set -e
restore_global_stripe_config
node "$SCRIPT_DIR/run-inspector/finalize-capture.mjs" "$ADAPTER" "$CAPTURE_DIR" "$RESULT_DIR" || die "could not finalize transcript capture"

tar -C "$AGENT_WORKSPACE" --exclude=.git --exclude=node_modules --exclude=.next --exclude=reference -cf - . | tar -C "$WORKSPACE" -xf -
if ! assert_only_run_output_changed; then
  restore_base_branch
  exit 1
fi

FINISHED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
DURATION_SECONDS=$(( $(date +%s) - START_EPOCH ))
RUN_STATUS=succeeded
if (( AGENT_EXIT == 124 )); then
  RUN_STATUS=timed_out
elif (( AGENT_EXIT != 0 )); then
  RUN_STATUS=failed
fi
if [[ ! -s $FINAL_OUTPUT ]]; then
  printf 'No final completion message was produced. See capture.json and events.jsonl for capture coverage and tool evidence.\n' >"$FINAL_OUTPUT"
  [[ $RUN_STATUS == succeeded ]] && RUN_STATUS=failed
fi

DEPLOYMENT_URL=$(extract_url "$FINAL_OUTPUT")
USAGE_JSON=null
if [[ -s $USAGE_OUTPUT ]] && python3 - "$USAGE_OUTPUT" >/dev/null <<'PY'
import json
import sys
value = json.load(open(sys.argv[1], encoding='utf-8'))
assert value is None or isinstance(value, dict)
PY
then
  USAGE_JSON=$(cat "$USAGE_OUTPUT")
fi
PROMPT_SHA=$(shasum -a 256 "$BENCHMARK_PROMPT_FILE" | awk '{print $1}')
git add "$WORKSPACE"
WORKSPACE_TREE=$(git write-tree)
{
  printf '{\n'
  printf '  "run_id": '; json_string "$RUN_ID"; printf ',\n'
  printf '  "suite_id": '; json_string "$SUITE_ID"; printf ',\n'
  printf '  "status": '; json_string "$RUN_STATUS"; printf ',\n'
  printf '  "adapter": '; json_string "$ADAPTER"; printf ',\n'
  printf '  "capture_version": 1,\n'
  printf '  "model": '; json_string "$MODEL"; printf ',\n'
  printf '  "reasoning_effort": '; json_string "$REASONING_EFFORT"; printf ',\n'
  printf '  "branch": '; json_string "$RESULTS_BRANCH"; printf ',\n'
  printf '  "vercel_project": '; json_string "$VERCEL_PROJECT"; printf ',\n'
  printf '  "stripe_config_ref": '; json_string "$RUN_ID"; printf ',\n'
  printf '  "stripe_config_path": '; json_string ".benchmark-secrets/stripe/$RUN_ID.toml"; printf ',\n'
  printf '  "base_commit": '; json_string "$BASE_COMMIT"; printf ',\n'
  printf '  "prompt_file": '; json_string "$PROMPT_REF"; printf ',\n'
  printf '  "prompt_sha256": '; json_string "$PROMPT_SHA"; printf ',\n'
  printf '  "workspace_tree": '; json_string "$WORKSPACE_TREE"; printf ',\n'
  printf '  "started_at": '; json_string "$STARTED_AT"; printf ',\n'
  printf '  "finished_at": '; json_string "$FINISHED_AT"; printf ',\n'
  printf '  "duration_seconds": %s,\n' "$DURATION_SECONDS"
  printf '  "agent_exit_code": %s,\n' "$AGENT_EXIT"
  printf '  "usage": %s,\n' "$USAGE_JSON"
  printf '  "deployment_url": '; json_string "$DEPLOYMENT_URL"; printf '\n}\n'
} >"$METADATA"

git add "runs/$RUN_ID"
git reset -q -- "$RAW_LOG"
git diff --cached --check -- . ":(exclude)runs/$RUN_ID/agent.log" || { restore_base_branch; exit 1; }
assert_no_staged_secrets
COMMIT_MESSAGE="benchmark: $RUN_ID [$ADAPTER/$MODEL] $RUN_STATUS"
if ! git commit -m "$COMMIT_MESSAGE" >/dev/null; then
  note "commit failed; generated files remain staged on $EXECUTION_BRANCH"
  exit 1
fi
EXECUTION_COMMIT=$(git rev-parse HEAD)

git switch --detach "$RESULTS_BASE" >/dev/null || die "could not prepare $RESULTS_BRANCH"
git switch --create "$PUBLISH_BRANCH" >/dev/null || die "could not create $PUBLISH_BRANCH"
git checkout "$EXECUTION_COMMIT" -- "runs/$RUN_ID"
git add "runs/$RUN_ID"
git diff --cached --check -- . ":(exclude)runs/$RUN_ID/agent.log" || { restore_base_branch; exit 1; }
assert_no_staged_secrets
if ! git commit -m "$COMMIT_MESSAGE" >/dev/null; then
  note "results commit failed; generated files remain staged on $PUBLISH_BRANCH"
  restore_base_branch
  exit 1
fi
RESULT_COMMIT=$(git rev-parse HEAD)

if ! git push origin "HEAD:refs/heads/$RESULTS_BRANCH" >/dev/null; then
  note "$RESULTS_BRANCH changed while this run was executing; rebasing the result once and retrying"
  if git fetch -q origin "$RESULTS_BRANCH" && git rebase "origin/$RESULTS_BRANCH" >/dev/null && git push origin "HEAD:refs/heads/$RESULTS_BRANCH" >/dev/null; then
    RESULT_COMMIT=$(git rev-parse HEAD)
  else
    note "push failed; local results commit $RESULT_COMMIT remains on $PUBLISH_BRANCH"
    note "recover with: git switch $PUBLISH_BRANCH && git push origin HEAD:refs/heads/$RESULTS_BRANCH"
    restore_base_branch
    exit 1
  fi
fi
print_agent_summary
restore_base_branch
git branch -D "$EXECUTION_BRANCH" "$PUBLISH_BRANCH" >/dev/null
cleanup_local_run
printf 'run=%s status=%s branch=%s commit=%s\n' "$RUN_ID" "$RUN_STATUS" "$RESULTS_BRANCH" "$RESULT_COMMIT"
[[ -n $DEPLOYMENT_URL ]] && printf 'deployment_url=%s\n' "$DEPLOYMENT_URL"
if [[ $RUN_STATUS != succeeded ]]; then
  (( AGENT_EXIT != 0 )) && exit "$AGENT_EXIT"
  exit 1
fi
