#!/usr/bin/env bash
set -euo pipefail

: "${BENCHMARK_WORKSPACE:?}"
: "${BENCHMARK_PROMPT_FILE:?}"
: "${BENCHMARK_MODEL:?}"
: "${BENCHMARK_FINAL_OUTPUT:?}"
: "${BENCHMARK_USAGE_OUTPUT:?}"

TMP_OUTPUT=$(mktemp "${TMPDIR:-/tmp}/benchmark-claude.XXXXXX")
trap 'rm -f "$TMP_OUTPUT"' EXIT
cd "$BENCHMARK_WORKSPACE"

ARGS=()
if [[ -n ${BENCHMARK_REASONING_EFFORT-} ]]; then
  ARGS+=(--effort "$BENCHMARK_REASONING_EFFORT")
fi

set +e
claude --print \
  --dangerously-skip-permissions \
  --no-session-persistence \
  --output-format json \
  --model "$BENCHMARK_MODEL" \
  "${ARGS[@]}" \
  "$@" \
  "$(<"$BENCHMARK_PROMPT_FILE")" >"$TMP_OUTPUT"
CLAUDE_EXIT=$?
set -e
cat "$TMP_OUTPUT"

python3 - "$TMP_OUTPUT" "$BENCHMARK_FINAL_OUTPUT" "$BENCHMARK_USAGE_OUTPUT" <<'PY'
import json
import sys

source, destination, usage_destination = sys.argv[1:]
text = open(source, encoding="utf-8").read()
try:
    payload = json.loads(text)
    result = payload.get("result")
    if not isinstance(result, str):
        raise ValueError("Claude JSON result was not a string")
except Exception:
    result = text
    payload = {}
with open(destination, "w", encoding="utf-8") as output:
    output.write(result)
    if result and not result.endswith("\n"):
        output.write("\n")
usage = payload.get("usage") if isinstance(payload, dict) else None
if not isinstance(usage, dict):
    usage = None
else:
    usage = {key: value for key, value in usage.items() if isinstance(value, int)}
with open(usage_destination, "w", encoding="utf-8") as output:
    json.dump(usage, output, sort_keys=True)
    output.write("\n")
PY

exit "$CLAUDE_EXIT"
