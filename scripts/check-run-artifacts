#!/usr/bin/env bash
# Shared publication gate for fresh runs and unchanged recovered artifacts.
set -euo pipefail
RUN_ID=${1:?run ID required}
[[ $RUN_ID =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ && $RUN_ID != *..* ]] || exit 2
die() { printf 'error: %s\n' "$*" >&2; exit 2; }
# Evidence files (final.md, agent.log, events.jsonl, metadata.json) must contain
# nothing credential-shaped at all. Generated application source under
# workspace/ is different: placeholder keys in tests and .env examples are
# normal, so there the structural net requires credential-length values while
# the by-value checks below stay exact.
EVIDENCE=("runs/$RUN_ID" ":(exclude)runs/$RUN_ID/workspace")
WORKSPACE=("runs/$RUN_ID/workspace")
ALL=("runs/$RUN_ID")
scan() {
  local -n paths=$1; shift
  local status=0
  git grep --cached -q "$@" -- "${paths[@]}" || status=$?
  case $status in
    0) die 'a provider secret is staged; refusing to commit' ;;
    1) return 0 ;;
    *) die 'secret scan failed; refusing to commit' ;;
  esac
}
# Secret checking is mandatory and fails closed. Never print matching lines.
for variable in PRODIGI_API_KEY STRIPE_SECRET_KEY STRIPE_PUBLISHABLE_KEY STRIPE_WEBHOOK_SECRET VERCEL_TOKEN; do
  value=${!variable-}
  [[ -z $value ]] || scan ALL -F -e "$value"
done
# Credentials this run actually provisioned, matched by value anywhere.
for config in ".benchmark-secrets/stripe/$RUN_ID.toml" \
              ".benchmark-secrets/stripe/$RUN_ID.global.toml" \
              ".benchmark-secrets/stripe/$RUN_ID.wrapper.toml"; do
  [[ -s $config ]] || continue
  while IFS= read -r secret; do
    [[ ${#secret} -ge 8 ]] || continue
    scan ALL -F -e "$secret"
  done < <(sed -nE "s/^[[:space:]]*[a-z_]*(api_key|pub_key|secret)[[:space:]]*=[[:space:]]*'([^']+)'.*/\2/p" "$config")
done
PREFIXED='(sk|pk|rkcs|rk)_(test|live)_[A-Za-z0-9_=-]%s|whsec_[A-Za-z0-9_=-]%s'
SPECIFIC='(test|live)_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|(pi|cs)_[A-Za-z0-9_]+_secret_[A-Za-z0-9_]+'
# shellcheck disable=SC2059
scan EVIDENCE -E -e "(^|[^[:alnum:]_])($(printf "$PREFIXED" '+' '+')|$SPECIFIC)"
# Real Stripe keys carry 97+ characters after the prefix; the 24-character floor
# admits nothing credential-length while letting sk_test_not_real through.
scan WORKSPACE -E -e "(^|[^[:alnum:]_])($(printf "$PREFIXED" '{24,}' '{24,}')|$SPECIFIC)"
# Archive agent output byte-for-byte, including vendor licenses with CRLF or
# trailing spaces. Formatting is evidence, not a reason to lose a paid run.
status=0
git diff --cached --check -- "runs/$RUN_ID" >/dev/null 2>&1 || status=$?
case $status in
  0) ;;
  2) printf 'warning: archived run has whitespace errors; preserving original bytes\n' >&2 ;;
  *) die 'artifact diff check failed' ;;
esac
